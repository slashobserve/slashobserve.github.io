---
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "../styles/tokens.css"
import "../styles/marketing.css"
import "../styles/motion.css"
import SiteFooter from "../components/site/SiteFooter.astro"
import SiteHeader from "../components/site/SiteHeader.astro"
import ThemeScript from "../components/site/ThemeScript.astro"
import { getDocLinks } from "../lib/get-doc-links"
import { CARD_HEIGHT, CARD_WIDTH, cardFor, cardImagePath } from "../lib/og/cards"

interface Props {
  title: string
  description: string
  canonical?: boolean
}

const { title, description, canonical = true } = Astro.props
const links = await getDocLinks()
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const card = cardFor(Astro.url.pathname)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SlashObserve" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    {card && (
      <>
        <meta property="og:image" content={new URL(cardImagePath(card), Astro.site)} />
        <meta property="og:image:width" content={String(CARD_WIDTH)} />
        <meta property="og:image:height" content={String(CARD_HEIGHT)} />
        <meta property="og:image:alt" content={`${card.section}: ${card.title}`} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {canonical && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site dots">
      <SiteHeader links={links} />
      <main id="main">
        <slot />
      </main>
      <SiteFooter links={links} />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 40;
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--primary);
    color: var(--pfg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
