---
import DocsSearch from "../components/site/DocsSearch.astro"
import PageOpening from "../components/site/PageOpening.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="Page not found | SlashObserve"
  description="This page does not exist."
  canonical={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="not-found">
    <PageOpening title="No data for this page">
      <p class="lead">
        The address may be old, or the page moved when the docs were reorganised. Search the docs, or start from one
        of these.
      </p>
      <DocsSearch placeholder="Search docs" fromPath />
      <div class="row actions">
        <a class="btn btn-primary" href="/">Home</a>
        {links.quickStart && <a class="btn" href={links.quickStart}>Quick start</a>}
        {links.reference && <a class="btn" href={links.reference}>Reference</a>}
      </div>
    </PageOpening>
  </div>
</MarketingLayout>

<style>
  .not-found {
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 64px;
    box-sizing: border-box;
  }

  .not-found :global(.opening) {
    width: 100%;
  }

  .actions {
    flex-wrap: wrap;
  }
</style>
