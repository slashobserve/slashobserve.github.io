---
import DocsSearch from "../components/not-found/DocsSearch.astro"
import PageHero from "../components/site/PageHero.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="Page not found | SlashObserve"
  description="This page does not exist."
  minimalHeader
  halo
  canonical={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="not-found">
    <PageHero eyebrow="404 · no data" title="No data for this page">
      <p class="lead">
        The address may be old, or the page moved when the docs were reorganised. Search the docs, or
        start from one of these.
      </p>
      <DocsSearch />
      <div class="actions">
        <a class="btn btn-primary" href="/">Home</a>
        {links.quickStart && <a class="btn" href={links.quickStart}>Quick start</a>}
        {links.reference && <a class="btn" href={links.reference}>Reference</a>}
      </div>
    </PageHero>
  </div>
</MarketingLayout>

<style>
  .not-found {
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 64px;
    box-sizing: border-box;
  }

  .not-found :global(.page-hero) {
    width: 100%;
  }
</style>
