---
import "../components/product/build-stage.css"
import BuildStage from "../components/product/BuildStage"
import CanvasMode from "../components/product/CanvasMode.astro"
import DashboardActivity from "../components/product/DashboardActivity.astro"
import MetricInventory from "../components/product/MetricInventory.astro"
import VersionHistory from "../components/product/VersionHistory.astro"
import PageOpening from "../components/site/PageOpening.astro"
import RunsOnBand from "../components/site/RunsOnBand.astro"
import Section from "../components/site/Section.astro"
import SectionHead from "../components/site/SectionHead.astro"
import Split from "../components/site/Split.astro"
import SurfacesSection from "../components/site/SurfacesSection.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="Dashboards | SlashObserve"
  description="Ask for a dashboard in a sentence: the agent inventories the metric families in scope, runs every panel it adds before the save, and ends with a version and a link."
>
  <PageOpening eyebrow="Dashboards" title="Ask for a dashboard. Get one that works.">
    <p class="lead">
      The agent takes an inventory of the metric families in scope before it plans, saves one panel at a time, and ends
      with a version and a link. Every family in scope, apart from runtime metrics, ends in a panel or a stated reason,
      and every panel the agent adds or changes is run before the save.
    </p>
  </PageOpening>
  <section class="wrap playback">
    <div data-in-view="rise"><BuildStage client:visible /></div>
    <p class="hint playback-caption">A build, played back.</p>
  </section>
  <Section sunk>
    <Split>
      <div slot="start" class="split-copy">
        <p class="eyebrow">Inventory</p>
        <h2 class="h2">Every family in scope is accounted for.</h2>
        <p class="lead">
          Before it plans, the agent takes an inventory of every metric family in scope: a job, a service, a namespace,
          or a table. Every family in scope, apart from runtime metrics, ends in a panel or a stated reason, and the
          save result lists anything uncovered. Runtime metrics are counted, not listed.
        </p>
        <div class="row inventory-chips">
          <span class="chip">12 families</span>
          <span class="chip">12 panels</span>
          <span class="chip"><span class="dot tone-ok"></span>0 uncovered</span>
        </div>
      </div>
      <div slot="end" data-in-view="rise"><MetricInventory /></div>
    </Split>
  </Section>
  <Section>
    <Split rev>
      <div slot="start" data-in-view="rise"><VersionHistory /></div>
      <div slot="end" class="split-copy">
        <p class="eyebrow">Versions</p>
        <h2 class="h2">Every change is a version.</h2>
        <p class="lead">
          A build becomes one version. An edit in the panel editor, an agent repair and each Revise the dashboard is
          another, with a diff and a restore. A question in the chat or in a comment gets an answer and leaves the
          dashboard as it was.
        </p>
      </div>
    </Split>
  </Section>
  <Section sunk>
    <SectionHead
      eyebrow="Canvas"
      title="Comment or ask on any spot."
      lead="Choose Comment or Ask in the canvas toolbar, then click a point, a table row or a value on a panel, or drag across a range. Chips name the spot. A comment starts a thread everyone here can see and leaves a pin. An ask goes to the agent, and the answer comes back in the box, seen only by you and Admins until you share it."
    />
    <div class="cols2 modes">
      <div data-in-view="rise"><CanvasMode mode="comment" /></div>
      <div data-in-view="rise"><CanvasMode mode="ask" /></div>
    </div>
    {
      links.askAndComment && (
        <p class="modes-more">
          <a class="arrow" href={links.askAndComment}>
            How Comment and Ask work →
          </a>
        </p>
      )
    }
  </Section>
  <Section>
    <Split>
      <div slot="start" class="split-copy">
        <p class="eyebrow">Activity</p>
        <h2 class="h2">Comments, requests and versions in one timeline.</h2>
        <p class="lead">
          The Activity tab beside a dashboard puts its comments, the requests people sent to the agent, proposals,
          annotations and saved versions in one list, sorted by time. Show narrows it to open comments or to changes
          only, and Panel narrows it to one panel. Mention the agent in a comment and it answers in the thread; when a
          change fits, the answer offers it with Revise the dashboard.
        </p>
      </div>
      <div slot="end" data-in-view="rise"><DashboardActivity /></div>
    </Split>
  </Section>
  <SurfacesSection
    lead="The tools behind the built-in agent are served over MCP too. Claude Code and other MCP clients build, read and repair dashboards with the same metric inventory. Same save checks everywhere."
  />
  <RunsOnBand quickStart={links.quickStart} />
</MarketingLayout>

<script>
  import { watchInView } from "../lib/client/in-view"

  watchInView()
</script>

<style>
  .inventory-chips {
    gap: 8px;
    flex-wrap: wrap;
  }

  .playback {
    padding-bottom: 96px;
  }

  .modes {
    align-items: start;
  }

  .modes-more {
    margin: 24px 0 0;
  }

  .playback-caption {
    margin: 18px 0 0;
  }

  @media (max-width: 900px) {
    .playback {
      padding-bottom: 64px;
    }
  }
</style>
