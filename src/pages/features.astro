---
import FeatureGroup from "../components/features/FeatureGroup.astro"
import PageHero from "../components/site/PageHero.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { featureGroups } from "../lib/features"
import { getDocLinks } from "../lib/get-doc-links"
import { dataPanelTypeCount, readSyncedSchema } from "../lib/schema-facts"

const links = await getDocLinks()
const groups = featureGroups(links, dataPanelTypeCount(readSyncedSchema()))
---

<MarketingLayout
  title="Features | SlashObserve"
  description="Everything SlashObserve does today: dashboards from a sentence, review and versions, roles, Grafana import, Prometheus and ClickHouse, MCP, CLI and self-hosting."
  halo
>
  <PageHero eyebrow="Features" title="Everything you need to run dashboards with an agent.">
    <p class="lead">
      Everything SlashObserve does today, with a link to the docs where a page covers it.
    </p>
  </PageHero>
  <div class="wrap section-y groups">
    {groups.map((group, index) => <FeatureGroup group={group} id={`group-${index}`} />)}
  </div>
</MarketingLayout>

<style>
  .groups {
    padding-top: 0;
  }
</style>
