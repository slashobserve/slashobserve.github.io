---
import LogsPage from "../components/product/LogsPage.astro"
import PanelEditorPreview from "../components/product/PanelEditorPreview.astro"
import TraceView from "../components/product/TraceView.astro"
import StoresTable from "../components/signals/StoresTable.astro"
import PageOpening from "../components/site/PageOpening.astro"
import Section from "../components/site/Section.astro"
import Split from "../components/site/Split.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
---

<MarketingLayout
  title="Signals | SlashObserve"
  description="Metrics, logs and traces from Prometheus, ClickHouse, Loki and Tempo in one place. Dashboards mix them and a log line opens its trace."
>
  <PageOpening title="Three signals, four stores, one place to look.">
    <p class="lead lead-20">
      Prometheus or ClickHouse for metrics. Loki or ClickHouse for logs. Tempo or ClickHouse for traces. Dashboards
      mix them, the agent queries all of them, and a log line with a trace id opens the trace.
    </p>
    <div class="row chips">
      <span class="chip">Prometheus</span>
      <span class="chip">ClickHouse</span>
      <span class="chip">Loki</span>
      <span class="chip">Tempo</span>
    </div>
  </PageOpening>
  <section class="wrap logs-wrap"><LogsPage /></section>
  <Section>
    <Split start={1.25} end={0.75} gap={48}>
      <TraceView slot="start" />
      <div slot="end" class="copy">
        <h2 class="h2">The trace view.</h2>
        <p class="lead lead-17">
          A waterfall per trace, the slow span selected, its attributes beside it. Tempo or the OpenTelemetry tables
          in ClickHouse, with TraceQL or SQL behind it.
        </p>
      </div>
    </Split>
  </Section>
  <Section>
    <Split start={0.75} end={1.25} gap={48}>
      <div slot="start" class="copy">
        <h2 class="h2">Try a query before you save it.</h2>
        <p class="lead lead-17">
          The logs page takes LogQL on Loki or SQL on ClickHouse. "Show context" brings up the lines around a line, a
          line with a trace id opens its trace, and "Add to dashboard" saves the query as a logs panel. Trace search
          finds traces by service, span, duration or TraceQL. In the panel editor, the preview runs PromQL or SQL on
          the real datasource before you save.
        </p>
      </div>
      <PanelEditorPreview slot="end" />
    </Split>
  </Section>
  <StoresTable />
</MarketingLayout>

<style>
  .chips {
    gap: 8px;
    flex-wrap: wrap;
  }

  .logs-wrap {
    padding-bottom: 96px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (max-width: 900px) {
    .logs-wrap {
      padding-bottom: 64px;
    }
  }
</style>
