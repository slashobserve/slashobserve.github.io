---
import LogsPage from "../components/product/LogsPage.astro"
import PanelEditorPreview from "../components/product/PanelEditorPreview.astro"
import TraceView from "../components/product/TraceView.astro"
import StoreStrip from "../components/signals/StoreStrip.astro"
import StoresTable from "../components/signals/StoresTable.astro"
import PageOpening from "../components/site/PageOpening.astro"
import Section from "../components/site/Section.astro"
import Split from "../components/site/Split.astro"
import Stage from "../components/site/Stage.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
---

<MarketingLayout
  title="Signals | SlashObserve"
  description="Metrics, logs and traces from Prometheus, ClickHouse, Loki, Elasticsearch, OpenSearch and Tempo in one place: PromQL, SQL, LogQL, KQL (with Lucene and the Query DSL) and TraceQL. Dashboards mix them and a log line opens its trace."
>
  <PageOpening title="Three signals, six stores, one place to look.">
    <p class="lead">
      Prometheus or ClickHouse for metrics. Loki, ClickHouse, Elasticsearch or OpenSearch for logs. Tempo or ClickHouse for
      traces. Dashboards mix them, the agent queries all of them, and a log line with a trace id opens the trace.
    </p>
    <StoreStrip />
  </PageOpening>
  <section class="wrap logs-wrap">
    <div data-in-view="rise"><Stage><LogsPage /></Stage></div>
  </section>
  <Section>
    <Split rev>
      <div slot="start" data-in-view="rise"><Stage><TraceView /></Stage></div>
      <div slot="end" class="copy">
        <h2 class="h2">The trace view.</h2>
        <p class="lead">
          A waterfall per trace, the slow span selected, its attributes beside it. Tempo or the OpenTelemetry tables
          in ClickHouse, with TraceQL or SQL behind it.
        </p>
      </div>
    </Split>
  </Section>
  <Section>
    <Split>
      <div slot="start" class="copy">
        <h2 class="h2">Try a query before you save it.</h2>
        <p class="lead">
          The logs page takes one store at a time in its own language: LogQL on Loki, SQL on ClickHouse, KQL on
          Elasticsearch or OpenSearch, with Lucene or the Query DSL when you want them. "Show context", or "Surrounding documents" on
          Elasticsearch and OpenSearch, brings up the lines around a line, a line with a trace id opens its trace, and "Add to dashboard" saves the query as a logs
          panel. Trace search finds traces by service, span, duration or TraceQL. With a model on the server, both pages
          also take a plain question: the logs page writes the query in the datasource's language, and the trace search
          fills its fields or writes TraceQL. In the panel editor, the preview runs PromQL or SQL on the real datasource
          before you save.
        </p>
      </div>
      <div slot="end" data-in-view="rise"><Stage><PanelEditorPreview /></Stage></div>
    </Split>
  </Section>
  <StoresTable />
</MarketingLayout>

<script>
  import { watchInView } from "../lib/client/in-view"

  watchInView()
</script>

<style>
  .logs-wrap {
    padding-bottom: 96px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (max-width: 900px) {
    .logs-wrap {
      padding-bottom: 64px;
    }
  }
</style>
