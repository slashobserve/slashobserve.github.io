---
import LogsPage from "../components/product/LogsPage.astro"
import PanelEditorPreview from "../components/product/PanelEditorPreview.astro"
import TraceView from "../components/product/TraceView.astro"
import StoreStrip from "../components/signals/StoreStrip.astro"
import StoresTable from "../components/signals/StoresTable.astro"
import PageOpening from "../components/site/PageOpening.astro"
import Section from "../components/site/Section.astro"
import SectionHead from "../components/site/SectionHead.astro"
import Split from "../components/site/Split.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
---

<MarketingLayout
  title="Signals | SlashObserve"
  description="Metrics, logs and traces from Prometheus, ClickHouse, Loki, Elasticsearch, OpenSearch and Tempo in one place: PromQL, SQL, LogQL, KQL (with Lucene and the Query DSL) and TraceQL. Dashboards mix them and a log line opens its trace."
>
  <PageOpening eyebrow="Signals" title="Three signals, six stores, one place to look.">
    <p class="lead">
      Prometheus or ClickHouse for metrics. Loki, ClickHouse, Elasticsearch or OpenSearch for logs. Tempo or ClickHouse for
      traces. Dashboards mix them, the agent queries all of them, and a log line with a trace id opens the trace.
    </p>
    <StoreStrip />
  </PageOpening>
  <section class="wrap logs-wrap">
    <div data-in-view="rise"><LogsPage /></div>
  </section>
  <Section>
    <SectionHead
      eyebrow="Traces"
      title="The trace view."
      lead="A waterfall per trace, with the critical path outlined, a search inside the trace and the span's attributes, events and links beside it. A span shows the logs that carry its trace id. Tempo or the OpenTelemetry tables in ClickHouse, with TraceQL or SQL behind it."
    />
    <div data-in-view="rise"><TraceView /></div>
  </Section>
  <Section sunk>
    <Split>
      <div slot="start" class="split-copy">
        <p class="eyebrow">Queries</p>
        <h2 class="h2">Try a query before you save it.</h2>
        <p class="lead">
          Each logs datasource has its own page, in its own language: LogQL on Loki, SQL on ClickHouse, KQL on
          Elasticsearch or OpenSearch, with Lucene or the Query DSL when you want them. "Show context", or "Surrounding
          documents" on Elasticsearch and OpenSearch, brings up the lines around a line, a line with a trace id opens its
          trace, and "Add to dashboard" saves the query as a logs panel. Live tail follows new lines as they arrive.
        </p>
        <p class="lead">
          Trace search finds traces by service, span, duration, errors or TraceQL, and on ClickHouse also by SQL. The
          metrics page runs PromQL on a Prometheus source and shows a time series or a table. The Logs and Traces lists
          show the services each source has seen in the last hour, and a service name opens that source filtered to it.
        </p>
        <p class="lead">
          With a model on the server, the logs page and the trace search also take a plain question: the logs page writes
          the query in the datasource's language, and the trace search fills its fields or writes TraceQL. Save a search
          and anyone who can view its folder opens it again; someone who can edit it updates its query, columns and range.
          In the panel editor, the preview runs the draft query on the real datasource before you save.
        </p>
      </div>
      <div slot="end" data-in-view="rise"><PanelEditorPreview /></div>
    </Split>
  </Section>
  <StoresTable />
</MarketingLayout>

<script>
  import { watchInView } from "../lib/client/in-view"

  watchInView()
</script>

<style>
  .logs-wrap {
    padding-bottom: 96px;
  }

  @media (max-width: 900px) {
    .logs-wrap {
      padding-bottom: 64px;
    }
  }
</style>
