---
import ImportCoverageTable from "../components/grafana/ImportCoverageTable.astro"
import ImportStats from "../components/grafana/ImportStats.astro"
import ImportSteps from "../components/grafana/ImportSteps.astro"
import ImportScript from "../components/product/ImportScript.astro"
import Band from "../components/site/Band.astro"
import PageOpening from "../components/site/PageOpening.astro"
import Section from "../components/site/Section.astro"
import Split from "../components/site/Split.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"
import { cleanImportPercent, readImportCorpus } from "../lib/import-corpus"
import { mappedPanelTypeCount, readImportCoverage } from "../lib/import-coverage"

const links = await getDocLinks()
const mapped = mappedPanelTypeCount(readImportCoverage())
const clean = cleanImportPercent(readImportCorpus())
const stats = [
  ...(mapped > 0 ? [{ value: String(mapped), label: "Grafana panel types with importable options, legacy ones included" }] : []),
  ...(clean !== null ? [{ value: `${clean}%`, label: "of the public test corpus converts with no placeholder and nothing left behind" }] : []),
]
---

<MarketingLayout
  title="Coming from Grafana | SlashObserve"
  description="Connect a Grafana with a read-only token and every dashboard comes across with its folders, variables and links. Every imported query runs and the old links keep resolving."
>
  <PageOpening title="Coming from Grafana? Bring your dashboards.">
    <p class="lead lead-20">
      Connect a Grafana with a read-only token. Every dashboard comes across with its folder, tags, variables and links,
      and unmatched panels are listed, not hidden. Every imported query runs. Panels whose queries fail or return
      nothing go to a repair queue the agent works through; placeholders are listed for you to redo by hand. The old
      links keep resolving, and nothing is written back.
    </p>
    {
      links.importGuide && (
        <div class="row actions">
          <a class="btn btn-primary" href={links.importGuide}>
            Read the import guide
          </a>
        </div>
      )
    }
  </PageOpening>
  <ImportStats stats={stats} />
  <ImportSteps />
  <ImportCoverageTable />
  <Section>
    <Split start={0.8} end={1.2} gap={48}>
      <div class="script-copy" slot="start">
        <h2 class="h2">The same import, scripted.</h2>
        <p class="lead lead-17">
          Everything the Settings page does is a verb, so a migration can run from CI or a runbook and be repeated.
        </p>
      </div>
      <ImportScript slot="end" />
    </Split>
  </Section>
  <Band>
    <h2 class="h2 band-title">Import your dashboards this afternoon.</h2>
    <p class="p">
      Point it at a Grafana you can read, or run the demo stack's own export through the importer. Nothing is written
      back.
    </p>
    {
      links.importGuide && (
        <div class="row actions">
          <a class="btn btn-band" href={links.importGuide}>
            Import guide
          </a>
        </div>
      )
    }
  </Band>
</MarketingLayout>

<style>
  .actions {
    gap: 10px;
    flex-wrap: wrap;
  }

  .script-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .band-title {
    max-width: 22ch;
  }
</style>
