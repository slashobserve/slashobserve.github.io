---
import { getCollection, render, type CollectionEntry } from "astro:content"
import DocsLayout from "../../layouts/DocsLayout.astro"
import { getOrderedDocs, editUrlFor } from "../../lib/get-docs"
import { buildSidebar, prevNext, sectionLabel } from "../../lib/docs-sidebar"

export async function getStaticPaths() {
  const entries = await getCollection("docs")
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<"docs">
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const href = `/docs/${entry.id}/`
const ordered = await getOrderedDocs()
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={buildSidebar(ordered, href)}
  section={sectionLabel(href)}
  headings={headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)}
  prevNext={prevNext(ordered, href)}
  markdownUrl={`${href}index.md`}
  editUrl={entry.data.generatedFrom ? undefined : editUrlFor(entry)}
  lastUpdated={entry.data.lastUpdated}
>
  <Content />
</DocsLayout>
