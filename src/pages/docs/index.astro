---
import LinkGroup from "@/components/docs-landing/LinkGroup.astro"
import QuickStart from "@/components/docs-landing/QuickStart.astro"
import CliReference from "@/components/product/CliReference.astro"
import McpConfig from "@/components/product/McpConfig.astro"
import DocsSearch from "@/components/site/DocsSearch.astro"
import PageOpening from "@/components/site/PageOpening.astro"
import Stage from "@/components/site/Stage.astro"
import MarketingLayout from "@/layouts/MarketingLayout.astro"
import { REFERENCE_GROUP, TOPIC_GROUPS, resolveGroups } from "@/lib/docs-landing"
import { getDocIds } from "@/lib/get-doc-links"

const ids = await getDocIds()
const topics = resolveGroups(TOPIC_GROUPS, ids)
const [reference] = resolveGroups([REFERENCE_GROUP], ids)
---

<MarketingLayout
  title="Docs | SlashObserve"
  description="Start with the demo stack, then connect your own stores. One page per topic, built from the repository at every release."
>
  <PageOpening title="Docs">
    <p class="lead">
      Start with the demo stack, then connect your own stores. One page per topic, built from the repository at every
      release.
    </p>
    <DocsSearch placeholder="Search the docs" shortcut />
  </PageOpening>

  <section class="wrap landing-top">
    <div class="cols2 top-grid">
      <QuickStart />
      <div class="lined topics">
        {topics.map((group) => <LinkGroup group={group} />)}
      </div>
    </div>
  </section>

  <section class="ruled">
    <div class="wrap landing-ref">
      <div class="split ref-split" data-in-view="rise">
        <Stage>
          <CliReference />
        </Stage>
        <div class="ref-side">
          <Stage>
            <McpConfig />
          </Stage>
          {reference && <LinkGroup group={reference} />}
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .landing-top {
    padding-bottom: 64px;
  }

  .top-grid {
    align-items: start;
    gap: 40px;
  }

  .topics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .landing-ref {
    padding-top: 56px;
    padding-bottom: 80px;
  }

  .ref-split {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: 40px;
  }

  .ref-side {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .landing-top {
      padding-bottom: 40px;
    }

    .ref-split {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .landing-ref {
      padding-top: 40px;
      padding-bottom: 56px;
    }
  }

  @media (max-width: 520px) {
    .topics {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { watchInView } from "../../lib/client/in-view"

  watchInView()
</script>
