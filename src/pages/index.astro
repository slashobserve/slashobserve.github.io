---
import Architecture from "../components/home/Architecture.astro"
import ClosingCta from "../components/home/ClosingCta.astro"
import FeatureCards from "../components/home/FeatureCards.astro"
import ForAgents from "../components/home/ForAgents.astro"
import FourQuestions from "../components/home/FourQuestions.astro"
import GrafanaImport from "../components/home/GrafanaImport.astro"
import Hero from "../components/home/Hero.astro"
import WorksWith from "../components/home/WorksWith.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="SlashObserve: ask for a dashboard, get one that works"
  description="SlashObserve builds Grafana-style dashboards from a sentence, on the Prometheus and ClickHouse you already run. Open source and self-hosted."
  halo
>
  <Hero links={links} />
  <WorksWith />
  <FourQuestions />
  <GrafanaImport links={links} />
  <FeatureCards />
  <ForAgents links={links} />
  <Architecture />
  <ClosingCta links={links} />
</MarketingLayout>
