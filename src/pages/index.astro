---
import BringWhatYouBuilt from "../components/home/BringWhatYouBuilt.astro"
import HomeHero from "../components/home/HomeHero.astro"
import SameRules from "../components/home/SameRules.astro"
import StoresStrip from "../components/home/StoresStrip.astro"
import Tour from "../components/home/Tour.astro"
import RunsOnBand from "../components/site/RunsOnBand.astro"
import SurfacesSection from "../components/site/SurfacesSection.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="SlashObserve: observability workspace for humans and agents"
  description="Metrics, logs and traces across Prometheus, ClickHouse, Loki, Tempo, Elasticsearch and OpenSearch, with dashboards, a logs page, a trace view and an agent that queries all of them. Ask for a dashboard in a sentence and get one that works. Open source and self-hosted."
>
  <HomeHero quickStart={links.quickStart} />
  <StoresStrip />
  <SameRules />
  <Tour />
  <BringWhatYouBuilt />
  <SurfacesSection lead="The web app, the observe CLI, and MCP for Claude Code and other MCP clients. Same save checks everywhere." />
  <RunsOnBand quickStart={links.quickStart} />
</MarketingLayout>
