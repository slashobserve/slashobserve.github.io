---
import "../styles/tokens.css"
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("starlight-theme") ||
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
    </script>
    <title>SlashObserve</title>
    <meta name="description" content="Dashboards from a sentence, on your own data." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p class="wordmark"><span style="color: var(--brand)">/</span>observe</p>
      <p class="tagline">Dashboards from a sentence, on your own data.</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 15px/1.55 var(--font-sans);
  }

  main {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  p {
    margin: 0;
  }

  .wordmark {
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.035em;
  }

  .tagline {
    color: var(--mfg);
  }
</style>
