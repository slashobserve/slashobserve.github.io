---
import ImportCoverageTable from "../components/migrate/ImportCoverageTable.astro"
import ImportStats from "../components/migrate/ImportStats.astro"
import MoveTour from "../components/migrate/MoveTour.astro"
import Band from "../components/site/Band.astro"
import PageOpening from "../components/site/PageOpening.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"
import { cleanImportPercent, readImportCorpus } from "../lib/import-corpus"
import { mappedPanelTypeCount, readImportCoverage } from "../lib/import-coverage"

const links = await getDocLinks()
const mapped = mappedPanelTypeCount(readImportCoverage())
const clean = cleanImportPercent(readImportCorpus())
const stats = [
  ...(mapped > 0 ? [{ value: String(mapped), label: "Grafana panel types with importable options, legacy ones included" }] : []),
  ...(clean !== null ? [{ value: `${clean}%`, label: "of the public test corpus converts with no placeholder and nothing left behind" }] : []),
]
---

<MarketingLayout
  title="Migrate to SlashObserve"
  description="Coming from Grafana, Kibana or OpenSearch Dashboards? Grafana dashboards import with their folders, variables and links. Elasticsearch and OpenSearch connect as they are, and the KQL you typed in Discover runs there. Saved objects are not imported."
>
  <PageOpening title="Coming from Grafana, Kibana or OpenSearch Dashboards?">
    <p class="lead">
      Connect the stores you already have and keep the habits you already have. A Grafana comes across one dashboard at a
      time with every query checked. An Elasticsearch or OpenSearch index connects as it is, and the KQL you typed in
      Discover runs here. Nothing is written back to any of them.
    </p>
    {
      (links.importGuide || links.elasticsearch) && (
        <div class="row actions">
          {links.importGuide && (
            <a class="btn btn-primary" href={links.importGuide}>
              Read the import guide
            </a>
          )}
          {links.elasticsearch && (
            <a class="btn" href={links.elasticsearch}>
              Connect Elasticsearch
            </a>
          )}
        </div>
      )
    }
  </PageOpening>
  <ImportStats stats={stats} />
  <MoveTour links={links} />
  <ImportCoverageTable />
  <Band>
    <h2 class="h2 band-title">Bring the dashboards this afternoon. Keep the queries you know.</h2>
    <p class="p">Point it at a Grafana you can read, or at the index pattern your Discover tab uses. Nothing is written back.</p>
    {
      links.importGuide && (
        <div class="row actions">
          <a class="btn btn-band" href={links.importGuide}>
            Import guide
          </a>
        </div>
      )
    }
  </Band>
</MarketingLayout>

<script>
  import { watchInView } from "../lib/client/in-view"

  watchInView()
</script>

<style>
  .actions {
    gap: 10px;
    flex-wrap: wrap;
  }

  .band-title {
    max-width: 22ch;
  }
</style>
