---
import BuildPlayback from "../components/product/BuildPlayback.astro"
import MetricInventory from "../components/product/MetricInventory.astro"
import VersionHistory from "../components/product/VersionHistory.astro"
import PageOpening from "../components/site/PageOpening.astro"
import RunsOnBand from "../components/site/RunsOnBand.astro"
import Section from "../components/site/Section.astro"
import Split from "../components/site/Split.astro"
import SurfacesSection from "../components/site/SurfacesSection.astro"
import MarketingLayout from "../layouts/MarketingLayout.astro"
import { getDocLinks } from "../lib/get-doc-links"

const links = await getDocLinks()
---

<MarketingLayout
  title="Build | SlashObserve"
  description="Ask for a dashboard in a sentence: the agent inventories the metric families in scope, runs every panel it adds before the save, and ends with a version and a link."
>
  <PageOpening title="Ask for a dashboard. Get one that works.">
    <p class="lead lead-20">
      The agent takes an inventory of the metric families in scope before it plans, saves one panel at a time, and ends
      with a version and a link. Every family in scope, apart from runtime metrics, ends in a panel or a stated reason,
      and every panel the agent adds or changes is run before the save.
    </p>
  </PageOpening>
  <BuildPlayback space="page" />
  <Section>
    <Split start={0.85} end={1.15}>
      <div slot="start" class="statement inventory-statement">
        <h2 class="h2">Every family in scope is accounted for.</h2>
        <p class="lead lead-17">
          Before it plans, the agent takes an inventory of every metric family in scope: a job, a service, a namespace,
          or a table. Every family in scope, apart from runtime metrics, ends in a panel or a stated reason, and the
          save result lists anything uncovered. Runtime metrics are counted, not listed.
        </p>
        <div class="row inventory-chips">
          <span class="chip">12 families</span>
          <span class="chip">12 panels</span>
          <span class="chip"><span class="dot tone-ok"></span>0 uncovered</span>
        </div>
      </div>
      <MetricInventory slot="end" />
    </Split>
  </Section>
  <Section>
    <Split start={1.15} end={0.85}>
      <VersionHistory slot="start" />
      <div slot="end" class="statement">
        <h2 class="h2">Every change is a version.</h2>
        <p class="lead lead-17">
          A build becomes one version. A follow-up in the chat, an edit in the panel editor, an agent repair, each is
          another, with a diff and a restore. A comment can be sent to the agent, and its change is a version too.
        </p>
      </div>
    </Split>
  </Section>
  <SurfacesSection
    lead="The tools behind the built-in agent are served over MCP too. Claude Code and other MCP clients build, read and repair dashboards with the same metric inventory. Same save checks everywhere."
  />
  <RunsOnBand quickStart={links.quickStart} />
</MarketingLayout>

<style>
  .statement {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .inventory-statement {
    gap: 18px;
  }

  .inventory-chips {
    gap: 8px;
    flex-wrap: wrap;
  }
</style>
