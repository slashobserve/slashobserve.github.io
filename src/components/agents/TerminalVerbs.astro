---
import Window from "../product/Window.astro"

const LINES = [
  "observe o new <title...> --text <markdown>",
  "observe o show <observation-id>",
  "observe o add <observation-id> --text <markdown>",
  "observe o keep <block-id> --version <n>",
  "observe o discard <block-id>",
  "observe o resolve <observation-id> --summary <line>",
  "observe o publish <observation-id>",
  "",
  "observe proposals list <dashboard-id>",
  "observe proposals show <proposal-id>",
  "observe proposals merge <proposal-id> --revision <n>",
  "observe proposals discard <proposal-id>",
]
---

<Window title="observe o, observe proposals" lights={false}>
  <div class="term">{LINES.map((line) => <span class="tl">{line}</span>)}</div>
</Window>

<style>
  .term {
    font-size: 12px;
  }
</style>
