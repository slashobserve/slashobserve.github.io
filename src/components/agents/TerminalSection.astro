---
import Section from "../site/Section.astro"
import Split from "../site/Split.astro"
import TerminalVerbs from "./TerminalVerbs.astro"

interface Props {
  cliObservations: string | null
}

const { cliObservations } = Astro.props
---

<Section>
  <Split>
    <div slot="start" class="copy">
      <h2 class="h2">The same verbs in the terminal.</h2>
      <p class="lead">
        <span class="mono">observe o</span> starts, reads, extends, resolves and publishes observations, and keeps or discards the
        blocks someone suggested. <span class="mono">observe proposals</span> lists, shows, merges and discards proposals. <span class="mono">observe</span> also has
        commands for dashboards, folders, comments, annotations, saved searches, datasources, logs, traces, metrics,
        activity, search, access requests, agent requests and Grafana imports. It has no commands for the Inbox,
        dashboard pins, the home dashboard or taking runs as an agent.
      </p>
      {
        cliObservations && (
          <a class="arrow" href={cliObservations}>
            The CLI reference →
          </a>
        )
      }
    </div>
    <div slot="end" data-in-view="rise">
      <TerminalVerbs />
    </div>
  </Split>
</Section>

<style>
  .copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .copy .lead {
    font-size: 17px;
  }
</style>
