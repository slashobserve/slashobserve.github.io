---
import Section from "../site/Section.astro"
import SectionHead from "../site/SectionHead.astro"

type Status = "Maps" | "Changes" | "Waits"

const STATUS_TONE: Record<Status, string> = {
  Maps: "tone-ok",
  Changes: "tone-s4",
  Waits: "tone-mfg",
}

type NotePart = string | { mono: string }

const rows: { feature: string; status: Status; note: NotePart[] }[] = [
  {
    feature: "Time series, stat, gauge, bar gauge, table, text, logs, traces",
    status: "Maps",
    note: [
      "Each becomes the matching ObserveSpec panel with its units, thresholds, overrides and legend, when its datasource is Prometheus, ClickHouse, Loki or Tempo.",
    ],
  },
  {
    feature: "Template variables",
    status: "Maps",
    note: ["Names and formats are kept, so ", { mono: "$job" }, " and ", { mono: "${job:regex}" }, " expand as before."],
  },
  {
    feature: "Transforms",
    status: "Maps",
    note: [
      "Organize, merge, reduce, filter, group by, join and the rest of the table. An unsupported transformation is dropped and reported at its path; the panel imports as partial.",
    ],
  },
  {
    feature: "Rows and collapsed rows",
    status: "Maps",
    note: ["Rows become row panels; collapsed state and repeat are kept."],
  },
  {
    feature: "Elasticsearch and OpenSearch panels",
    status: "Changes",
    note: [
      "A logs panel imports its Lucene query as a line query. A count over time keeps its query. Other metrics and bucket aggregations become a Query DSL body the panel runs as is. A geohash grid or a PPL query is dropped and the reason is listed. Terms variables become ",
      { mono: "label_values(...)" },
      ".",
    ],
  },
  {
    feature: "Folders, tags, dashboard links",
    status: "Changes",
    note: [
      "A nested folder becomes one folder titled Parent / Child. Tags are lowercased and capped at 20. Links to an address and links by tag are kept.",
    ],
  },
  {
    feature: "Gradients, shadows, panel backgrounds",
    status: "Changes",
    note: ["Drawn flat. Colour stays on data and status; the chrome is monochrome by design."],
  },
  {
    feature: 'Stat colour mode "value"',
    status: "Changes",
    note: ["The threshold colour pairs with an icon and a word instead of colouring the digits, so warning stays readable on white."],
  },
  {
    feature: "Third-party plugin panels",
    status: "Changes",
    note: [
      "Worldmap, singlestat, the pie chart plugin and the discrete panel become native geomap, stat or gauge, pie chart and state timeline panels.",
      " Any other plugin imports as a placeholder that keeps its title and layout; the original dashboard JSON stays with the import record.",
    ],
  },
  {
    feature: "Annotations",
    status: "Waits",
    note: [
      "Annotation queries are reported and not imported; built-in annotations are skipped. Add markers with ",
      { mono: "observe annotate" },
      " or the API.",
    ],
  },
  {
    feature: "Alert rules, contact points, silences",
    status: "Waits",
    note: ["Not imported in this release. Keep Alertmanager or Grafana alerting running beside SlashObserve."],
  },
  {
    feature: "Other datasources",
    status: "Waits",
    note: [
      "Panels on a datasource type SlashObserve does not query (InfluxDB, CloudWatch, Jaeger and others) import as placeholders that keep the title, layout and reason. The original dashboard JSON stays with the import record.",
    ],
  },
]
---

<Section>
  <SectionHead
    title="What maps, what changes, what waits."
    lead="How each Grafana feature comes across. The numbers above are generated from the importer at every release; this table describes the mapping."
    space={32}
  />
  <div class="win">
    <div class="scroll">
      <table class="tbl coverage">
        <thead>
          <tr>
            <th class="col-feature">Grafana feature</th>
            <th class="col-status">Status</th>
            <th>What happens on import</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                <td>
                  <span class="row">
                    <span class:list={["dot", STATUS_TONE[row.status]]} />
                    {row.status}
                  </span>
                </td>
                <td class="k">
                  {row.note.map((part) => (typeof part === "string" ? part : <span class="mono">{part.mono}</span>))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Section>

<style>
  .coverage {
    min-width: 640px;
    font-size: 13.5px;
  }

  .col-feature {
    width: 26%;
  }

  .col-status {
    width: 12%;
  }
</style>
