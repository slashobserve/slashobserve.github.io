---
import { sectionLabel } from "../../lib/docs-sidebar"

const { entry } = Astro.locals.starlightRoute
---

<div class="section-label">{sectionLabel(entry.id)}</div>
<h1 id="_top">{entry.data.title}</h1>

<style>
  .section-label {
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--mfg);
  }

  h1 {
    margin: 0;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--fg);
  }
</style>
