---
import SiteVersion from "@/components/site/SiteVersion.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { getDocLinks } from "@/lib/get-doc-links"
import { footerColumns } from "@/lib/site-nav"

const links = await getDocLinks()
const project = footerColumns(links).find((column) => column.title === "Project")
---

<footer class="footer">
  <div class="brand">
    <Wordmark size={15} />
    <span>Open source under Apache-2.0.</span>
    <span>Grafana is a trademark of Grafana Labs. SlashObserve is not affiliated with or endorsed by Grafana Labs.</span>
  </div>
  {
    project && (
      <nav aria-label="Project" class="project">
        {project.items.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <SiteVersion />
      </nav>
    )
  }
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 64px;
    padding: 24px 0 40px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    line-height: 20px;
    color: var(--mfg);
  }

  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--fg);
  }

  .brand span {
    color: var(--mfg);
  }

  .project {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
  }

  a {
    color: var(--mfg);
    text-decoration: none;
    transition: color 120ms;
  }

  a:hover {
    color: var(--fg);
  }

  a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>
