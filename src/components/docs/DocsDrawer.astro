---
import GitHubIcon from "@/components/site/GitHubIcon.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { getDocLinks } from "@/lib/get-doc-links"
import { GITHUB_URL, headerNav, isCurrentPage } from "@/lib/site-nav"

const links = await getDocLinks()
const siteNav = headerNav(links).filter((item) => !item.href.startsWith("/docs/"))
const currentFor = (href: string) => (isCurrentPage(href, Astro.url.pathname) ? "page" : undefined)
---

<dialog id="docs-drawer" data-mobile-sidebar data-state="closed" class="drawer" aria-label="Site navigation">
  <div class="panel">
    <div class="top">
      <a class="home" href="/" aria-label="SlashObserve home">
        <Wordmark size={20} />
      </a>
      <button type="button" class="docs-icon-btn" data-close-sidebar aria-label="Close navigation">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <nav aria-label="Site" class="site-nav">
      {
        siteNav.map((item) => (
          <a href={item.href} aria-current={currentFor(item.href)}>
            {item.label}
          </a>
        ))
      }
      <a href={GITHUB_URL}>
        <GitHubIcon size={15} />GitHub
      </a>
    </nav>
    <div class="rule" role="presentation"></div>
    <div data-nb-sidebar-drawer-slot class="slot"></div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    transition: background-color 200ms ease-out;
  }

  .drawer::backdrop {
    background: transparent;
  }

  .drawer[data-state="open"] {
    background: color-mix(in oklab, var(--ink-bg) 45%, transparent);
  }

  .panel {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: min(20rem, 85vw);
    height: 100%;
    background: var(--bg);
    border-right: 1px solid var(--border);
    transform: translateX(-100%);
    transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .drawer[data-state="open"] .panel {
    transform: none;
  }

  .top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    height: var(--nb-header-height);
    padding-inline: 16px;
    border-bottom: 1px solid var(--border);
  }

  .home {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    flex: none;
    flex-direction: column;
    padding: 8px 16px 0;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
  }

  .site-nav a:hover {
    background: var(--muted-bg);
  }

  .site-nav a:focus-visible,
  .home:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .rule {
    flex: none;
    height: 1px;
    margin: 8px 16px;
    background: var(--border);
  }

  .slot {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .slot > :global([data-nb-sidebar-tree]) {
    flex: 1;
    min-height: 0;
    padding: 8px 16px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .panel {
      transition: none;
    }
  }
</style>

<script>
  import { mount } from "@/lib/client/mount"
  import { lockScroll, unlockScroll } from "@/lib/client/scroll-lock"

  const CLOSE_DURATION_MS = 200
  const DESKTOP_QUERY = "(min-width: 64rem)"

  mount("[data-mobile-sidebar]", (root) => {
    const trigger = document.querySelector<HTMLElement>("[data-menu-btn]")
    if (!(root instanceof HTMLDialogElement) || !trigger) return () => {}
    const dialog = root

    const controller = new AbortController()
    const { signal } = controller
    let closeTimer: ReturnType<typeof setTimeout> | undefined

    const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches

    trigger.setAttribute("aria-controls", dialog.id)
    trigger.setAttribute("aria-expanded", "false")
    if (!trigger.hasAttribute("aria-haspopup")) trigger.setAttribute("aria-haspopup", "dialog")

    const clearTimer = () => {
      if (closeTimer) {
        clearTimeout(closeTimer)
        closeTimer = undefined
      }
    }

    const tree = document.querySelector<HTMLElement>("[data-nb-sidebar-tree]")
    const rail = tree?.parentElement ?? null
    const drawerSlot = dialog.querySelector<HTMLElement>("[data-nb-sidebar-drawer-slot]")
    const moveTreeToDrawer = () => {
      if (tree && drawerSlot && tree.parentElement !== drawerSlot) drawerSlot.append(tree)
    }
    const moveTreeToRail = () => {
      if (tree && rail && tree.parentElement !== rail) rail.prepend(tree)
    }

    const openSidebar = () => {
      clearTimer()
      if (dialog.open) {
        if (dialog.dataset.state === "closing") dialog.dataset.state = "open"
        return
      }

      moveTreeToDrawer()
      dialog.showModal()
      dialog.dataset.state = "closed"
      lockScroll()
      trigger.setAttribute("aria-expanded", "true")

      void dialog.offsetWidth
      dialog.dataset.state = "open"

      dialog.querySelector<HTMLElement>("[data-close-sidebar]")?.focus({ preventScroll: true })
    }

    const closeNow = () => {
      if (!dialog.open) return
      clearTimer()
      dialog.close()
    }

    const closeSidebar = () => {
      if (!dialog.open || dialog.dataset.state === "closing") return
      if (prefersReducedMotion()) {
        closeNow()
        return
      }
      dialog.dataset.state = "closing"
      closeTimer = setTimeout(() => dialog.close(), CLOSE_DURATION_MS)
    }

    trigger.addEventListener("click", openSidebar, { signal })

    dialog.addEventListener(
      "cancel",
      (event) => {
        event.preventDefault()
        closeSidebar()
      },
      { signal },
    )

    dialog.addEventListener(
      "close",
      () => {
        clearTimer()
        dialog.dataset.state = "closed"
        moveTreeToRail()
        unlockScroll()
        trigger.setAttribute("aria-expanded", "false")
        trigger.focus()
      },
      { signal },
    )

    dialog
      .querySelectorAll<HTMLElement>("[data-close-sidebar]")
      .forEach((el) => el.addEventListener("click", closeSidebar, { signal }))

    dialog.addEventListener(
      "click",
      (e) => {
        if (e.target === dialog) closeSidebar()
      },
      { signal },
    )

    const mql = window.matchMedia(DESKTOP_QUERY)
    mql.addEventListener(
      "change",
      (event) => {
        if (event.matches) closeNow()
      },
      { signal },
    )
    if (mql.matches) closeNow()

    return () => {
      controller.abort()
      clearTimer()
      moveTreeToRail()
      trigger.setAttribute("aria-expanded", "false")
      if (dialog.open) unlockScroll()
    }
  })
</script>
