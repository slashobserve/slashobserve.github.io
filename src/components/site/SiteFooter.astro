---
import type { DocLinks } from "../../lib/doc-links"
import { readSiteFacts, versionLine } from "../../lib/site-facts"
import { footerColumns } from "../../lib/site-nav"
import Wordmark from "./Wordmark.astro"

interface Props {
  links: DocLinks
}

const { links } = Astro.props
const version = versionLine(readSiteFacts())
---

<footer class="foot">
  <div class="wrap foot-grid">
    <div class="brand">
      <span class="brand-mark"><Wordmark size={18} /></span>
      <span class="tagline">Observability dashboards from a sentence, on your own data. Open source under Apache-2.0.</span>
      <span class="legal">
        Grafana is a trademark of Grafana Labs. SlashObserve is not affiliated with or endorsed by Grafana Labs.
      </span>
      <span>No analytics, no cookies.</span>
    </div>
    <nav aria-label="Footer" class="columns">
      {
        footerColumns(links).map((column) => (
          <div>
            <span class="label title">{column.title}</span>
            {column.items.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
            {column.title === "Project" && version && <span class="mono site-version">{version}</span>}
          </div>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    padding-top: 48px;
    padding-bottom: 40px;
    font-size: 13px;
    color: var(--mfg);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .brand-mark {
    color: var(--fg);
  }

  .tagline {
    max-width: 36ch;
  }

  .legal {
    max-width: 40ch;
  }

  .columns {
    display: contents;
  }

  .title {
    display: block;
    margin-bottom: 8px;
  }

  a {
    display: block;
    padding: 3px 0;
    color: var(--mfg);
    text-decoration: none;
  }

  a:hover {
    color: var(--fg);
  }

  .site-version {
    display: block;
    padding-top: 6px;
  }

  @media (max-width: 900px) {
    .foot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
