---
import { railItems, type TourStopContent } from "../../lib/tour"
import Section from "./Section.astro"
import SectionHead from "./SectionHead.astro"

interface Props {
  title: string
  lead: string
  railLabel: string
  stops: readonly TourStopContent[]
}

const { title, lead, railLabel, stops } = Astro.props

const items = railItems(stops)
const drawings = await Promise.all(
  stops.map(({ id }) => {
    if (!Astro.slots.has(id)) throw new Error(`Tour stop ${id} has no drawing`)
    return Astro.slots.render(id)
  }),
)
---

<Section>
  <SectionHead title={title} lead={lead} />
  <div class="tour">
    <nav class="rail" aria-label={railLabel} data-tour-rail>
      <span class="rail-label" aria-hidden="true">{railLabel}</span>
      {
        items.map(({ id, label, href }, index) => (
          <a class="item" href={href} data-tour-item={id} aria-current={index === 0 ? "location" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="stops">
      {
        stops.map(({ id, place, title, text, note, links }, index) => (
          <article class="stop" id={id} data-tour-stop>
            <div class="stop-head">
              <div class="stop-title">
                <span class="place k">{place}</span>
                <h3 class="h3" tabindex="-1" data-tour-heading>
                  {title}
                </h3>
              </div>
              <div class="stop-text">
                <p class="p">{text}</p>
                {note && <p class="hint">{note}</p>}
                {links.length > 0 && (
                  <div class="stop-links">
                    {links.map(({ href, label }) => (
                      <a class="arrow" href={href}>
                        {label} →
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
            <div class="drawing" data-in-view="rise">
              <Fragment set:html={drawings[index]} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .tour {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .rail {
    position: sticky;
    top: 88px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--chrome);
    font-size: 14px;
  }

  .rail-label {
    padding: 6px 8px 8px;
    color: var(--mfg);
    font-size: 12px;
  }

  .item {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 34px;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--mfg);
    text-decoration: none;
    white-space: nowrap;
  }

  .item:hover {
    color: var(--fg);
  }

  .item[aria-current] {
    border-color: var(--border);
    background: var(--card);
    color: var(--fg);
    font-weight: 500;
  }

  .stops {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 48px 0;
    border-top: 1px solid var(--border);
    min-width: 0;
  }

  .stop:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px;
    align-items: start;
  }

  .stop-title,
  .stop-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop-title {
    gap: 10px;
  }

  .stop-text {
    gap: 12px;
    align-items: flex-start;
  }

  .place {
    font-size: 13.5px;
  }

  .stop-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .drawing {
    min-width: 0;
  }

  .stop h3:focus {
    outline: none;
  }

  @media (max-width: 900px) {
    .tour {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .rail {
      top: 57px;
      z-index: 5;
      flex-direction: row;
      overflow-x: auto;
      padding: 6px;
    }

    .rail-label {
      display: none;
    }

    .item {
      flex: none;
      height: 44px;
      padding: 0 12px;
    }

    .stop {
      gap: 20px;
      padding: 40px 0;
      scroll-margin-top: 56px;
    }

    .stop-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>

<script>
  import { watchInView } from "../../lib/client/in-view"
  import { activeStop } from "../../lib/tour"

  const READING_LINE = 0.4
  const CURRENT = "location"

  const rail = document.querySelector<HTMLElement>("[data-tour-rail]")
  const items = [...document.querySelectorAll<HTMLAnchorElement>("[data-tour-item]")]
  const stops = [...document.querySelectorAll<HTMLElement>("[data-tour-stop]")]

  if (rail && items.length === stops.length && stops.length > 0) {
    watchInView()

    let shown = 0
    let queued = false

    const show = (index: number) => {
      if (index === shown) return
      shown = index
      items.forEach((item, position) => {
        if (position === index) item.setAttribute("aria-current", CURRENT)
        else item.removeAttribute("aria-current")
      })
      const item = items[index]
      if (rail.scrollWidth > rail.clientWidth) {
        rail.scrollLeft = item.offsetLeft - (rail.clientWidth - item.offsetWidth) / 2
      }
    }

    const update = () => {
      queued = false
      const line = window.innerHeight * READING_LINE
      show(activeStop(stops.map((stop) => stop.getBoundingClientRect().top), line))
    }

    const schedule = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    items.forEach((item, index) => {
      item.addEventListener("click", (event) => {
        event.preventDefault()
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
        stops[index].scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" })
        stops[index].querySelector<HTMLElement>("[data-tour-heading]")?.focus({ preventScroll: true })
        history.replaceState(null, "", item.hash)
        show(index)
      })
    })

    addEventListener("scroll", schedule, { passive: true })
    addEventListener("resize", schedule)
    update()
  }
</script>
