---
import { tabId, type TourStopContent } from "../../lib/tour"
import Section from "./Section.astro"
import SectionHead from "./SectionHead.astro"

interface Props {
  title: string
  lead: string
  tabsLabel: string
  eyebrow?: string
  stops: readonly TourStopContent[]
}

const { title, lead, tabsLabel, eyebrow, stops } = Astro.props

const drawings = await Promise.all(
  stops.map(({ id }) => {
    if (!Astro.slots.has(id)) throw new Error(`Tour stop ${id} has no drawing`)
    return Astro.slots.render(id)
  }),
)
---

<Section>
  <SectionHead title={title} lead={lead} eyebrow={eyebrow} />
  <div class="tour" data-tour>
    <div class="tabs" role="tablist" aria-label={tabsLabel} data-tour-tabs>
      {
        stops.map(({ id, place }, index) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={tabId(id)}
            aria-controls={id}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-tour-tab
          >
            {place}
          </button>
        ))
      }
    </div>
    <div class="stops">
      {
        stops.map(({ id, place, title, text, note, links }, index) => (
          <article class="stop" id={id} aria-labelledby={tabId(id)} data-tour-stop>
            <div class="stop-head">
              <div class="stop-title">
                <span class="place k">{place}</span>
                <h3 class="h3">{title}</h3>
              </div>
              <div class="stop-text">
                <p class="p">{text}</p>
                {note && <p class="hint">{note}</p>}
                {links.length > 0 && (
                  <div class="stop-links">
                    {links.map(({ href, label }) => (
                      <a class="arrow" href={href}>
                        {label} →
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
            <div class="drawing" data-in-view="rise">
              <Fragment set:html={drawings[index]} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .tour {
    display: flex;
    flex-direction: column;
    min-width: 0;
    scroll-margin-top: 88px;
  }

  .tabs {
    display: none;
  }

  .tab {
    flex: none;
    box-sizing: border-box;
    height: 44px;
    margin: 0 0 -1px;
    padding: 0 16px;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: none;
    color: var(--mfg);
    font: inherit;
    font-size: 15px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .tab:hover {
    color: var(--fg);
  }

  .tab[aria-selected="true"] {
    border-bottom-color: var(--brand);
    color: var(--fg);
  }

  .tab:focus-visible {
    outline-offset: -2px;
  }

  .stops {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 48px 0;
    border-top: 1px solid var(--border);
    min-width: 0;
  }

  .stop:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px;
    align-items: start;
  }

  .stop-title,
  .stop-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop-title {
    gap: 10px;
  }

  .stop-text {
    gap: 12px;
    align-items: flex-start;
  }

  .place {
    font-size: 13.5px;
  }

  .stop-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .drawing {
    min-width: 0;
  }

  @media (scripting: enabled) {
    .tabs {
      display: flex;
      margin-bottom: 40px;
      border-bottom: 1px solid var(--border);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .stop,
    .stop:first-child,
    .stop:last-child {
      padding: 0;
      border-top: 0;
    }

    .tour:not([data-ready]) .stop:not(:first-child),
    .stop[hidden] {
      display: none;
    }

    .place {
      display: none;
    }

    .tour[data-ready] .stop-head {
      animation: stop-in 0.25s ease-out;
    }
  }

  @keyframes stop-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour[data-ready] .stop-head {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .tab {
      padding: 0 12px;
    }

    .stop {
      gap: 20px;
      padding: 40px 0;
    }

    .stop-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }

  @media (scripting: enabled) and (max-width: 900px) {
    .tabs {
      margin-bottom: 28px;
    }

    .stop {
      padding: 0;
    }
  }
</style>

<script>
  import { watchInView } from "../../lib/client/in-view"
  import { stopForHash, tabForKey } from "../../lib/tour"

  const tour = document.querySelector<HTMLElement>("[data-tour]")
  const strip = document.querySelector<HTMLElement>("[data-tour-tabs]")
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tour-tab]")]
  const stops = [...document.querySelectorAll<HTMLElement>("[data-tour-stop]")]

  if (tour && strip && tabs.length === stops.length && stops.length > 0) {
    const ids = stops.map((stop) => stop.id)

    const select = (index: number) => {
      tabs.forEach((tab, position) => {
        const selected = position === index
        tab.setAttribute("aria-selected", selected ? "true" : "false")
        tab.tabIndex = selected ? 0 : -1
        stops[position].hidden = !selected
      })
      const tab = tabs[index]
      if (strip.scrollWidth > strip.clientWidth) {
        strip.scrollLeft = tab.offsetLeft - (strip.clientWidth - tab.offsetWidth) / 2
      }
    }

    const open = (index: number) => {
      select(index)
      history.replaceState(null, "", `#${ids[index]}`)
    }

    const followHash = () => {
      const index = stopForHash(location.hash, ids)
      if (index === null) return
      select(index)
      tour.scrollIntoView({ block: "start" })
    }

    stops.forEach((stop) => stop.setAttribute("role", "tabpanel"))
    select(0)
    tour.setAttribute("data-ready", "")
    watchInView()
    followHash()

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => open(index))
      tab.addEventListener("keydown", (event) => {
        const next = tabForKey(event.key, index, tabs.length)
        if (next === null) return
        event.preventDefault()
        open(next)
        tabs[next].focus()
      })
    })

    addEventListener("hashchange", followHash)
  }
</script>
