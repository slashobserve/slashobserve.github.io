---
import type { DocLinks } from "../../lib/doc-links"
import {
  FEATURE_BLURBS,
  getStartedHref,
  GITHUB_URL,
  headerNav,
  holdsCurrentPage,
  isCurrentPage,
  isNavGroup,
} from "../../lib/site-nav"
import GitHubIcon from "./GitHubIcon.astro"
import PreReleaseTag from "./PreReleaseTag.astro"
import ThemeToggle from "./ThemeToggle.astro"
import Wordmark from "./Wordmark.astro"

interface Props {
  links: DocLinks
}

const { links } = Astro.props
const getStarted = getStartedHref(links)
const navItems = headerNav(links)
const currentFor = (href: string) => (isCurrentPage(href, Astro.url.pathname) ? "page" : undefined)
---

<div class="header-bar" data-header-bar>
  <header class="wrap">
    <a class="home" href="/" aria-label="SlashObserve home">
      <Wordmark size={22} />
    </a>
    <PreReleaseTag href={links.upgrades} />
    <nav aria-label="Main" class="nav main-nav hide-sm">
      {navItems.map((entry) =>
        isNavGroup(entry) ? (
          <div class="group" data-nav-group>
            <button
              type="button"
              class="group-toggle"
              aria-expanded="false"
              aria-controls="nav-group-panel"
              data-current={holdsCurrentPage(entry, Astro.url.pathname) ? "" : undefined}
            >
              {entry.label}
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="group-panel" id="nav-group-panel">
              <div class="group-list">
                {entry.items.map((item) => (
                  <a class="group-link" href={item.href} aria-current={currentFor(item.href)}>
                    <span class="group-label">{item.label}</span>
                    <span class="group-blurb">{FEATURE_BLURBS[item.href]}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={entry.href} aria-current={currentFor(entry.href)}>
            {entry.label}
          </a>
        ),
      )}
    </nav>
    <div class="actions">
      <a class="github hide-sm" href={GITHUB_URL}>GitHub</a>
      <ThemeToggle />
      {getStarted && (
        <a class="btn btn-primary btn-sm get-started hide-sm" href={getStarted}>
          Get started
        </a>
      )}
      <button
        type="button"
        class="icon-btn menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg
          class="icon-open"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <nav id="site-menu" class="menu-panel" aria-label="Mobile" hidden>
      {navItems.map((entry) =>
        isNavGroup(entry) ? (
          <Fragment>
            <p class="menu-heading">{entry.label}</p>
            {entry.items.map((item) => (
              <a class="menu-link" href={item.href} aria-current={currentFor(item.href)}>
                {item.label}
              </a>
            ))}
            <hr class="menu-rule" />
          </Fragment>
        ) : (
          <a class="menu-link" href={entry.href} aria-current={currentFor(entry.href)}>
            {entry.label}
          </a>
        ),
      )}
      <a class="menu-link" href={GITHUB_URL} aria-current={currentFor(GITHUB_URL)}>
        <GitHubIcon size={15} />GitHub
      </a>
    </nav>
  </header>
</div>

<style>
  .header-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .header-bar[data-at-top]:not(:has(.menu-toggle[aria-expanded="true"])) {
    border-bottom-color: transparent;
    background: transparent;
  }

  .main-nav {
    align-items: center;
  }

  .group {
    position: relative;
  }

  .group-toggle {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--mfg);
    cursor: pointer;
  }

  .group-toggle:hover,
  .group[data-open] .group-toggle {
    color: var(--fg);
  }

  .group-toggle[data-current] {
    font-weight: 500;
    color: var(--fg);
  }

  .group-toggle svg {
    transition: rotate 0.15s ease;
  }

  .group[data-open] .group-toggle svg {
    rotate: 180deg;
  }

  .group-panel {
    position: absolute;
    top: 100%;
    left: -18px;
    display: none;
    padding-top: 14px;
  }

  .group[data-open] .group-panel {
    display: block;
  }

  .group-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 340px;
    padding: 6px;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  .group-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 12px;
    border-radius: 6px;
  }

  .group-link:hover,
  .group-link[aria-current="page"] {
    background: var(--muted);
  }

  .group-label {
    font-weight: 500;
    color: var(--fg);
  }

  .group-blurb {
    font-size: 13px;
    font-weight: 400;
    color: var(--mfg);
  }

  @media (scripting: none) {
    .group:hover .group-panel,
    .group:focus-within .group-panel {
      display: block;
    }
  }

  header {
    display: flex;
    align-items: center;
    gap: 36px;
    height: 64px;
  }

  header :global(.pre-release-tag) {
    margin-left: -24px;
  }

  .home {
    text-decoration: none;
    color: var(--fg);
  }

  .actions {
    margin-left: auto;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .github {
    padding: 0 10px;
    font-size: 14.5px;
    color: var(--mfg);
    text-decoration: none;
  }

  .github:hover {
    color: var(--fg);
  }

  .get-started {
    margin-left: 8px;
  }

  .menu-toggle {
    display: none;
    flex: none;
    padding: 0;
  }

  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px 20px;
    box-sizing: border-box;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .menu-panel[hidden] {
    display: none;
  }

  .menu-link {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    border-radius: 6px;
  }

  @media (min-width: 901px) {
    .menu-panel {
      display: none;
    }
  }

  .menu-heading {
    margin: 6px 10px 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mfg);
  }

  .menu-rule {
    width: 100%;
    margin: 6px 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .menu-link:hover {
    background: var(--muted);
    color: var(--fg);
  }

  .menu-link[aria-current="page"] {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    header {
      height: 56px;
    }

    .menu-toggle {
      display: inline-flex;
      width: 44px;
      height: 44px;
      margin-right: -10px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel,
    .group-list {
      animation: menu-fade 120ms ease-out;
    }
  }

  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script is:inline>
  {
    const bar = document.querySelector("[data-header-bar]")
    const markTop = () => bar.toggleAttribute("data-at-top", window.scrollY < 8)
    markTop()
    addEventListener("scroll", markTop, { passive: true })
  }
</script>

<script>
  document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
    const button = group.querySelector<HTMLButtonElement>("button")
    if (!button) return
    const canHover = matchMedia("(hover: hover)")
    let openedByHover = false
    const setOpen = (open: boolean) => {
      group.toggleAttribute("data-open", open)
      button.setAttribute("aria-expanded", String(open))
      if (!open) openedByHover = false
    }
    const isOpen = () => group.hasAttribute("data-open")

    button.addEventListener("click", () => {
      setOpen(!isOpen() || openedByHover)
      openedByHover = false
    })
    group.addEventListener("mouseenter", () => {
      if (!canHover.matches || isOpen()) return
      setOpen(true)
      openedByHover = true
    })
    group.addEventListener("mouseleave", () => {
      if (canHover.matches) setOpen(false)
    })
    group.addEventListener("focusout", (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) setOpen(false)
    })
    group.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return
      setOpen(false)
      button.focus()
    })
    document.addEventListener("click", (event) => {
      if (isOpen() && !group.contains(event.target as Node)) setOpen(false)
    })
  })

  const MOBILE_QUERY = "(max-width: 900px)"
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const panel = document.getElementById("site-menu")
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open
      toggle.setAttribute("aria-expanded", String(open))
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu")
    }
    const isOpen = () => !panel.hidden

    toggle.addEventListener("click", () => setOpen(!isOpen()))

    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false)
    })

    document.addEventListener("click", (event) => {
      const target = event.target as Node
      if (isOpen() && !panel.contains(target) && !toggle.contains(target)) setOpen(false)
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return
      setOpen(false)
      toggle.focus()
    })

    matchMedia(MOBILE_QUERY).addEventListener("change", (event) => {
      if (!event.matches) setOpen(false)
    })
  }
</script>
