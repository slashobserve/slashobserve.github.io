---
import type { DocLinks } from "../../lib/doc-links"
import { getStartedHref, GITHUB_URL, headerNav, isCurrentPage } from "../../lib/site-nav"
import GitHubIcon from "./GitHubIcon.astro"
import ThemeToggle from "./ThemeToggle.astro"
import Wordmark from "./Wordmark.astro"

interface Props {
  links: DocLinks
}

const { links } = Astro.props
const getStarted = getStartedHref(links)
const navItems = headerNav(links)
const currentFor = (href: string) => (isCurrentPage(href, Astro.url.pathname) ? "page" : undefined)
---

<div class="header-bar">
  <header class="wrap">
    <a class="home" href="/" aria-label="SlashObserve home">
      <Wordmark size={22} />
    </a>
    <nav aria-label="Main" class="nav main-nav hide-sm">
      {navItems.map((item) => (
        <a href={item.href} aria-current={currentFor(item.href)}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="actions">
      <a class="github hide-sm" href={GITHUB_URL}>GitHub</a>
      <ThemeToggle />
      {getStarted && (
        <a class="btn btn-primary btn-sm get-started hide-sm" href={getStarted}>
          Get started
        </a>
      )}
      <button
        type="button"
        class="icon-btn menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg
          class="icon-open"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <nav id="site-menu" class="menu-panel" aria-label="Mobile" hidden>
      {navItems.map((item) => (
        <a class="menu-link" href={item.href} aria-current={currentFor(item.href)}>
          {item.label}
        </a>
      ))}
      <a class="menu-link" href={GITHUB_URL} aria-current={currentFor(GITHUB_URL)}>
        <GitHubIcon size={15} />GitHub
      </a>
    </nav>
  </header>
</div>

<style>
  .header-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  header {
    display: flex;
    align-items: center;
    gap: 36px;
    height: 64px;
  }

  .home {
    text-decoration: none;
    color: var(--fg);
  }

  .actions {
    margin-left: auto;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .github {
    padding: 0 10px;
    font-size: 14.5px;
    color: var(--mfg);
    text-decoration: none;
  }

  .github:hover {
    color: var(--fg);
  }

  .get-started {
    margin-left: 8px;
  }

  .menu-toggle {
    display: none;
    flex: none;
    padding: 0;
  }

  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px 20px;
    box-sizing: border-box;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .menu-panel[hidden] {
    display: none;
  }

  .menu-link {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    border-radius: 6px;
  }

  .menu-link:hover {
    background: var(--muted);
    color: var(--fg);
  }

  .menu-link[aria-current="page"] {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    header {
      height: 56px;
    }

    .menu-toggle {
      display: inline-flex;
      width: 44px;
      height: 44px;
      margin-right: -10px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel {
      animation: menu-fade 120ms ease-out;
    }
  }

  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const MOBILE_QUERY = "(max-width: 900px)"
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const panel = document.getElementById("site-menu")
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open
      toggle.setAttribute("aria-expanded", String(open))
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu")
    }
    const isOpen = () => !panel.hidden

    toggle.addEventListener("click", () => setOpen(!isOpen()))

    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false)
    })

    document.addEventListener("click", (event) => {
      const target = event.target as Node
      if (isOpen() && !panel.contains(target) && !toggle.contains(target)) setOpen(false)
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return
      setOpen(false)
      toggle.focus()
    })

    matchMedia(MOBILE_QUERY).addEventListener("change", (event) => {
      if (!event.matches) setOpen(false)
    })
  }
</script>
