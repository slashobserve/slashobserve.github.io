---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<section class="band">
  <div class:list={["wrap section-band band-inner", className]}><slot /></div>
</section>

<style>
  .band-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .band-inner :global(.p) {
    max-width: 60ch;
  }
</style>
