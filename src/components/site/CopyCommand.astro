---
interface Props {
  command: string
}

const { command } = Astro.props
const [head, ...piped] = command.split(" | ")
---

<div class="cmd command" data-command={command}>
  <span class="prompt" aria-hidden="true">$</span>
  <span class="text" title={command}>{head}{piped.map((segment) => <span class="piped"> | {segment}</span>)}</span>
  <button type="button" class="copy" hidden>Copy</button>
  <span class="sr-only status" role="status"></span>
</div>

<style>
  .command {
    height: auto;
    min-height: 40px;
    text-align: left;
  }

  .prompt {
    color: var(--mfg);
  }

  .text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .copy:hover {
    background: var(--muted);
  }

  @media (max-width: 900px) {
    .command {
      min-height: 44px;
      padding: 6px 6px 6px 14px;
      font-size: 12px;
      line-height: 1.6;
    }

    .text {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      overflow: visible;
      text-overflow: clip;
    }

    .piped {
      white-space: nowrap;
    }
  }
</style>

<script>
  const CONFIRM_MS = 1500

  function selectText(node: Element) {
    const range = document.createRange()
    range.selectNodeContents(node)
    const selection = getSelection()
    selection?.removeAllRanges()
    selection?.addRange(range)
  }

  document.querySelectorAll<HTMLElement>("[data-command]").forEach((row) => {
    const command = row.dataset.command ?? ""
    const button = row.querySelector<HTMLButtonElement>(".copy")
    const text = row.querySelector(".text")
    const status = row.querySelector(".status")
    if (!button || !text || !status || !navigator.clipboard) return
    button.hidden = false

    let resetTimer: ReturnType<typeof setTimeout> | undefined

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command)
      } catch {
        selectText(text)
        status.textContent = "Press Ctrl+C or Cmd+C to copy"
        return
      }
      button.textContent = "Copied"
      status.textContent = "Copied to clipboard"
      clearTimeout(resetTimer)
      resetTimer = setTimeout(() => {
        button.textContent = "Copy"
      }, CONFIRM_MS)
    })
  })
</script>
