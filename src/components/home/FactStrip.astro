---
const facts = [
  { term: "Apache-2.0", line: "Open source, no open core tricks" },
  { term: "One binary", line: "Plus Postgres. Helm chart and compose included" },
  { term: "Your network", line: "Runs in your network. Only the agent's tool results reach the model you configure." },
  { term: "Any model", line: "Anthropic, OpenAI-compatible, or local" },
]
---

<section class="ruled">
  <div class="wrap strip">
    {
      facts.map(({ term, line }) => (
        <div class="fact">
          <span class="fact-term">{term}</span>
          <span class="hint">{line}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .strip {
    padding-top: 56px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact-term {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  @media (max-width: 900px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
