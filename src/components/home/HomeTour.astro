---
import { AGENTS_PATH, DASHBOARDS_PATH, OBSERVATIONS_PATH, SIGNALS_PATH } from "../../lib/site-nav"
import { tourTitle, type TourStopContent } from "../../lib/tour"
import AgentsScreen from "../product/AgentsScreen.astro"
import AskOnPanel from "../product/AskOnPanel.astro"
import InboxScreen from "../product/InboxScreen.astro"
import LogsSource from "../product/LogsSource.astro"
import MessageToBlock from "../product/MessageToBlock.astro"
import PublishRca from "../product/PublishRca.astro"
import TraceCard from "../product/TraceCard.astro"
import Stage from "../site/Stage.astro"
import Tour from "../site/Tour.astro"

interface Props {
  askAndComment: string | null
}

const { askAndComment } = Astro.props

const stops: TourStopContent[] = [
  {
    id: "inbox",
    place: "Inbox",
    title: "Start from what needs you.",
    text: "The Inbox keeps what asks something of you in one list: a proposal to merge, a block to keep, a mention, a reply, a failed run, a repair the agent saved or a request for comment access. Each item shows why it is there and can be marked done, and the unread count follows you across browsers.",
    links: [],
  },
  {
    id: "observations",
    place: "Observations",
    title: "An investigation is a page, not a chat log.",
    text: "Text, panels, logs and snapshots are blocks on the page, and the discussion beside it holds the messages, from which Add to page puts one on the page as a text block. Publish as RCA freezes the page into a numbered revision, and a person can share that revision read-only with a public link.",
    links: [{ href: OBSERVATIONS_PATH, label: "Observations" }],
  },
  {
    id: "dashboards",
    place: "Dashboards",
    title: "Ask about any spot on a panel.",
    text: "Ask for a dashboard and the agent runs each panel it adds before the save, then ends with a version and a link. On the dashboard, Ask mode puts your question on one point, range, table row or value, and the answer comes back in a box beside it, seen only by you and Admins until you share it. Only Revise the dashboard changes the dashboard.",
    links: [
      { href: DASHBOARDS_PATH, label: "Dashboards" },
      ...(askAndComment ? [{ href: askAndComment, label: "How Comment and Ask work" }] : []),
    ],
  },
  {
    id: "logs-and-traces",
    place: "Logs and traces",
    title: "Search in the language each store speaks.",
    text: "Each logs datasource has its own page, searched in its own language: LogQL on Loki, SQL on ClickHouse, KQL on Elasticsearch and OpenSearch. Traces on Tempo take TraceQL, and on Jaeger a key=value search. A log line that carries a trace id opens that trace.",
    links: [{ href: SIGNALS_PATH, label: "Signals" }],
  },
  {
    id: "agents",
    place: "Agents",
    title: "Your agents work here too.",
    text: "Observe Agent is built in and runs on the model you configure. Claude Code and other MCP clients connect as named agents, each set to save directly or to propose.",
    links: [{ href: AGENTS_PATH, label: "Agents" }],
  },
]
---

<Tour eyebrow="In the app" title={tourTitle(stops.length)} lead="Each one is a place in the app's sidebar." tabsLabel="In the app" stops={stops}>
  <Stage slot="inbox"><InboxScreen /></Stage>
  <Stage slot="observations">
    <div class="pair pair-top">
      <MessageToBlock />
      <PublishRca />
    </div>
  </Stage>
  <Stage slot="dashboards"><AskOnPanel /></Stage>
  <Stage slot="logs-and-traces">
    <div class="pair">
      <LogsSource />
      <TraceCard />
    </div>
  </Stage>
  <Stage slot="agents"><AgentsScreen /></Stage>
</Tour>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pair-top {
    align-items: start;
  }

  @media (max-width: 900px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
