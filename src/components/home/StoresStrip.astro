---
import { logoAspect, STORE_LOGOS } from "../../lib/store-logos"

const LOGO_HEIGHT = 22

const stores: { store: string; logo: keyof typeof STORE_LOGOS }[] = [
  { store: "Prometheus", logo: "prometheus" },
  { store: "ClickHouse", logo: "clickhouse" },
  { store: "Loki", logo: "loki" },
  { store: "Tempo", logo: "tempo" },
  { store: "Elasticsearch", logo: "elasticsearch" },
  { store: "OpenSearch", logo: "opensearch" },
]
---

<section class="strip">
  <div class="wrap">
    <div class="marquee">
      <div class="track">
        {
          [false, true].map((repeat) => (
            <ul aria-label={repeat ? undefined : "Stores"} aria-hidden={repeat ? "true" : undefined} class:list={{ repeat }}>
              {stores.map(({ store, logo }) => (
                <li>
                  <svg
                    class="logo"
                    width={Math.round(LOGO_HEIGHT * logoAspect(STORE_LOGOS[logo]))}
                    height={LOGO_HEIGHT}
                    viewBox={STORE_LOGOS[logo].viewBox}
                    aria-hidden="true"
                    fill="currentColor"
                  >
                    {STORE_LOGOS[logo].paths.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                  <span class="store">{store}</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .strip {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
  }

  ul {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    justify-content: center;
    width: 240px;
    padding: 10px 0;
  }

  .store {
    font-size: 16px;
    font-weight: 500;
  }

  .logo {
    flex: none;
    color: var(--mfg);
  }

  @media (max-width: 900px) {
    .strip {
      padding-top: 36px;
      padding-bottom: 44px;
    }

    li {
      width: 190px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: stores-scroll 36s linear infinite;
    }

    .marquee:hover .track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .track,
    ul {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    li {
      width: auto;
      padding: 8px 20px;
    }

    .repeat {
      display: none;
    }
  }

  @keyframes stores-scroll {
    to {
      translate: -50% 0;
    }
  }
</style>
