---
import { INSTALL_COMMAND } from "../../lib/site-facts"
import ObservationScreen from "../product/ObservationScreen.astro"
import CopyCommand from "../site/CopyCommand.astro"
import PreReleaseNote from "../site/PreReleaseNote.astro"

interface Props {
  quickStart: string | null
}

const { quickStart } = Astro.props
---

<section class="top">
  <div class="backdrop box-grid" aria-hidden="true"></div>
  <div class="wrap hero">
    <p class="eyebrow">Open source and self-hosted</p>
    <h1 class="h1">Observability workspace<br />for humans and agents.</h1>
    <p class="lead">
      Dashboards, logs, traces and investigations in one place your team shares with its agents. The queries an agent
      adds or changes run before they are saved, every dashboard and observation change has an author, and all of it
      reads the stores you already run.
    </p>
    <div class="cta">
      {quickStart && <a class="btn btn-primary" href={quickStart}>Read the quick start</a>}
      <CopyCommand command={INSTALL_COMMAND} />
    </div>
    <PreReleaseNote />
    <p class="hint">
      Installs the observe CLI on macOS and Linux. The server is one container beside Postgres, and people sign in through
      your OpenID Connect provider, or you leave it out and use service-account keys only. The built-in agent sends your prompt, your datasource names and what its tools
      return to the model you configure.
    </p>
  </div>
  <div class="wrap screen" data-sequence>
    <ObservationScreen />
  </div>
</section>

<style>
  .top {
    position: relative;
  }

  .backdrop {
    position: absolute;
    inset: -65px 0 auto;
    z-index: -1;
    height: 685px;
    background-image: radial-gradient(
      ellipse 60% 70% at 50% 0%,
      color-mix(in srgb, var(--brand) 13%, transparent),
      transparent
    );
    --box-grid-fade: radial-gradient(ellipse 62% 78% at 50% 22%, black 25%, transparent);
  }

  .hero {
    align-items: center;
    padding-top: 56px;
    padding-bottom: 0;
    text-align: center;
  }

  .hero .lead {
    max-width: 760px;
    text-wrap: balance;
  }

  .hint {
    text-wrap: balance;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 100%;
  }

  .hint {
    max-width: 640px;
    margin: 0;
    font-size: 14px;
  }

  .screen {
    margin-top: 56px;
  }

  @media (max-width: 900px) {
    .backdrop {
      top: -57px;
      height: 477px;
    }

    .hero {
      align-items: flex-start;
      padding-top: 48px;
      text-align: left;
    }

    .cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .screen {
      margin-top: 36px;
    }
  }
</style>
