---
import {
  siClaude,
  siClickhouse,
  siCursor,
  siGrafana,
  siOpenid,
  siOpentelemetry,
  siPrometheus,
} from "simple-icons"

const items = [
  { name: "Prometheus", icon: siPrometheus },
  { name: "ClickHouse", icon: siClickhouse },
  { name: "OpenTelemetry", icon: siOpentelemetry },
  { name: "Grafana dashboards", icon: siGrafana },
  { name: "Claude Code", icon: siClaude },
  { name: "Cursor", icon: siCursor },
  { name: "OIDC", icon: siOpenid },
]
---

<section class="wrap logos">
  <div class="row" data-reveal>
    <span class="hint">Works with what you run</span>
    <ul>
      {
        items.map(({ name, icon }) => (
          <li class="logo-word">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={icon.path} fill="currentColor" />
            </svg>
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logos {
    padding-top: 72px;
    padding-bottom: 16px;
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .row .hint {
    font-size: 15px;
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 36px;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.15s;
  }

  li:hover {
    color: var(--fg);
  }

  svg {
    height: 20px;
    width: 20px;
    flex: none;
  }

  @media (min-width: 1280px) {
    ul {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
  }

  @media (max-width: 860px) {
    .logos {
      padding-top: 48px;
      padding-bottom: 8px;
    }

    ul {
      gap: 12px 24px;
    }

    li {
      font-size: 15px;
    }

    svg {
      height: 18px;
      width: 18px;
    }
  }
</style>
