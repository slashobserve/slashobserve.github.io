---
import {
  siClaude,
  siClickhouse,
  siCursor,
  siGrafana,
  siOpenid,
  siOpentelemetry,
  siPrometheus,
} from "simple-icons"

const items = [
  { name: "Prometheus", icon: siPrometheus },
  { name: "ClickHouse", icon: siClickhouse },
  { name: "OpenTelemetry", icon: siOpentelemetry },
  { name: "Grafana dashboards", icon: siGrafana },
  { name: "Claude Code", icon: siClaude },
  { name: "Cursor", icon: siCursor },
  { name: "OIDC", icon: siOpenid },
]
---

<section class="band">
  <div class="wrap row">
    <span class="hint">Works with what you run</span>
    <ul>
      {
        items.map(({ name, icon }) => (
          <li class="logo-word">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={icon.path} fill="currentColor" />
            </svg>
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  ul {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.15s;
  }

  li:hover {
    color: var(--fg);
  }

  svg {
    height: 20px;
    width: 20px;
    flex: none;
  }
</style>
