---
const names = [
  "Prometheus",
  "ClickHouse",
  "OpenTelemetry",
  "Grafana dashboards",
  "Claude Code",
  "Cursor",
  "OIDC",
]
---

<section class="band">
  <div class="wrap row">
    <span class="hint">Works with what you run</span>
    <ul>
      {names.map((name) => <li class="logo-word">{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  ul {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
