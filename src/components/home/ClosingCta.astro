---
import type { DocLinks } from "../../lib/doc-links"
import Finale from "../site/Finale.astro"

interface Props {
  links: DocLinks
}

const { links } = Astro.props
---

<Finale>
  <h2 class="h2">Your next dashboard is one sentence away.</h2>
  <p>
    Run the demo on your laptop with Docker and an LLM key, or import a Grafana dashboard you
    already have.
  </p>
  <div class="actions">
    {
      links.quickStart && (
        <a class="btn btn-primary" href={links.quickStart}>
          Run the demo
        </a>
      )
    }
    {
      links.importGuide && (
        <a class="btn" href={links.importGuide}>
          Import from Grafana
        </a>
      )
    }
  </div>
</Finale>

<style>
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }
  }
</style>
