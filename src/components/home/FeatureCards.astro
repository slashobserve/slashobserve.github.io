---
import { dataPanelTypeCount, readSyncedSchema } from "../../lib/schema-facts"

const panelTypes = `${dataPanelTypeCount(readSyncedSchema())} panel types`
const exampleQuery = 'rate(http_requests_total{pod=~"$pod"}[$__rate_interval])'
const tiles = Array.from({ length: 8 }, (_, index) => index === 3)
---

<section class="wrap pad-sm section">
  <div class="heading">
    <h2 class="h2">Everything you need to replace your Grafana.</h2>
    <p class="lead">
      The panels, variables and field options teams rely on, drawn by a renderer built for reading
      under pressure.
    </p>
  </div>
  <div class="cards g1-sm">
    <figure class="card">
      <div class="art tiles" aria-hidden="true">
        {tiles.map((active) => <span class:list={["tile", { active }]}></span>)}
      </div>
      <figcaption>
        <h3>{panelTypes}</h3>
        <p>
          Time series, stat, gauge, table, heatmap, logs, state timeline and more, with rows and
          repeats.
        </p>
      </figcaption>
    </figure>
    <figure class="card">
      <div class="art variables" aria-hidden="true">
        <div class="chips">
          <span class="chip">pod: <b>All</b></span>
          <span class="chip">route: /checkout</span>
          <span class="chip">interval: 5m</span>
        </div>
        <div class="mono query">{exampleQuery}</div>
      </div>
      <figcaption>
        <h3>Variables and multi-query panels</h3>
        <p>
          Query, custom, interval, textbox, datasource and ad hoc variables. Several PromQL or SQL
          queries per panel.
        </p>
      </figcaption>
    </figure>
    <figure class="card">
      <div class="art thresholds" aria-hidden="true">
        <div class="row">
          <span>&lt; 250 ms</span>
          <span class="status"><span class="dot ok"></span>OK</span>
        </div>
        <div class="row">
          <span>250 to 500 ms</span>
          <span class="status"><span class="dot warn"></span>Warning</span>
        </div>
        <div class="row">
          <span>&gt; 500 ms</span>
          <span class="status"><span class="dot crit"></span>Critical</span>
        </div>
      </div>
      <figcaption>
        <h3>Thresholds, mappings, overrides</h3>
        <p>
          Units, decimals, value mappings, links and per-series overrides, the way Grafana users
          expect.
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .section {
    padding-top: 128px;
    padding-bottom: 128px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  figure {
    margin: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .art {
    height: 150px;
    background: var(--muted-bg);
    border-bottom: 1px solid var(--border);
    padding: 18px;
    box-sizing: border-box;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-content: center;
  }

  .tile {
    height: 40px;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .tile.active {
    background: var(--brand-muted);
    box-shadow: inset 0 0 0 1px var(--brand);
  }

  .variables {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  b {
    font-weight: 600;
  }

  .query {
    font-size: 11px;
    color: var(--mfg);
    background: var(--surface);
    border-radius: 6px;
    padding: 8px 10px;
    box-shadow: inset 0 0 0 1px var(--border);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .thresholds {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    font-size: 12px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    background: var(--surface);
    border-radius: 6px;
    padding: 7px 10px;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .status {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .ok {
    background: var(--ok);
  }

  .warn {
    background: var(--warn);
  }

  .crit {
    background: var(--crit);
  }

  figcaption {
    padding: 20px;
  }

  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  figcaption p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--mfg);
  }
</style>
