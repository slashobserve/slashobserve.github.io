---
import { AGENTS_PATH, DASHBOARDS_PATH, OBSERVATIONS_PATH, SIGNALS_PATH } from "../../lib/site-nav"
import { railItems, tourTitle } from "../../lib/tour"
import AgentsScreen from "../product/AgentsScreen.astro"
import DashboardActivity from "../product/DashboardActivity.astro"
import InboxScreen from "../product/InboxScreen.astro"
import LogsSource from "../product/LogsSource.astro"
import MessageToBlock from "../product/MessageToBlock.astro"
import PublishRca from "../product/PublishRca.astro"
import TraceCard from "../product/TraceCard.astro"
import Section from "../site/Section.astro"
import SectionHead from "../site/SectionHead.astro"
import Stage from "../site/Stage.astro"

const stops = [
  {
    id: "inbox",
    place: "Inbox",
    title: "Start from what needs you.",
    text: "The Inbox keeps what asks something of you in one list: a proposal to merge, a block to keep, a mention, a reply, a failed run or a repair the agent saved. Each item shows why it is there, and the unread count follows you across browsers. It is the page the app opens on.",
    href: null,
    arrow: null,
  },
  {
    id: "observations",
    place: "Observations",
    title: "An investigation is a page, not a chat log.",
    text: "Text, panels, logs and snapshots are blocks on the page, and the discussion beside it holds messages until someone adds one to the page. Publish as RCA freezes the page into a numbered revision, and a person can share that revision read-only with a public link.",
    href: OBSERVATIONS_PATH,
    arrow: "Observations",
  },
  {
    id: "dashboards",
    place: "Dashboards",
    title: "Ask for a dashboard. Get one that works.",
    text: "The agent takes an inventory of the metric families in scope, runs each panel it adds or changes before the save, and ends with a version and a link. Comments, agent requests and saved versions share one Activity pane on the dashboard.",
    href: DASHBOARDS_PATH,
    arrow: "Dashboards",
  },
  {
    id: "logs-and-traces",
    place: "Logs and traces",
    title: "Search in the language each store speaks.",
    text: "Pick a datasource on the logs page and search it in its own language: LogQL on Loki, SQL on ClickHouse, KQL on Elasticsearch and OpenSearch. Traces on Tempo take TraceQL. A log line that carries a trace id opens that trace.",
    href: SIGNALS_PATH,
    arrow: "Signals",
  },
  {
    id: "agents",
    place: "Agents",
    title: "Your agents work here too.",
    text: "Observe Agent is built in and runs on the model you configure. Claude Code and other MCP clients connect as named agents, each set to save directly or to propose.",
    href: AGENTS_PATH,
    arrow: "Agents",
  },
]

const items = railItems(stops)
---

<Section>
  <SectionHead title={tourTitle(stops.length)} lead="Each stop is a place in the app's sidebar, drawn from the demo data." />
  <div class="tour">
    <nav class="rail" aria-label="Tour" data-tour-rail>
      <span class="rail-label">In the app</span>
      {
        items.map(({ id, label, href }, index) => (
          <a class="item" href={href} data-tour-item={id} aria-current={index === 0 ? "location" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="stops">
      {
        stops.map(({ id, place, title, text, href, arrow }) => (
          <article class="stop" id={id} data-tour-stop>
            <div class="stop-head">
              <div class="stop-title">
                <span class="place k">{place}</span>
                <h3 class="h3">{title}</h3>
              </div>
              <div class="stop-text">
                <p class="p">{text}</p>
                {href && arrow && (
                  <a class="arrow" href={href}>
                    {arrow} →
                  </a>
                )}
              </div>
            </div>
            <div data-in-view="rise">
              <Stage>
                {id === "inbox" && <InboxScreen />}
                {id === "observations" && (
                  <div class="pair pair-top">
                    <MessageToBlock />
                    <PublishRca />
                  </div>
                )}
                {id === "dashboards" && <DashboardActivity />}
                {id === "logs-and-traces" && (
                  <div class="pair">
                    <LogsSource />
                    <TraceCard />
                  </div>
                )}
                {id === "agents" && <AgentsScreen />}
              </Stage>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .tour {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .rail {
    position: sticky;
    top: 88px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--chrome);
    font-size: 14px;
  }

  .rail-label {
    padding: 6px 8px 8px;
    color: var(--mfg);
    font-size: 12px;
  }

  .item {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 34px;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--mfg);
    text-decoration: none;
    white-space: nowrap;
  }

  .item:hover {
    color: var(--fg);
  }

  .item[aria-current] {
    border-color: var(--border);
    background: var(--card);
    color: var(--fg);
    font-weight: 500;
  }

  .stops {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 48px 0;
    border-top: 1px solid var(--border);
    min-width: 0;
  }

  .stop:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px;
    align-items: start;
  }

  .stop-title,
  .stop-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stop-title {
    gap: 10px;
  }

  .stop-text {
    gap: 12px;
    align-items: flex-start;
  }

  .place {
    font-size: 13.5px;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pair-top {
    align-items: start;
  }

  @media (max-width: 900px) {
    .tour {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .rail {
      top: 57px;
      z-index: 5;
      flex-direction: row;
      overflow-x: auto;
      padding: 6px;
    }

    .rail-label {
      display: none;
    }

    .item {
      flex: none;
      height: 44px;
      padding: 0 12px;
    }

    .stop {
      gap: 20px;
      padding: 40px 0;
      scroll-margin-top: 56px;
    }

    .stop-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { watchInView } from "../../lib/client/in-view"
  import { activeStop } from "../../lib/tour"

  const READING_LINE = 0.4
  const CURRENT = "location"

  const rail = document.querySelector<HTMLElement>("[data-tour-rail]")
  const items = [...document.querySelectorAll<HTMLAnchorElement>("[data-tour-item]")]
  const stops = [...document.querySelectorAll<HTMLElement>("[data-tour-stop]")]

  if (rail && items.length === stops.length && stops.length > 0) {
    watchInView()

    let shown = 0
    let queued = false

    const show = (index: number) => {
      if (index === shown) return
      shown = index
      items.forEach((item, position) => {
        if (position === index) item.setAttribute("aria-current", CURRENT)
        else item.removeAttribute("aria-current")
      })
      const item = items[index]
      if (rail.scrollWidth > rail.clientWidth) {
        rail.scrollLeft = item.offsetLeft - (rail.clientWidth - item.offsetWidth) / 2
      }
    }

    const update = () => {
      queued = false
      const line = window.innerHeight * READING_LINE
      show(activeStop(stops.map((stop) => stop.getBoundingClientRect().top), line))
    }

    const schedule = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    items.forEach((item, index) => {
      item.addEventListener("click", (event) => {
        event.preventDefault()
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
        stops[index].scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" })
        history.replaceState(null, "", item.hash)
        show(index)
      })
    })

    addEventListener("scroll", schedule, { passive: true })
    addEventListener("resize", schedule)
    update()
  }
</script>
