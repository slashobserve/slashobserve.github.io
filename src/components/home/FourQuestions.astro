---
const questions = [
  {
    title: "Does every panel work?",
    text: "The agent reads your metric and label names, lints each query and runs it. Nothing is saved until every panel returns data.",
    paths: ["M20 6 9 17l-5-5"],
    circle: null,
  },
  {
    title: "What changed, and who changed it?",
    text: "Every save is a version, by a person or the agent. Compare any two and restore one.",
    paths: ["M12 8v4l3 2"],
    circle: { cx: 12, cy: 12, r: 9 },
  },
  {
    title: "Where does feedback go?",
    text: "Comment on a panel or the whole dashboard. Send a comment to the agent and it comes back as the next version.",
    paths: ["M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"],
    circle: null,
  },
  {
    title: "Who can see it and change it?",
    text: "Admin, editor, commenter and viewer roles from your OIDC groups, folders, and share links. The agent can only change what the person asking can.",
    paths: ["M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5A6.5 6.5 0 0 1 21.5 20"],
    circle: { cx: 9, cy: 8, r: 3.5 },
  },
]
---

<section class="band">
  <div class="wrap g1-sm pad-sm grid">
    <div class="heading">
      <h2 class="h2">More than a chart from a prompt.</h2>
      <p class="lead">
        A team running production needs four answers about every dashboard. SlashObserve keeps them
        in one place.
      </p>
    </div>
    <ul class="items">
      {
        questions.map((question) => (
          <li class="item">
            <span class="ichip">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {question.circle && <circle {...question.circle} />}
                {question.paths.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </span>
            <div>
              <h3>{question.title}</h3>
              <p>{question.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--muted-bg);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 80px;
    padding-top: 128px;
    padding-bottom: 128px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: start;
  }

  @media (min-width: 861px) {
    .heading {
      position: sticky;
      top: 32px;
    }
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 44px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
  }

  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin: 6px 0 0;
    color: var(--mfg);
  }
</style>
