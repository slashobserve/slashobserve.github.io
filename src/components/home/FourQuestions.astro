---
const questions = [
  {
    title: "Does every panel work?",
    text: "The agent reads your metric and label names, lints each query and runs it. Nothing is saved until every panel returns data.",
    paths: ["M20 6 9 17l-5-5"],
    circle: null,
  },
  {
    title: "What changed, and who changed it?",
    text: "Every save is a version, by a person or the agent. Compare any two and restore one.",
    paths: ["M12 8v4l3 2"],
    circle: { cx: 12, cy: 12, r: 9 },
  },
  {
    title: "Where does feedback go?",
    text: "Comment on a panel or the whole dashboard. Send a comment to the agent and it comes back as the next version.",
    paths: ["M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"],
    circle: null,
  },
  {
    title: "Who can see it and change it?",
    text: "Admin, editor, commenter and viewer roles from your OIDC groups, folders, and share links. The agent can only change what the person asking can.",
    paths: ["M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5A6.5 6.5 0 0 1 21.5 20"],
    circle: { cx: 9, cy: 8, r: 3.5 },
  },
]
---

<section class="wrap section-y block">
  <div class="statement" data-reveal>
    <h2 class="h2">More than a chart from a prompt.</h2>{" "}
    <p class="lead">
      A team running production needs four answers about every dashboard. SlashObserve keeps them in
      one place.
    </p>
  </div>
  <ul class="items" data-reveal>
    {
      questions.map((question) => (
        <li class="item">
          <span class="ichip">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {question.circle && <circle {...question.circle} />}
              {question.paths.map((d) => (
                <path d={d} />
              ))}
            </svg>
          </span>
          <div>
            <h3>{question.title}</h3>
            <p>{question.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .statement {
    max-width: 920px;
  }

  .statement .h2,
  .statement .lead {
    display: inline;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .statement .h2 {
    font-weight: 600;
    color: var(--fg);
  }

  .statement .lead {
    font-weight: 500;
    color: var(--mfg);
    max-width: none;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  .item {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .item:nth-child(odd) {
    border-right: 1px solid var(--border);
  }

  .item:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .item p {
    margin: 6px 0 0;
    color: var(--mfg);
  }

  @media (max-width: 1023px) {
    .statement .h2,
    .statement .lead {
      font-size: 34px;
    }
  }

  @media (max-width: 860px) {
    .block {
      gap: 40px;
    }

    .statement .h2,
    .statement .lead {
      font-size: 26px;
      line-height: 1.2;
    }

    .items {
      grid-template-columns: minmax(0, 1fr);
    }

    .item {
      padding: 24px;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .item:nth-child(odd) {
      border-right: 0;
    }

    .item:last-child {
      border-bottom: 0;
    }
  }
</style>
