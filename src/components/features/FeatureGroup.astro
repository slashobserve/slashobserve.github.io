---
import type { FeatureGroup } from "../../lib/features"
import FeatureItem from "./FeatureItem.astro"

interface Props {
  group: FeatureGroup
  id: string
}

const { group, id } = Astro.props
---

<section class="group" aria-labelledby={id} data-reveal>
  <h2 id={id}>{group.title}</h2>
  <div class="items">
    {group.items.map((feature) => <FeatureItem feature={feature} />)}
  </div>
</section>

<style>
  .group {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 64px;
    padding: 64px 0;
  }

  h2 {
    margin: 0;
    font-size: 32px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
    position: sticky;
    top: 96px;
    align-self: start;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .items > :global(.item:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1023px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    h2 {
      position: static;
    }
  }

  @media (max-width: 860px) {
    .group {
      padding: 40px 0;
    }

    h2 {
      font-size: 26px;
    }

    .items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
