---
import type { FeatureGroup } from "../../lib/features"
import FeatureItem from "./FeatureItem.astro"

interface Props {
  group: FeatureGroup
  id: string
}

const { group, id } = Astro.props
---

<section class="group" aria-labelledby={id}>
  <h2 id={id}>{group.title}</h2>
  <div class="items">
    {group.items.map((feature) => <FeatureItem feature={feature} />)}
  </div>
</section>

<style>
  .group {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 40px;
    padding: 40px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 860px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
