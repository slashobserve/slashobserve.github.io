---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"dialog"> {}

const { class: className, "data-slot": slot = "dialog", ...attrs } = Astro.props;
---

<dialog
  data-slot={slot}
  data-dialog
  class={cn("dialog fixed inset-0 z-50 m-0 h-full w-full max-h-full max-w-full bg-transparent p-0", className)}
  {...attrs}
>
  <slot />
</dialog>

<style>
  .dialog::backdrop {
    background: color-mix(in oklab, var(--ink-bg) 40%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dialog[open]::backdrop {
      animation: dialog-backdrop-in 150ms ease-out;
    }
  }

  @keyframes dialog-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import "./dialog.client";
</script>
