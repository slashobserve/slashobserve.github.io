---
import Icon from "@/components/ui/icon/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import type { MarkdownHeading } from "astro";

interface Props extends HTMLAttributes<"nav"> {
  headings: MarkdownHeading[];
}

const { headings, class: className, ...attrs } = Astro.props;

const hasHeadings = headings.length > 0;
const NBSP = " ";
---

{
  hasHeadings && (
    <nav
      data-slot="mobile-toc"
      data-nb-mobile-toc
      aria-label="On this page"
      class={cn(
        "relative flex h-11 items-center gap-3 rounded-md [-webkit-tap-highlight-color:transparent] has-[select:focus-visible]:outline-2 has-[select:focus-visible]:outline-offset-0 has-[select:focus-visible]:outline-[var(--brand)]",
        className,
      )}
      {...attrs}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="pointer-events-none h-4 w-4 flex-none text-[var(--mfg)]"
      >
        <path d="M2.5 4h11M2.5 8h11M2.5 12h7" />
      </svg>
      <span
        data-nb-mobile-toc-label
        data-muted
        aria-hidden="true"
        class="pointer-events-none min-w-0 flex-1 truncate text-sm leading-5 font-medium text-[var(--fg)] data-[muted]:text-[var(--mfg)]"
      >
        On this page
      </span>
      <Icon
        name="caret-down"
        aria-hidden="true"
        class="pointer-events-none h-4 w-4 flex-none text-[var(--mfg)]"
      />
      <select
        data-nb-mobile-toc-select
        aria-label="Jump to a section on this page"
        class="absolute inset-0 h-full w-full cursor-pointer appearance-none opacity-0 text-base"
      >
        <option value="_top">On this page</option>
        {headings.filter((heading) => heading.slug).map((heading) => (
          <option value={heading.slug}>
            {`${NBSP.repeat(Math.max(0, heading.depth - 2) * 2)}${heading.text}`}
          </option>
        ))}
      </select>
    </nav>
  )
}

<script>
  import "./mobile-toc.client";
</script>
