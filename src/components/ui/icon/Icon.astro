---
import type { HTMLAttributes } from "astro/types"

const PATHS = {
  "magnifying-glass":
    "m229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32M40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72",
  "caret-down":
    "m213.66 101.66l-80 80a8 8 0 0 1-11.32 0l-80-80a8 8 0 0 1 11.32-11.32L128 164.69l74.34-74.35a8 8 0 0 1 11.32 11.32",
} as const

interface Props extends HTMLAttributes<"svg"> {
  name: keyof typeof PATHS
}

const { name, ...attrs } = Astro.props
---

<svg width="1em" height="1em" viewBox="0 0 256 256" {...attrs} data-icon={`ph:${name}`}>
  <path fill="currentColor" d={PATHS[name]}></path>
</svg>
