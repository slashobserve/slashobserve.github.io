---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"a"> {
  label: string
  href: string
  isCurrent?: boolean
}

const { label, href, isCurrent, class: className, ...attrs } = Astro.props
---

<a href={href} aria-current={isCurrent ? "page" : undefined} class={className} {...attrs}>{label}</a>
