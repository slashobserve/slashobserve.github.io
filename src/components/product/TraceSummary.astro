---
import Window from "./Window.astro"
import { TRACE_ID } from "./screen-ids"
import { ROOT, SELECTED_SPAN, SPANS, TRACE_START } from "./trace"

const ATTRIBUTES_SHOWN = 3
---

<Window url={`/t/${TRACE_ID}?ds=tempo`} label="A trace">
  <div class="card-head">
    <span class="label">{ROOT.service} {ROOT.operation}</span>
    <span class="row k meta"><span>{TRACE_START}</span><span>{ROOT.duration}</span></span>
  </div>
  <div class="trace-body">
    {
      SPANS.map(({ service, operation, depth, tone, width, offset, error, selected }) => (
        <>
          <div class:list={["span-row", { selected }]}>
            <span class="name" style={`padding-left:${depth * 8}px`}>
              <span class="op">
                <span class="k">{service}</span> {operation}
              </span>
              {error && <span class="dot tone-crit" />}
            </span>
            <span class="track">
              <span class={`span-bar tone-${tone}`} style={`width:${width}%;margin-left:${offset}%`} />
            </span>
          </div>
          {selected && (
            <div class="attrs">
              {SELECTED_SPAN.attributes.slice(0, ATTRIBUTES_SHOWN).map(([key, value]) => (
                <>
                  <span class="k">{key}</span>
                  <span class="mono">{value}</span>
                </>
              ))}
            </div>
          )}
        </>
      ))
    }
  </div>
</Window>

<style>
  .card-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px 8px;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    gap: 10px;
    font-size: 11px;
  }

  .trace-body {
    font-size: 11.5px;
  }

  .span-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    align-items: center;
    min-height: 24px;
    border-bottom: 1px solid var(--border);
  }

  .selected {
    background: var(--sel);
  }

  .name {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-left: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .op {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track {
    padding: 0 10px;
    min-width: 0;
  }

  .span-bar {
    display: block;
    height: 9px;
    border-radius: 5px;
    background: var(--tone);
  }

  .attrs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }

  .attrs .mono {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
