---
import Mark from "./Mark.astro"

const arrow = '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>'
---

<div class="answer-to-block" role="group" aria-label="An agent answer added to the page as a text block">
  <div class="msg">
    <Mark kind="agent" size={24} />
    <div class="msg-body">
      <div class="msg-head"><b>Observe Agent for admin</b><span class="k">17:03</span></div>
      <p>
        Yes. 94% of the 5xx on /api/checkout carry <code>payments: context deadline exceeded</code>, and they start 3
        minutes after the rollout.
      </p>
      <span class="btn btn-sm add">Add to page</span>
    </div>
  </div>
  <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
  <div class="block">
    <p>
      Yes. 94% of the 5xx on /api/checkout carry <code>payments: context deadline exceeded</code>, and they start 3
      minutes after the rollout.
    </p>
    <div class="foot">
      <span class="byline"><Mark kind="agent" size={20} />From Observe Agent, added by admin</span>
    </div>
  </div>
</div>

<style>
  .answer-to-block {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.45;
  }

  .msg {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  .msg-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .msg-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 8px;
  }

  .msg-head b {
    font-weight: 600;
  }

  .msg-head .k {
    font-size: 12px;
  }

  p {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .add {
    align-self: flex-start;
    min-height: 28px;
    margin-left: -8px;
    padding: 0 8px;
    border-color: transparent;
    background: transparent;
    color: var(--mfg);
    font-size: 12.5px;
  }

  .arrow {
    align-self: center;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--mfg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px 2px 0;
  }

  .block p {
    font-size: 14px;
  }

  .foot {
    display: flex;
    justify-content: flex-end;
    color: var(--mfg);
    font-size: 12px;
  }

  .byline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
</style>
