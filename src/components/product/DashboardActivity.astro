---
import Mark from "./Mark.astro"
import Panel from "./Panel.astro"
import TimeSeries from "./TimeSeries.astro"
import Window from "./Window.astro"

const routes = [
  { name: "/checkout", tone: "s1", d: "M0 52 C30 48 60 40 100 44 S160 56 200 40 S260 26 300 32" },
  { name: "/cart", tone: "s3", d: "M0 62 C40 60 70 56 100 58 S170 66 200 60 S260 54 300 56" },
  { name: "/product/{id}", tone: "s2", d: "M0 36 C40 40 70 30 110 26 S170 22 200 32 S260 40 300 34" },
] as const

interface Props {
  onStage?: boolean
}

const { onStage = false } = Astro.props
---

<Window {onStage} label="A dashboard with its activity">
  <div class="dash">
    <div class="top">
      <span class="crumbs">
        <span class="k">Dashboards</span>
        <span class="k" aria-hidden="true">/</span>
        <span class="k">Demo</span>
        <span class="k" aria-hidden="true">/</span>
        <span class="current">Demo shop overview</span>
        <span class="version"><i class="dot tone-ok" />Live · v2 <span class="k" aria-hidden="true">▾</span></span>
      </span>
      <span class="controls">
        <span class="control">Last 1 hour</span>
        <span class="control">30s</span>
      </span>
    </div>
    <div class="body">
      <div class="main">
        <div class="stats">
          <Panel title="Requests per second">
            <span class="pv">412<span class="k unit"> req/s</span></span>
          </Panel>
          <Panel title="Server errors">
            <span class="pv fg-crit">2.1%</span>
          </Panel>
        </div>
        <Panel title="Requests per second by route">
          <TimeSeries
            viewBox="0 0 300 80"
            height="96px"
            yTicks={["600 req/s", "300 req/s", "0 req/s"]}
            xTicks={["13:05", "13:35", "14:05"]}
            series={[...routes]}
          />
        </Panel>
      </div>
      <aside class="pane" aria-label="Activity">
        <div class="pane-head">
          <span class="heading">Activity</span>
          <span class="k">Comments, agent requests and saved versions.</span>
        </div>
        <div class="filters">
          <span class="k">Show</span>
          <span class="select">Everything <span class="k" aria-hidden="true">▾</span></span>
          <span class="k">Panel</span>
          <span class="select">All panels <span class="k" aria-hidden="true">▾</span></span>
        </div>
        <ol class="entries">
          <li class="entry">
            <Mark kind="person" initials="A" tint={1} size={23} />
            <div class="content">
              <p class="line"><span class="who">admin</span><span class="k verb">commented</span><span class="k when">Last week</span></p>
              <p class="text">Show the pool limit as a line so we can see how close we get to 50.</p>
              <p class="meta">
                <span class="k">Open</span>
                <span class="action">Reply</span>
                <span class="action">Resolve</span>
              </p>
            </div>
          </li>
          <li class="entry">
            <Mark kind="person" initials="A" tint={1} size={23} />
            <div class="content">
              <p class="line">
                <span class="who">admin</span><span class="k verb">asked the agent on</span><span class="panel-name"
                  >Pool connections in use by pod</span
                ><span class="k when">Yesterday</span>
              </p>
              <p class="text">Add the pool limit as a line.</p>
              <p class="meta"><span class="saved"><span class="fg-ok" aria-hidden="true">✓</span>Saved as version 2</span></p>
            </div>
          </li>
          <li class="entry">
            <Mark kind="agent" size={23} />
            <div class="content">
              <p class="line"><span class="who">Observe Agent for admin</span><span class="k verb">saved</span><span class="k when">Yesterday</span></p>
              <div class="version-box">
                <span>
                  <span class="version-name">Version 2</span>
                  <span class="k block">Add the pool limit to Pool connections in use by pod.</span>
                </span>
                <span class="k see">See changes</span>
              </div>
            </div>
          </li>
        </ol>
        <div class="composer">
          <span class="k placeholder">Write a comment, or tell the agent what to change</span>
          <span class="on-row"><span class="k">On</span><span class="select">The whole dashboard <span class="k" aria-hidden="true">▾</span></span></span>
        </div>
      </aside>
    </div>
  </div>
</Window>

<style>
  .dash {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    min-width: 0;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12.5px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .current {
    font-weight: 500;
  }

  .version {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mfg);
    font-size: 12px;
  }

  .controls {
    display: flex;
    gap: 6px;
  }

  .control,
  .select {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    white-space: nowrap;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 14px 16px;
    background: var(--canvas);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .unit {
    font-size: 12px;
    font-weight: 400;
  }

  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-left: 1px solid var(--border);
  }

  .pane-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .heading {
    font-size: 13px;
    font-weight: 600;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
  }

  .entries {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 8px 16px;
    list-style: none;
  }

  .entry {
    display: flex;
    gap: 10px;
    padding: 6px 0;
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 2px;
  }

  .content p {
    margin: 0;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
  }

  .who {
    font-weight: 500;
  }

  .panel-name {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .when {
    margin-left: auto;
    padding-left: 8px;
    font-variant-numeric: tabular-nums;
  }

  .text {
    font-size: 12.5px;
    line-height: 1.5;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
  }

  .action {
    color: var(--mfg);
  }

  .saved {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .version-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--muted);
  }

  .version-name {
    display: block;
    font-weight: 500;
  }

  .block {
    display: block;
  }

  .see {
    flex: none;
  }

  .composer {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 8px 16px 16px;
    padding: 10px 10px 8px 12px;
    border-radius: 10px;
    background: var(--muted);
  }

  .on-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .main {
      padding: 10px;
    }

    .pane {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
