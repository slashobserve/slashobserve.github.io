---
import AnswerCard from "./AnswerCard.astro"
import Mark from "./Mark.astro"
import Mention from "./Mention.astro"
import Panel from "./Panel.astro"
import TimeSeries from "./TimeSeries.astro"
import Window from "./Window.astro"

const routes = [
  { name: "/checkout", tone: "s1", d: "M0 52 C30 48 60 40 100 44 S160 56 200 40 S260 26 300 32" },
  { name: "/cart", tone: "s3", d: "M0 62 C40 60 70 56 100 58 S170 66 200 60 S260 54 300 56" },
  { name: "/product/{id}", tone: "s2", d: "M0 36 C40 40 70 30 110 26 S170 22 200 32 S260 40 300 34" },
] as const

const icons = {
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  timer: '<path d="M10 2h4"/><path d="M12 14l3-3"/><circle cx="12" cy="14" r="8"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98"/><path d="m15.41 6.51-6.82 3.98"/>',
  activity: '<path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  mention: '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>',
  send: '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>',
}
---

<Window label="A dashboard with its activity">
  <div class="dash">
    <div class="top">
      <span class="crumbs">
        <span class="k">Dashboards</span>
        <span class="k" aria-hidden="true">/</span>
        <span class="k">Demo</span>
        <span class="k" aria-hidden="true">/</span>
        <span class="current">Demo shop overview</span>
        <span class="k views">12 views in 30 days</span>
        <span class="version"><i class="dot tone-ok" />Live · v2<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} /></span>
      </span>
      <span class="toolbar">
        <span class="control"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.plus} />Add annotation</span>
        <span class="control"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.clock} />Last 1 hour</span>
        <span class="control icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.refresh} /></span>
        <span class="control"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.timer} />1m</span>
        <span class="ghost"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.more} /></span>
        <span class="ghost"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.share} />Share</span>
        <span class="ghost pressed"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.activity} /></span>
      </span>
    </div>
    <div class="body">
      <div class="main">
        <div class="stats">
          <Panel title="Requests per second" datasource="prom">
            <span class="pv">412<span class="k unit"> req/s</span></span>
          </Panel>
          <Panel title="Server errors" datasource="prom">
            <span class="pv fg-crit">2.1<span class="unit"> %</span><span class="state">Critical</span></span>
          </Panel>
        </div>
        <span class="row-head"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} />Is traffic healthy?</span>
        <Panel title="Requests per second by route" datasource="prom">
          <TimeSeries
            viewBox="0 0 300 80"
            height="96px"
            yTicks={["600 req/s", "300 req/s", "0 req/s"]}
            xTicks={["13:05", "13:35", "14:05"]}
            series={[...routes]}
          />
        </Panel>
      </div>
      <aside class="pane" aria-label="Activity">
        <div class="pane-head">
          <span class="tabs" role="group" aria-label="Side panel">
            <span class="tab">Chat</span>
            <span class="tab active">Activity</span>
          </span>
          <svg class="k close" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.close} />
        </div>
        <div class="filters">
          <span class="k">Show</span>
          <span class="select">Everything<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} /></span>
          <span class="k">Panel</span>
          <span class="select">All panels<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} /></span>
        </div>
        <ol class="entries">
          <li class="day k">Yesterday</li>
          <li class="entry">
            <Mark kind="agent" size={23} />
            <div class="content">
              <p class="line"><span class="who">Observe Agent for admin</span><span class="k verb">saved</span><span class="k when">16:52</span></p>
              <div class="version-box">
                <span>
                  <span class="version-name">Version 2</span>
                  <span class="k block">Add the pool limit to Pool connections in use by pod.</span>
                </span>
                <span class="k see">See changes</span>
              </div>
            </div>
          </li>
          <li class="day k">Today</li>
          <li class="entry">
            <Mark kind="person" initials="AD" tint={1} size={23} />
            <div class="content">
              <p class="line">
                <span class="who">admin</span><span class="k verb">on</span><span class="panel-name">Pool connections in use by pod</span><span
                  class="k when">09:12</span
                >
              </p>
              <p class="text"><Mention /> why did two pods reach the limit at 13:40?</p>
              <div class="reply">
                <Mark kind="agent" size={20} />
                <div class="content">
                  <p class="line"><span class="who">Observe Agent for admin</span><span class="k when">09:13</span></p>
                  <p class="text">Answered.</p>
                  <p class="k run-link">View the run</p>
                  <AnswerCard
                    answer="checkout-7d9 and checkout-2f4 held their connections for up to 9s while calls to payments timed out, so both reached the limit of 50 at 13:41."
                    change="Add a panel of payments client timeouts by pod."
                  />
                </div>
              </div>
              <p class="meta">
                <span class="k">Open</span>
                <span class="action">Reply</span>
                <span class="action">Resolve</span>
              </p>
            </div>
          </li>
        </ol>
        <div class="composer-wrap">
          <div class="composer">
            <span class="chips"><span class="chip k">To: everyone here</span><span class="chip k">Visible to: everyone here</span></span>
            <span class="k placeholder">Write a comment, or type @ to ask the agent</span>
            <span class="on-row">
              <span class="k">On</span>
              <span class="select">The whole dashboard<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} /></span>
              <svg class="k at" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.mention} />
              <span class="send" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons.send} /></span>
            </span>
          </div>
          <span class="k foot">Enter to send, Shift+Enter for a new line.</span>
        </div>
      </aside>
    </div>
  </div>
</Window>

<style>
  .dash {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    min-width: 0;
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12.5px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .current {
    font-weight: 500;
  }

  .views {
    margin-left: 4px;
    font-size: 11.5px;
  }

  .version {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mfg);
    font-size: 12px;
  }

  svg {
    flex: none;
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .control,
  .select {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    white-space: nowrap;
  }

  .control.icon {
    padding: 0 5px;
  }

  .select svg {
    width: 11px;
    height: 11px;
    color: var(--mfg);
  }

  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 6px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .pressed {
    background: var(--muted);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 14px 16px;
    background: var(--canvas);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .unit {
    font-size: 12px;
    font-weight: 400;
  }

  .state {
    display: block;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .row-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 2px 0;
    font-size: 12.5px;
    font-weight: 600;
  }

  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-left: 1px solid var(--border);
  }

  .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px 9px 16px;
    border-bottom: 1px solid var(--border);
  }

  .tabs {
    display: flex;
    gap: 4px;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 11px;
    border-radius: 6px;
    color: var(--mfg);
    font-size: 12.5px;
    font-weight: 500;
  }

  .tab.active {
    background: var(--muted);
    color: var(--fg);
  }

  .close {
    width: 15px;
    height: 15px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
  }

  .entries {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 8px 16px;
    list-style: none;
  }

  .day {
    padding: 6px 0 2px;
    font-size: 11.5px;
  }

  .entry {
    display: flex;
    gap: 10px;
    padding: 6px 0;
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 2px;
  }

  .content p {
    margin: 0;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
  }

  .who {
    font-weight: 500;
  }

  .panel-name {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .when {
    margin-left: auto;
    padding-left: 8px;
    font-variant-numeric: tabular-nums;
  }

  .text {
    font-size: 12.5px;
    line-height: 1.5;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
  }

  .action {
    color: var(--mfg);
  }

  .reply {
    display: flex;
    gap: 8px;
    margin: 4px 0 2px;
  }

  .run-link {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .chips .chip {
    font-size: 11.5px;
  }

  .version-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--muted);
  }

  .version-name {
    display: block;
    font-weight: 500;
  }

  .block {
    display: block;
  }

  .see {
    flex: none;
  }

  .composer-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 16px 14px;
  }

  .composer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 4px;
    padding: 8px 8px 8px 10px;
    border-radius: 10px;
    background: var(--muted);
  }

  .on-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .at {
    width: 15px;
    height: 15px;
    margin-left: auto;
  }

  .send {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--primary);
    color: var(--pfg);
    opacity: 0.5;
  }

  .foot {
    font-size: 11.5px;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .main {
      padding: 10px;
    }

    .pane {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
