---
import Mark from "./Mark.astro"
import Panel from "./Panel.astro"
import TimeSeries from "./TimeSeries.astro"

const errorRatio = [
  {
    name: "/api/checkout",
    tone: "s1",
    d: "M0 112 L20 111 L40 113 L60 112 L80 111 L100 113 L120 112 L140 111 L160 112 L180 113 L196 110 L208 86 L220 58 L232 44 L246 42 L262 45 L280 40 L298 43 L316 41 L334 44 L352 40 L370 43 L386 41 L400 42",
  },
  {
    name: "/api/orders/{id}",
    tone: "s2",
    d: "M0 105 L24 106 L48 104 L72 106 L96 105 L120 103 L144 106 L168 104 L192 105 L216 107 L240 104 L264 105 L288 103 L312 106 L336 104 L360 105 L400 104",
  },
] as const

const latency = [
  {
    name: "/api/checkout",
    tone: "s1",
    d: "M0 40 L30 38 L60 41 L90 39 L120 40 L150 38 L180 41 L210 39 L240 40 L270 38 L300 41 L330 39 L360 40 L400 39",
  },
  {
    name: "/api/orders/{id}",
    tone: "s2",
    d: "M0 56 L30 55 L60 57 L90 55 L120 56 L150 54 L180 57 L210 55 L240 56 L270 54 L300 57 L330 55 L360 56 L400 55",
  },
] as const
---

<div class="blocks" role="group" aria-label="Observation blocks">
  <div class="text">
    <p>
      The 5xx on /api/checkout carry <code>payments: context deadline exceeded</code>, and they start 3 minutes after the
      rollout.
    </p>
    <div class="foot">
      <span class="byline"><Mark kind="agent" size={20} />From Observe Agent, added by admin</span>
    </div>
  </div>
  <div class="block">
    <Panel title="Server error ratio by route">
      <TimeSeries
        viewBox="0 0 400 120"
        height="96px"
        yTicks={["3%", "2%", "1%", "0%"]}
        xTicks={["16:10", "16:30", "16:50", "17:00"]}
        series={[...errorRatio]}
      />
    </Panel>
    <div class="foot">
      <span class="caption"><span class="dot" aria-hidden="true"></span>Prometheus, live</span>
      <span class="byline"><Mark kind="agent" size={20} />From Observe Agent</span>
    </div>
  </div>
  <div class="block">
    <Panel title="Snapshot">
      <TimeSeries
        viewBox="0 0 400 80"
        height="64px"
        yTicks={["300 ms", "150 ms", "0 s"]}
        xTicks={["16:30", "16:50", "17:05"]}
        series={[...latency]}
      />
    </Panel>
    <div class="foot">
      <span class="caption">Frozen, 2026-11-06 16:30 to 2026-11-06 17:05</span>
      <span class="byline"><Mark kind="person" initials="JP" tint={4} size={20} />Added by Jo Park</span>
    </div>
  </div>
</div>

<style>
  .blocks {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.45;
  }

  .text,
  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 0 2px;
    color: var(--mfg);
    font-size: 12px;
  }

  .caption,
  .byline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .byline {
    margin-left: auto;
    gap: 8px;
  }

  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }
</style>
