---
import Window from "./Window.astro"

type Level = "error" | "info" | "warn"

const LEVEL_CLASS: Record<Level, string> = { error: "fg-crit", info: "k", warn: "fg-warn" }

const lines: { time: string; level: Level; message: string; trace?: string }[] = [
  { time: "14:02:11", level: "error", message: "checkout-0 payment declined order=8812" },
  { time: "14:02:11", level: "info", message: "frontend-1 GET /cart 200 12ms" },
  { time: "14:02:10", level: "warn", message: "checkout-0 db pool near max 19/20" },
  { time: "14:02:09", level: "error", message: "checkout-0 upstream timeout 2.0s trace=", trace: "7f3a9c1e" },
  { time: "14:02:09", level: "info", message: "frontend-0 GET /product/41 200 8ms" },
  { time: "14:02:08", level: "info", message: "inventory-0 reserve ok sku=41 qty=1" },
  { time: "14:02:08", level: "error", message: "checkout-0 payment declined order=8809" },
]
---

<Window url={'/logs?ds=loki&q={app="checkout"}'}>
  <span slot="bar-end" class="row live"><span class="dot tone-ok"></span>live</span>
  <div class="logs-body">
    {
      lines.map(({ time, level, message, trace }) => (
        <div class:list={["logline", { picked: trace }]}>
          <span class="k">{time}</span>
          <span class={LEVEL_CLASS[level]}>{level}</span>
          <span>{message}{trace && <u class="trace">{trace}</u>}</span>
        </div>
      ))
    }
  </div>
</Window>

<style>
  .live {
    gap: 5px;
  }

  .logs-body {
    padding: 8px 0;
  }

  .picked {
    background: var(--surface);
    outline: 1px solid var(--border-strong);
    outline-offset: -1px;
  }

  .trace {
    color: var(--fg);
  }
</style>
