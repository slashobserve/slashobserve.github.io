---
import LevelIcon, { type Level } from "./LevelIcon.astro"
import Window from "./Window.astro"

const lines: { time: string; level: Level; message: string; picked?: boolean }[] = [
  { time: "14:02:11.204", level: "Error", message: "payment declined order=8812" },
  { time: "14:02:11.198", level: "Info", message: "GET /cart 200 12ms" },
  { time: "14:02:10.911", level: "Warning", message: "db pool near max 19/20" },
  { time: "14:02:09.540", level: "Error", message: "upstream timeout after=2.0s", picked: true },
  { time: "14:02:09.102", level: "Info", message: "GET /product/41 200 8ms" },
  { time: "14:02:08.990", level: "Info", message: "reserve ok sku=41 qty=1" },
  { time: "14:02:08.421", level: "Error", message: "payment declined order=8809" },
  { time: "14:02:08.106", level: "Info", message: "order processed order=8807" },
  { time: "14:02:07.873", level: "Info", message: "GET /cart 200 9ms" },
]
---

<Window url={'/logs?ds=loki&q={namespace="shop"}'} label="The logs page tailing">
  <div class="row tail-head">
    <span class="title">Logs</span>
    <span class="btn btn-sm on">Stop live tail</span>
  </div>
  <div class="logs-body">
    {
      lines.map(({ time, level, message, picked }) => (
        <div class:list={["line", { picked }]}>
          <span class="k">2026-11-06 {time}</span>
          <span class="row level">
            <LevelIcon level={level} />
            {level}
          </span>
          <span class="mono">{message}</span>
        </div>
      ))
    }
  </div>
</Window>

<style>
  .tail-head {
    justify-content: space-between;
    padding: 10px 12px 8px;
  }

  .title {
    font-size: 14px;
    font-weight: 600;
  }

  .on {
    min-height: 28px;
    font-size: 12px;
    background: var(--muted);
  }

  .logs-body {
    border-top: 1px solid var(--border);
  }

  .line {
    display: grid;
    grid-template-columns: 142px 58px minmax(0, 1fr);
    gap: 8px;
    padding: 4px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    white-space: nowrap;
  }

  .line > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .level {
    gap: 5px;
  }

  .picked {
    background: var(--accent-container);
  }
</style>
