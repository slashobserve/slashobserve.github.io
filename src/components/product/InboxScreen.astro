---
import Mark from "./Mark.astro"
import Window from "./Window.astro"

type Author =
  | { kind: "person"; initials: string; tint: 1 | 2 | 3 | 4 }
  | { kind: "agent" }
  | { kind: "connected"; initials: string }

interface Item {
  author: Author
  actor: string
  verb: string
  object: string
  reason?: string
  time: string
  unread?: boolean
  selected?: boolean
}

const TABS = ["For you", "Everything", "Proposals", "Mentions"]

const groups: { label: string; items: Item[] }[] = [
  {
    label: "Needs you",
    items: [
      {
        author: { kind: "person", initials: "SR", tint: 2 },
        actor: "Sam Rivera",
        verb: "proposed",
        object: "Add a latency row to Demo shop overview",
        reason: "Proposal",
        time: "1 h ago",
        unread: true,
      },
      {
        author: { kind: "person", initials: "JP", tint: 4 },
        actor: "Jo Park",
        verb: "mentioned you on",
        object: "a dashboard",
        reason: "Mention",
        time: "3 h ago",
        unread: true,
        selected: true,
      },
      {
        author: { kind: "agent" },
        actor: "Observe Agent for admin",
        verb: "repaired 2 panels on",
        object: "Demo shop overview",
        reason: "Repaired",
        time: "5 h ago",
      },
    ],
  },
  {
    label: "Workspace activity",
    items: [
      {
        author: { kind: "connected", initials: "CC" },
        actor: "admin (via Claude Code)",
        verb: "added a block to",
        object: "Checkout errors after the payments deploy",
        time: "Yesterday",
      },
    ],
  },
]

const selected = groups.flatMap(({ items }) => items).find((item) => item.selected)!
---

<div class="inbox">
  <Window label="The inbox">
    <div class="page">
      <div class="page-head">
        <span class="title">Inbox</span>
        <span class="button">Mark all read</span>
      </div>
      <div class="split">
        <div class="list">
          <div class="tabs" aria-hidden="true">
            {TABS.map((tab, index) => <span class:list={["tab", { on: index === 0 }]}>{tab}</span>)}
          </div>
          {
            groups.map(({ label, items }) => (
              <section class="group">
                <h3 class="group-label">{label}</h3>
                <ul>
                  {items.map(({ author, actor, verb, object, reason, time, unread, selected }) => (
                    <li class:list={["row-item", { selected }]}>
                      {author.kind === "agent" ? (
                        <Mark kind="agent" size={28} />
                      ) : (
                        <Mark kind={author.kind} initials={author.initials} tint={author.kind === "person" ? author.tint : undefined} size={28} />
                      )}
                      <span class="body">
                        <span class="sentence">
                          {actor} {verb} <b>{object}</b>
                        </span>
                        <span class="k meta">
                          {reason && <span class="reason">{reason}</span>}
                          {time}
                        </span>
                      </span>
                      {unread && <span class="unread" aria-hidden="true" />}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <section class="detail" aria-label="Selected item">
          <h3 class="detail-title">{selected.actor} {selected.verb} {selected.object}</h3>
          <p class="k meta">
            {selected.reason && <span class="reason">{selected.reason}</span>}
            {selected.time}
          </p>
          <span class="button">Open</span>
        </section>
      </div>
    </div>
  </Window>
</div>

<style>
  .inbox {
    max-width: 760px;
    margin: 0 auto;
    min-width: 0;
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 16px 14px;
    font-size: 13px;
  }

  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: stretch;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-right: 16px;
  }

  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .tab {
    padding: 6px 9px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--mfg);
    white-space: nowrap;
  }

  .tab.on {
    border-bottom-color: var(--fg);
    color: var(--fg);
    font-weight: 500;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .group-label {
    margin: 0;
    padding: 10px 10px 2px;
    color: var(--mfg);
    font-size: 12px;
    font-weight: 400;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 8px 10px;
    border-radius: 6px;
  }

  .selected {
    background: var(--accent-container);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .sentence {
    line-height: 1.35;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
  }

  .reason {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 6px;
    border-radius: 4px;
    background: var(--accent-container);
    color: var(--on-accent-container);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .selected .reason {
    background: var(--card);
  }

  .unread {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }

  .detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 4px 0 4px 20px;
    border-left: 1px solid var(--border);
  }

  .detail-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .page {
      padding: 12px;
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .list {
      padding-right: 0;
    }

    .detail {
      display: none;
    }
  }
</style>
