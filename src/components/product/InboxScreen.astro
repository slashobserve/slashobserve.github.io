---
import Mark from "./Mark.astro"

type Author =
  | { kind: "person"; initials: string; tint: 1 | 2 | 3 | 4 }
  | { kind: "agent" }
  | { kind: "connected"; initials: string }

interface Item {
  author: Author
  actor: string
  verb: string
  object: string
  reason?: string
  excerpt?: string
  time: string
  unread?: boolean
  selected?: boolean
}

const TABS = ["For you", "Everything", "Proposals", "Mentions"]
const FILTERS = ["Open", "Unread", "Done"]

const groups: { label: string; items: Item[] }[] = [
  {
    label: "Needs you",
    items: [
      {
        author: { kind: "person", initials: "SR", tint: 2 },
        actor: "Sam Rivera",
        verb: "proposed",
        object: "Add a latency row to Astronomy Shop overview",
        reason: "Proposal",
        time: "1 h ago",
        unread: true,
      },
      {
        author: { kind: "person", initials: "JP", tint: 4 },
        actor: "Jo Park",
        verb: "mentioned you on",
        object: "Astronomy Shop overview",
        reason: "Mention",
        excerpt: "@admin p95 on /api/checkout climbs after each deploy, can you look?",
        time: "3 h ago",
        unread: true,
        selected: true,
      },
      {
        author: { kind: "agent" },
        actor: "Observe Agent for admin",
        verb: "repaired 2 panels on",
        object: "Astronomy Shop overview",
        reason: "Repaired",
        time: "5 h ago",
      },
    ],
  },
  {
    label: "Workspace activity",
    items: [
      {
        author: { kind: "connected", initials: "CC" },
        actor: "admin (via Claude Code)",
        verb: "added a block to",
        object: "Checkout errors after the payments deploy",
        time: "Yesterday",
      },
    ],
  },
]

const selected = groups.flatMap(({ items }) => items).find((item) => item.selected)!
---

<div class="inbox" role="group" aria-label="The inbox">
  <div class="page">
    <div class="page-head">
      <span class="title">Inbox</span>
      <span class="button">Mark all read</span>
    </div>
    <div class="split">
      <div class="list">
        <div class="tabs" aria-hidden="true">
          {TABS.map((tab, index) => <span class:list={["tab", { on: index === 0 }]}>{tab}</span>)}
        </div>
        <div class="filters" aria-hidden="true">
          {FILTERS.map((filter, index) => <span class:list={["filter", { on: index === 0 }]}>{filter}</span>)}
          <span class="filter">Group by dashboard or observation</span>
        </div>
        {
          groups.map(({ label, items }) => (
            <section class="group">
              <h3 class="group-label">{label}</h3>
              <ul>
                {items.map(({ author, actor, verb, object, reason, excerpt, time, unread, selected }) => (
                  <li class:list={["row-item", { selected, unread }]}>
                    <span class="unread-dot" aria-hidden="true" />
                    {author.kind === "agent" ? (
                      <Mark kind="agent" size={24} />
                    ) : (
                      <Mark kind={author.kind} initials={author.initials} tint={author.kind === "person" ? author.tint : undefined} size={24} />
                    )}
                    <span class="body">
                      <span class="sentence">
                        {actor} {verb} <b>{object}</b>
                      </span>
                      {excerpt && <span class="k excerpt">{excerpt}</span>}
                      <span class="k meta">
                        {reason && <span class="reason">{reason}</span>}
                        {time}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <section class="detail" aria-label="Selected item">
        <h3 class="detail-title">{selected.actor} {selected.verb} {selected.object}</h3>
        <p class="k meta">
          {selected.reason && <span class="reason">{selected.reason}</span>}
          {selected.time}
        </p>
        {selected.excerpt && <p class="detail-text">{selected.excerpt}</p>}
        <span class="actions">
          <span class="button">Open</span>
          <span class="ghost">Mark as read</span>
          <span class="ghost">Mark done</span>
        </span>
      </section>
    </div>
  </div>
</div>

<style>
  .inbox {
    max-width: 760px;
    margin: 0 auto;
    min-width: 0;
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
  }

  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: start;
    gap: 12px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 12px;
    border-radius: 10px;
    background: var(--card);
  }

  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .tab {
    padding: 6px 9px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--mfg);
    white-space: nowrap;
  }

  .tab.on {
    border-bottom-color: var(--fg);
    color: var(--fg);
    font-weight: 500;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-top: 6px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .filter.on {
    background: var(--muted);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .group-label {
    margin: 0;
    padding: 10px 10px 2px;
    color: var(--mfg);
    font-size: 12px;
    font-weight: 400;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 56px;
    box-sizing: border-box;
    padding: 8px 10px;
    border-radius: 6px;
  }

  .selected {
    background: var(--accent-container);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .sentence {
    line-height: 1.35;
  }

  .unread .sentence {
    font-weight: 500;
  }

  .excerpt {
    font-size: 12px;
    line-height: 1.35;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
  }

  .reason {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 6px;
    border-radius: 4px;
    background: var(--accent-container);
    color: var(--on-accent-container);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .selected .reason {
    background: var(--card);
  }

  .unread-dot {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 8px;
    border-radius: 50%;
  }

  .unread .unread-dot {
    background: var(--primary);
  }

  .detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: 10px;
    background: var(--card);
  }

  .detail-text {
    margin: 0;
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .ghost {
    padding: 3px 8px;
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .detail-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .detail {
      display: none;
    }
  }
</style>
