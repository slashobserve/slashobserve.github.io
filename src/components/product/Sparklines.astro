---
type Tone = "s1" | "s2" | "s3" | "s4"

interface Props {
  viewBox: string
  series: { d: string; tone: Tone }[]
  height?: string
  class?: string
}

const { viewBox, series, height, class: className } = Astro.props
---

<svg
  viewBox={viewBox}
  preserveAspectRatio="none"
  aria-hidden="true"
  class:list={["spark", className]}
  style={height ? `height:${height}` : undefined}
>
  {series.map(({ d, tone }) => <path d={d} fill="none" stroke={`var(--${tone})`} stroke-width="1.5" />)}
</svg>

<style>
  .spark {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
