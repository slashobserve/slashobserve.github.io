---
const command = "claude mcp add --transport http slashobserve https://observe.example.com/mcp"
---

<section class="connect" aria-label="Connect an agent">
  <h3 class="title">Connect an agent</h3>
  <div class="body">
    <p class="client">Claude Code</p>
    <div class="snippet">
      <code class="mono command">{command}</code>
      <span class="copy" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg
        >
      </span>
    </div>
    <p class="k hint">Approve the connection in the browser window it opens.</p>
    <p class="row k waiting">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg
      >
      Waiting for Claude Code to connect
    </p>
  </div>
</section>

<style>
  .connect {
    border-radius: 10px;
    background: var(--card);
    font-size: 13px;
    line-height: 1.45;
    min-width: 0;
  }

  .title {
    margin: 0;
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    font-weight: 600;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .client {
    margin: 0;
    font-weight: 500;
  }

  .snippet {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    background: var(--muted);
  }

  .command {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    line-height: 1.6;
    word-break: break-all;
  }

  .copy {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
  }

  .hint {
    margin: 0;
    font-size: 12px;
  }

  .waiting {
    margin: 0;
    gap: 8px;
  }
</style>
