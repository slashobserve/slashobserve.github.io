---
import Window from "./Window.astro"

const steps = [
  "Saved panel 13: Errors by route (row Traffic)",
  "Moved 1 panel in the build (13 in all)",
  "Saved version 7 (3 rows, 13 panels)",
]
---

<Window url="/d/4f1c/checkout-health">
  <span slot="bar-end">version 7</span>
  <div class="chat-body">
    <div class="bubble ask">Add errors by route and pin the p95 panel on top.</div>
    {
      steps.map((step) => (
        <div class="act">
          <span class="dot tone-ok" />
          {step}
        </div>
      ))
    }
    <div class="bubble reply">
      Done. Errors by route reads from http_requests_total with status=~"5..", and p95 is now the first panel. Version 6
      is one click away if you want it back.
    </div>
  </div>
</Window>

<style>
  .chat-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 12.5px;
    min-height: 200px;
  }

  .bubble {
    max-width: 85%;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 10px;
  }

  .ask {
    align-self: flex-end;
  }

  .reply {
    color: var(--mfg);
  }
</style>
