---
import "./build-stage.css"
import BuildStage from "./BuildStage"

interface Props {
  space: "home" | "page"
}

const { space } = Astro.props
---

<section class="wrap playback" data-space={space}>
  <BuildStage client:visible />
  <p class="hint playback-caption">A build, played back.</p>
</section>

<style>
  .playback[data-space="home"] {
    padding-bottom: 120px;
  }

  .playback[data-space="page"] {
    padding-bottom: 96px;
  }

  .playback-caption {
    margin: 18px 0 0;
    text-align: center;
  }

  @media (max-width: 900px) {
    .playback[data-space] {
      padding-bottom: 64px;
    }
  }
</style>
