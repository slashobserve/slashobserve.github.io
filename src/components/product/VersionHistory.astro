---
import Mark from "./Mark.astro"
import Window from "./Window.astro"
import { DASHBOARD_ID, DASHBOARD_TITLE, HOST } from "./screen-ids"

const LATEST = 7

const chevron = '<path d="m6 9 6 6 6-6"/>'
const plus = '<path d="M5 12h14"/><path d="M12 5v14"/>'
const pen = '<path d="M13 21h8"/><path d="M21.17 6.81a1 1 0 0 0-3.99-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z"/>'

const versions: { version: number; summary: string; author: string; agent?: boolean; saved: string }[] = [
  {
    version: 7,
    summary: 'Added "Error ratio by service"; moved "p95 latency by service".',
    author: "Observe Agent for Priya",
    agent: true,
    saved: "2 hours ago",
  },
  { version: 6, summary: "Set a threshold of 80% on Database connections in use.", author: "Priya", saved: "yesterday" },
  { version: 5, summary: "Repair the Connections by database query after postgresql_backends was renamed.", author: "Tom", saved: "2 days ago" },
  { version: 4, summary: "Add Payment charges per minute by outcome to Are orders flowing?", author: "Tom", saved: "3 days ago" },
  { version: 3, summary: "Show request rate per service instead of per route.", author: "Priya", saved: "last week" },
]
---

<Window url={`${HOST}/d/${DASHBOARD_ID}/versions`} label="The version history">
  <div class="history-page">
    <div class="row crumbs">
      <span class="k">← Back to dashboard</span>
      <span class="k" aria-hidden="true">/</span>
      <span class="title">Versions of {DASHBOARD_TITLE}</span>
    </div>
    <div class="scroll">
      <table class="tbl history">
        <thead>
          <tr><th>Version</th><th>Summary</th><th>Author</th><th>Saved</th><th>Actions</th></tr>
        </thead>
        <tbody>
          {
            versions.map(({ version, summary, author, agent, saved }) => (
              <tr>
                <td class="version">
                  <span class="label">v{version}</span>
                  {version === LATEST && <span class="badge">Latest</span>}
                </td>
                <td class="summary">{summary}</td>
                <td class="author">
                  {agent ? (
                    <span class="agent">
                      <Mark kind="agent" size={16} />
                      <span>{author}</span>
                      <span class="from">From chat</span>
                    </span>
                  ) : (
                    author
                  )}
                </td>
                <td class="k nowrap">{saved}</td>
                <td>
                  <span class="row actions">
                    <span class="view">View</span>
                    <span class="btn btn-sm">Compare</span>
                    {version !== LATEST && <span class="btn btn-sm">Restore</span>}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="diff">
      <span class="label diff-title">Changes from v6 to v7</span>
      <span class="row pickers">
        <span class="row"><span class="k">From</span><span class="select">v6<svg class="k" viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span></span>
        <span class="row"><span class="k">To</span><span class="select">v7<svg class="k" viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span></span>
      </span>
      <div class="change">
        <span class="label">Panel "Error ratio by service"</span>
        <span class="row op"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={plus} /><b>Added</b></span>
      </div>
      <div class="change">
        <span class="label">Panel "p95 latency by service"</span>
        <span class="row op"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={pen} /><b>Changed</b><span class="k">gridPos.y</span></span>
        <span class="values">
          <span class="value before"><b>Before</b><span class="mono">8</span></span>
          <span class="value after"><b>After</b><span class="mono">0</span></span>
        </span>
      </div>
    </div>
  </div>
</Window>

<style>
  .history-page {
    display: flex;
    flex-direction: column;
    font-size: 12px;
  }

  .crumbs {
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  .title {
    font-size: 13px;
    font-weight: 600;
  }

  .history th,
  .history td {
    padding: 7px 6px;
    font-size: 11.5px;
    line-height: 1.35;
    vertical-align: middle;
  }

  .history th:first-child,
  .history td:first-child {
    padding-left: 14px;
  }

  .history th:last-child,
  .history td:last-child {
    padding-right: 14px;
  }

  .version {
    white-space: nowrap;
  }

  .version .label {
    display: block;
  }

  .badge {
    display: inline-block;
    margin-top: 3px;
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--muted);
    font-size: 10.5px;
  }

  .summary {
    min-width: 150px;
  }

  .nowrap {
    white-space: nowrap;
  }

  .actions {
    gap: 6px;
    flex-wrap: nowrap;
  }

  .actions .btn {
    min-height: 24px;
    padding: 0 7px;
    font-size: 11px;
  }

  .view {
    padding-right: 2px;
  }

  .diff {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px 14px;
    border-top: 1px solid var(--border);
  }

  .diff-title {
    font-size: 13px;
  }

  .pickers {
    gap: 14px;
    flex-wrap: wrap;
  }

  .pickers > .row {
    gap: 6px;
  }

  .select {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 9px;
    background: var(--card);
  }

  .change {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-radius: 8px;
    background: var(--muted);
    padding: 8px 10px;
  }

  .op {
    gap: 5px;
  }

  .op b {
    font-weight: 500;
  }

  svg {
    flex: none;
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .values {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px;
  }

  .value {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 5px;
    padding: 5px 8px;
  }

  .value b {
    font-size: 11px;
    font-weight: 500;
  }

  .before {
    background: var(--crit-container);
  }

  .after {
    background: var(--ok-container);
  }

  .author {
    min-width: 96px;
  }

  .agent {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
</style>
