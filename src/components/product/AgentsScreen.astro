---
import Mark from "./Mark.astro"

const stats = [
  { label: "Runs", value: "4" },
  { label: "Failed", value: "0" },
  { label: "Cost", value: "Not priced" },
  { label: "Median wait", value: "2 s" },
]

const connected = [
  { name: "Claude Code", initials: "CC", mode: "Direct", status: "Working", present: true, writes: 12 },
  { name: "OpenCode", initials: "OP", mode: "Propose", status: "Offline, last seen 5 min ago", present: false, writes: 3 },
]

const accounts = [{ name: "ci-bot", initials: "CB", status: "Listening", runs: 5, failed: 0 }]
---

<div class="agents" role="group" aria-label="The Agents page">
  <div class="row head">
    <span class="title">Agents</span>
    <span class="btn btn-primary btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"
        ><path d="M12 5v14M5 12h14"></path></svg
      >
      Connect an agent
    </span>
  </div>

  <section class="card observe" aria-label="Observe Agent">
    <div class="row identity">
      <Mark kind="agent" size={24} />
      <span class="name">Observe Agent</span>
      <span class="row on">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="m5 12 5 5 9-10"></path></svg
        >
        On
      </span>
      <span class="k">anthropic claude-haiku-5-5</span>
    </div>
    <dl class="stats">
      {
        stats.map(({ label, value }) => (
          <div>
            <dt class="k">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="k scope">Last 7 days, everyone</p>
  </section>

  <div class="block">
    <h3 class="heading">Connected agents</h3>
    <div class="card">
      <table class="grid">
        <thead>
          <tr>
            <th>Agent</th><th>Mode</th><th>Status</th><th>Writes in 7 days</th><th><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {
            connected.map(({ name, initials, mode, status, present, writes }) => (
              <tr>
                <td>
                  <span class="row">
                    <Mark kind="connected" initials={initials} size={20} />
                    <span class="person">{name}</span>
                  </span>
                </td>
                <td>
                  <span class="select">
                    {mode}
                    <span class="k" aria-hidden="true">▾</span>
                  </span>
                </td>
                <td class="k">
                  <span class="row status">
                    {present && <span class:list={["dot", "tone-ok", { working: status === "Working" }]} />}
                    {status}
                  </span>
                </td>
                <td class="k">{writes}</td>
                <td class="action">
                  <span class="manage">Manage in Settings</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="block">
    <h3 class="heading">Service accounts that take runs</h3>
    <div class="card">
      <table class="grid">
        <thead>
          <tr>
            <th>Name</th><th>Status</th><th>Runs in 7 days</th><th>Failed</th>
          </tr>
        </thead>
        <tbody>
          {
            accounts.map(({ name, initials, status, runs, failed }) => (
              <tr>
                <td>
                  <span class="row">
                    <Mark kind="connected" initials={initials} size={20} />
                    <span class="person">{name}</span>
                  </span>
                </td>
                <td class="k">
                  <span class="row status">
                    <span class="dot tone-ok" />
                    {status}
                  </span>
                </td>
                <td class="k">{runs}</td>
                <td class="k">{failed}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .agents {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 13px;
  }

  .head {
    justify-content: space-between;
  }

  .title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .head .btn {
    min-height: 32px;
    padding: 0 12px;
    font-size: 13px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    min-width: 0;
  }

  .observe {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
  }

  .identity {
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .name {
    font-size: 14px;
    font-weight: 600;
  }

  .on {
    gap: 5px;
    font-weight: 500;
  }

  .on svg {
    color: var(--ok);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px 24px;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .stats dt {
    font-size: 12px;
  }

  .stats dd {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .scope {
    margin: 0;
    font-size: 12px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .heading {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .grid {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .grid th {
    padding: 9px 14px;
    text-align: left;
    font-weight: 500;
    color: var(--mfg);
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }

  .grid td {
    padding: 11px 14px;
    vertical-align: middle;
    border-bottom: 1px solid var(--border);
  }

  .grid tr:last-child td {
    border-bottom: 0;
  }

  .person {
    font-weight: 500;
  }

  .status {
    gap: 6px;
    white-space: nowrap;
  }

  .action {
    text-align: right;
    white-space: nowrap;
  }

  .manage {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .select {
    display: inline-flex;
    gap: 16px;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
  }

  @media (prefers-reduced-motion: no-preference) {
    .working {
      animation: working-pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes working-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  @container (max-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .grid,
    .grid tbody {
      display: block;
    }

    .grid tbody tr {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 4px 12px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
    }

    .grid tbody tr:last-child {
      border-bottom: 0;
    }

    .grid td {
      padding: 0;
      border: 0;
    }

    .grid td:first-child {
      flex-basis: 100%;
    }

    .grid td:not(:first-child):not(.action) {
      font-size: 12px;
    }

    .action {
      margin-left: auto;
    }
  }
</style>
