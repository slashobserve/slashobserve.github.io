---
import Window from "./Window.astro"
import { HOST, TRACE_ID } from "./screen-ids"
import { ROOT, SELECTED_SPAN, SPANS, TICKS, TRACE_START } from "./trace"

const selected = SPANS.find((span) => span.selected) ?? ROOT
---

<Window url={`${HOST}/t/${TRACE_ID}?ds=tempo`} label="The trace view">
  <div class="page">
    <div class="head">
      <div class="head-text">
        <span class="title">Trace {TRACE_ID.slice(0, 8)}</span>
        <span class="mono k trace-id">{TRACE_ID}</span>
      </div>
      <span class="row head-actions">
        <span class="btn btn-sm hide-xs">Last 1 hour</span>
        <span class="btn btn-sm">Copy link</span>
        <span class="btn btn-sm hide-xs">Search traces</span>
      </span>
    </div>
    <div class="card">
      <div class="card-head">
        <span class="label">{ROOT.service} {ROOT.operation}</span>
        <span class="row k meta">
          <span>Trace <span class="mono">{TRACE_ID}</span></span>
          <span>{TRACE_START}</span>
          <span>{ROOT.duration}</span>
        </span>
      </div>
      <div class="split">
        <div class="waterfall">
          <div class="span-row ruler">
            <span>Service and operation</span>
            <span class="ticks" aria-hidden="true">{TICKS.map((tick) => <span>{tick}</span>)}</span>
          </div>
          {
            SPANS.map(({ service, operation, depth, tone, width, offset, duration, error, selected }) => (
              <div class:list={["span-row", { selected }]}>
                <span class="name" style={`padding-left:${depth * 10}px`}>
                  <span class="op">
                    <span class="k">{service}</span> {operation}
                  </span>
                  {error && (
                    <span class="row err">
                      <span class="dot tone-crit" />
                      Error
                    </span>
                  )}
                  <span class="k dur">{duration}</span>
                </span>
                <span class="track">
                  <span class={`span-bar tone-${tone}`} style={`width:${width}%;margin-left:${offset}%`} />
                </span>
              </div>
            ))
          }
        </div>
        <div class="pane">
          <span class="label">
            {selected.service} {selected.operation}
          </span>
          <span class="row k meta">
            <span>Span <span class="mono">{SELECTED_SPAN.id}</span></span>
            <span>{SELECTED_SPAN.start}</span>
            <span>{selected.duration}</span>
            <span class="row err">
              <span class="dot tone-crit" />
              Error
            </span>
          </span>
          <div class="attrs">
            {
              SELECTED_SPAN.attributes.map(([key, value]) => (
                <>
                  <span class="k">{key}</span>
                  <span class="mono">{value}</span>
                </>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Window>

<style>
  .page {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 11.5px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .head-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .title {
    font-size: 15px;
    font-weight: 600;
  }

  .trace-id {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .head-actions {
    gap: 6px;
    flex: none;
  }

  .btn {
    min-height: 28px;
    font-size: 12px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .card-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 7px 9px;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    flex-wrap: wrap;
    gap: 0 10px;
    font-size: 11px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 38%;
  }

  .waterfall {
    min-width: 0;
  }

  .span-row {
    display: grid;
    grid-template-columns: minmax(150px, 46%) minmax(0, 1fr);
    align-items: center;
    min-height: 26px;
    border-bottom: 1px solid var(--border);
  }

  .ruler {
    color: var(--mfg);
    font-size: 10.5px;
  }

  .ruler > span:first-child {
    padding-left: 8px;
  }

  .ticks {
    display: flex;
    justify-content: space-between;
    padding: 0 8px;
  }

  .selected {
    background: var(--sel);
  }

  .name {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-right: 8px;
    margin-left: 8px;
    min-width: 0;
    white-space: nowrap;
  }

  .op {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .err {
    gap: 4px;
    flex: none;
  }

  .dur {
    flex: none;
  }

  .track {
    padding: 0 8px;
    min-width: 0;
  }

  .span-bar {
    display: block;
    height: 10px;
    border-radius: 5px;
    background: var(--tone);
  }

  .pane {
    border-left: 1px solid var(--border);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .attrs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    margin-top: 6px;
  }

  .attrs .mono {
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .pane {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 480px) {
    .hide-xs,
    .ticks > span:not(:first-child, :last-child) {
      display: none;
    }

    .span-row {
      grid-template-columns: minmax(0, 62%) minmax(0, 1fr);
    }
  }
</style>
