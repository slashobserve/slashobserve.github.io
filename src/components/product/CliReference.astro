---
import Window from "./Window.astro"

const LINES = [
  'observe "..."          build',
  "observe dashboards     list, show, versions, delete, export, apply, move,",
  "                       duplicate, restore, diff, revisions, tags, panels,",
  "                       viewers, schema, sample",
  "observe o              new, show, add, resolve, list, keep, discard, publish,",
  "                       edit, move, reopen, pin, dashboard, delete, rcas,",
  "                       withdraw, edit-block, remove-block, arrange",
  "observe proposals      list, show, merge, discard",
  "observe comments       list, add, reply, edit, delete, withdraw, apply, people,",
  "                       resolve, reopen",
  "observe folders        list, create, rename, delete, permissions",
  "observe annotations    list, update, delete",
  "observe annotate       <text...>",
  "observe datasources    list, recheck, get, add, edit, test, remove, schema,",
  "                       sample, metrics, labels, label-values, services, lint,",
  "                       log-volume, trace-stats, trace-logs",
  "observe metrics        query",
  "observe logs           [query] --datasource, --tail, --ask",
  "observe traces         [trace id] --datasource, --ask, --compare",
  "observe search         <words...>",
  "observe saved-searches list, save, update, rename, move, delete",
  "observe grafana        connect, import",
  "observe import         <file>",
  "observe health         repair, run",
  "observe investigate    <question...>",
  "observe run            [name...]",
  "observe requests       list, pin, unpin, rename, archive",
  "observe chats          list, show, archive, pin, unpin",
  "observe status         <request id>",
  "observe cancel         <request id>",
  "observe continue       <request id>",
  "observe retry          <request id>",
  "observe save-answer    <request id>",
  "observe share-answer   <request id>",
  "observe activity       --follow",
  "observe audit          search, show, facets, histogram, aggregate, fields,",
  "                       export",
  "observe access         request, requests",
  "observe people         list, invite, invites, uninvite",
  "observe teams          list, create, delete, add, remove",
  "observe webhooks       list, add, update, enable, disable, test, skip,",
  "                       rotate-secret, delete, deliveries",
  "observe open           [dashboard id, Grafana uid or address]",
  "observe skill          install",
  "observe doctor",
  "observe login",
  "observe logout",
  "observe version",
  "observe completion     bash, zsh, fish",
]
---

<Window title="CLI reference" lights={false}>
  <div class="term">{LINES.map((line) => <span class="tl">{line}</span>)}</div>
</Window>

<style>
  .term {
    font-size: 12px;
  }
</style>
