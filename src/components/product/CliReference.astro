---
import Window from "./Window.astro"

const LINES = [
  'observe "..."        build',
  "observe dashboards   list, get, delete",
  "observe logs         tail, search",
  "observe traces       get, search",
  "observe grafana      connect, import",
  "observe repairs      list, run",
  "observe doctor",
]
---

<Window title="CLI reference" lights={false}>
  <div class="term">{LINES.map((line) => <span class="tl">{line}</span>)}</div>
</Window>

<style>
  .term {
    font-size: 12px;
  }
</style>
