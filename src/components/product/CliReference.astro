---
import Window from "./Window.astro"

const LINES = [
  'observe "..."          build',
  "observe dashboards     list, show, versions, delete, export, apply, move,",
  "                       duplicate, restore, diff",
  "observe o              new, show, add, resolve, list, keep, discard, publish,",
  "                       edit, move, reopen, rcas",
  "observe proposals      list, show, merge, discard",
  "observe comments       list, add, reply, edit, resolve, reopen",
  "observe folders        list, create, rename, delete",
  "observe annotations    list, delete",
  "observe annotate       <text...>",
  "observe logs           [query] --datasource, --tail, --ask",
  "observe traces         [trace id] --datasource, --ask",
  "observe search         <words...>",
  "observe saved-searches list, save, rename, move, delete",
  "observe grafana        connect, import",
  "observe import         <file>",
  "observe health         repair, run",
  "observe investigate    <question...>",
  "observe run            [name...]",
  "observe status         <request id>",
  "observe cancel         <request id>",
  "observe continue       <request id>",
  "observe retry          <request id>",
  "observe activity       --follow",
  "observe webhooks       list, add, update, enable, disable, test, rotate-secret,",
  "                       delete, deliveries",
  "observe open           [dashboard id, Grafana uid or address]",
  "observe skill          install",
  "observe doctor",
  "observe login",
  "observe logout",
  "observe version",
  "observe completion     bash, zsh, fish",
]
---

<Window title="CLI reference" lights={false}>
  <div class="term">{LINES.map((line) => <span class="tl">{line}</span>)}</div>
</Window>

<style>
  .term {
    font-size: 12px;
  }
</style>
