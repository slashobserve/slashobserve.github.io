---
import Window from "./Window.astro"

const LINES = [
  'observe "..."        build',
  "observe dashboards   list, show, versions, delete, export, apply",
  "observe logs         [query] --datasource, --tail, --ask",
  "observe traces       [trace id] --datasource, --ask",
  "observe grafana      connect, import",
  "observe import       <file>",
  "observe annotate     <text>",
  "observe comments     list, reply, resolve",
  "observe run          [name...]",
  "observe status       <request id>",
  "observe cancel       <request id>",
  "observe continue     <request id>",
  "observe open         [dashboard id or Grafana uid]",
  "observe doctor",
  "observe login",
  "observe logout",
  "observe version",
  "observe completion   bash, zsh, fish",
]
---

<Window title="CLI reference" lights={false}>
  <div class="term">{LINES.map((line) => <span class="tl">{line}</span>)}</div>
</Window>

<style>
  .term {
    font-size: 12px;
  }
</style>
