---
import SameLink from "./SameLink.astro"
import Window from "./Window.astro"
---

<Window url="observe.example.com/import/repair">
  <div class="scroll">
    <table class="tbl">
      <thead>
        <tr>
          <th>Dashboard</th>
          <th>Unverified</th>
          <th>Why</th>
          <th><span class="sr-only">Status</span></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Kubernetes / Pods</td>
          <td class="fg-warn">3 of 24</td>
          <td class="k">metric renamed</td>
          <td><span class="chip"><span class="dot tone-s1"></span>repairing 2 of 3</span></td>
        </tr>
        <tr>
          <td>Node exporter full</td>
          <td class="fg-warn">5 of 41</td>
          <td class="k">label <span class="mono">nodename</span> missing</td>
          <td><span class="btn btn-sm repair">Repair</span></td>
        </tr>
        <tr>
          <td>Payments latency</td>
          <td class="fg-ok">0 of 9</td>
          <td class="k">repaired · version 2</td>
          <td class="hint">view diff</td>
        </tr>
      </tbody>
    </table>
  </div>
  <SameLink />
</Window>

<style>
  .repair {
    min-height: 26px;
    font-size: 12px;
  }
</style>
