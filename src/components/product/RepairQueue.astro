---
import SameLink from "./SameLink.astro"
import Window from "./Window.astro"
import { HOST } from "./screen-ids"

type Tone = "running" | "ok" | "critical"

const TONE_CLASS: Record<Tone, string> = {
  running: "tone-mfg",
  ok: "tone-ok",
  critical: "tone-crit",
}

interface QueuedDashboard {
  name: string
  folder: string
  unverified: string
  placeholders: number
  repair: { label: string; tone: Tone; finished?: string } | null
  canRepair: boolean
}

const rows: QueuedDashboard[] = [
  {
    name: "Kubernetes / Pods",
    folder: "Platform / Kubernetes",
    unverified: "3 panels",
    placeholders: 0,
    repair: { label: "Repairing", tone: "running" },
    canRepair: false,
  },
  {
    name: "Node exporter full",
    folder: "Infra",
    unverified: "5 panels, 1 variable",
    placeholders: 0,
    repair: { label: "Repair queued", tone: "running" },
    canRepair: false,
  },
  {
    name: "Payments latency",
    folder: "Platform / Shop",
    unverified: "1 panel",
    placeholders: 0,
    repair: { label: "Repaired, still failing", tone: "ok", finished: "12 min ago" },
    canRepair: true,
  },
  {
    name: "Ingest pipeline",
    folder: "Observability",
    unverified: "2 panels",
    placeholders: 3,
    repair: { label: "Repair failed", tone: "critical", finished: "1 h ago" },
    canRepair: true,
  },
  { name: "Checkout service", folder: "Platform / Shop", unverified: "1 panel", placeholders: 0, repair: null, canRepair: true },
  { name: "Graphite legacy", folder: "Infra", unverified: "None", placeholders: 4, repair: null, canRepair: false },
]

interface Props {
  onStage?: boolean
}

const { onStage = false } = Astro.props
---

<div class="repair-stack">
  <Window url={onStage ? undefined : `${HOST}/dashboards?kind=imported`} label="The imported dashboards that are not verified">
    <div class="row filters">
      <span class="field k">Filter by title</span>
      <span class="select">Folder: any<span class="k" aria-hidden="true">▾</span></span>
      <span class="select">Problem: Imported, not verified<span class="k" aria-hidden="true">▾</span></span>
    </div>
    <div class="row head">
      <span class="k description">
        Imported dashboards whose panels or variables failed their queries, or hold placeholders. A dashboard leaves this
        list once nothing in it fails.
      </span>
      <span class="btn btn-primary btn-sm">Repair all</span>
    </div>
    <div class="scroll">
      <table class="tbl queue">
        <thead>
          <tr>
            <th>Dashboard</th><th>Folder</th><th>Unverified</th><th>Placeholders</th><th>Imported</th><th>Repair</th><th
              ><span class="sr-only">Actions</span></th
            >
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ name, folder, unverified, placeholders, repair, canRepair }) => (
              <tr>
                <td class="name">{name}</td>
                <td>{folder}</td>
                <td>{unverified}</td>
                <td>{placeholders}</td>
                <td class="nowrap">2 h ago</td>
                <td class="state">
                  {repair ? (
                    <span class="status">
                      <span class="row">
                        <span class:list={["dot", TONE_CLASS[repair.tone]]} />
                        {repair.label}
                      </span>
                      {repair.finished && <span class="k when">{repair.finished}</span>}
                    </span>
                  ) : (
                    <span class="k nowrap">Not requested</span>
                  )}
                </td>
                <td>
                  <span class:list={["btn btn-sm repair", { off: !canRepair }]}>Repair with the agent</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Window>
  <SameLink />
</div>

<style>
  .repair-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .filters {
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 12px 0;
  }

  .field {
    display: inline-flex;
    align-items: center;
    min-width: 150px;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 12px;
    background: var(--card);
  }

  .head {
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
  }

  .description {
    font-size: 11.5px;
  }

  .select {
    display: inline-flex;
    gap: 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 12px;
    background: var(--card);
  }

  .head .btn {
    min-height: 26px;
    padding: 0 9px;
    font-size: 11.5px;
  }

  .repair {
    min-height: 0;
    padding: 4px 8px;
    font-size: 11px;
    line-height: 1.25;
    white-space: normal;
    text-align: center;
  }

  .queue {
    position: relative;
    font-size: 11.5px;
    border-top: 1px solid var(--border);
  }

  .queue th,
  .queue td {
    padding: 7px 6px;
    line-height: 1.35;
  }

  .queue th:first-child,
  .queue td:first-child {
    padding-left: 12px;
  }

  .queue th:last-child,
  .queue td:last-child {
    padding-right: 12px;
  }

  .nowrap {
    white-space: nowrap;
  }

  .name {
    font-weight: 500;
  }

  .status {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .when {
    font-size: 11px;
  }

  .off {
    opacity: 0.5;
  }
</style>
