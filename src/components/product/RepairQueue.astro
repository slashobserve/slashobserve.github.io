---
import Window from "./Window.astro"
import { HOST } from "./screen-ids"

type Tone = "running" | "ok" | "critical"

const TONE_CLASS: Record<Tone, string> = {
  running: "tone-mfg",
  ok: "tone-ok",
  critical: "tone-crit",
}

interface QueuedDashboard {
  name: string
  folder: string
  unverified: string
  placeholders: number
  repair: { label: string; tone: Tone; finished?: string; live?: boolean } | null
  canRepair: boolean
}

const rows: QueuedDashboard[] = [
  {
    name: "Spanmetrics Demo Dashboard",
    folder: "Astronomy Shop / Services",
    unverified: "3 panels",
    placeholders: 0,
    repair: { label: "Repairing", tone: "running", live: true },
    canRepair: false,
  },
  {
    name: "Linux",
    folder: "Infra",
    unverified: "5 panels, 1 variable",
    placeholders: 0,
    repair: { label: "Repair queued", tone: "running" },
    canRepair: false,
  },
  {
    name: "Demo Dashboard",
    folder: "Astronomy Shop / Services",
    unverified: "1 panel",
    placeholders: 0,
    repair: { label: "Repaired, still failing", tone: "ok", finished: "12 min ago" },
    canRepair: true,
  },
  {
    name: "OpenTelemetry Collector",
    folder: "Observability",
    unverified: "2 panels",
    placeholders: 3,
    repair: { label: "Repair failed", tone: "critical", finished: "1 h ago" },
    canRepair: true,
  },
  { name: "Self-Observability", folder: "Astronomy Shop / Services", unverified: "1 panel", placeholders: 0, repair: null, canRepair: true },
  { name: "Cart Service Exemplars", folder: "Infra", unverified: "None", placeholders: 4, repair: null, canRepair: false },
]

interface Props {
  onStage?: boolean
}

const { onStage = false } = Astro.props

const chevron = '<path d="m6 9 6 6 6-6"/>'
const search = '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>'
const filters = [
  { label: "Made by: anyone", wide: true },
  { label: "Datasource: any", wide: true },
  { label: "Folder: any", wide: false },
  { label: "Problem: Imported, not verified", wide: false },
  { label: "Tags: any", wide: true },
]
---

<Window url={`${HOST}/dashboards?kind=imported`} {onStage} label="The imported dashboards that are not verified">
  <div class="row title-row">
    <span class="title">Dashboards</span>
    <span class="row k checked">Last checked 34 min ago<span class="run">Run now</span></span>
  </div>
  <div class="row filters">
    <span class="field k"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={search} />Filter by title</span>
    {
      filters.map(({ label, wide }) => (
        <span class:list={["select", { "hide-sm": wide }]}>
          {label}
          <svg class="k" viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} />
        </span>
      ))
    }
  </div>
  <div class="row head">
    <span class="k description">
      Imported dashboards whose panels or variables failed their queries, or hold placeholders. A dashboard leaves this
      list once nothing in it fails.
    </span>
    <span class="btn btn-primary btn-sm">Repair all</span>
  </div>
  <div class="scroll">
    <table class="tbl queue">
      <thead>
        <tr>
          <th>Dashboard</th><th>Folder</th><th>Unverified</th><th>Placeholders</th><th>Imported</th><th>Repair</th><th
            ><span class="sr-only">Actions</span></th
          >
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ name, folder, unverified, placeholders, repair, canRepair }) => (
            <tr>
              <td class="name">{name}</td>
              <td>{folder}</td>
              <td>{unverified}</td>
              <td>{placeholders}</td>
              <td class="nowrap">2 h ago</td>
              <td class="state">
                {repair ? (
                  <span class="status">
                    <span class="row">
                      <span class:list={["dot", TONE_CLASS[repair.tone], { pulse: repair.live }]} />
                      {repair.label}
                    </span>
                    {repair.finished && <span class="k when">{repair.finished}</span>}
                  </span>
                ) : (
                  <span class="k nowrap">Not requested</span>
                )}
              </td>
              <td>
                <span class:list={["btn btn-sm repair", { off: !canRepair }]}>Repair with the agent</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Window>

<style>
  .title-row {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    padding: 12px 12px 0;
  }

  .title {
    font-size: 14px;
    font-weight: 600;
  }

  .checked {
    gap: 10px;
    font-size: 11px;
  }

  .run {
    color: var(--fg);
    font-weight: 500;
  }

  svg {
    flex: none;
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .filters {
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 12px 0;
  }

  .field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 150px;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 12px;
    background: var(--card);
  }

  .head {
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
  }

  .description {
    font-size: 11.5px;
  }

  .select {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 12px;
    background: var(--card);
  }

  .head .btn {
    min-height: 26px;
    padding: 0 9px;
    font-size: 11.5px;
  }

  .repair {
    min-height: 24px;
    padding: 0 8px;
    font-size: 11px;
  }

  .queue {
    position: relative;
    font-size: 11.5px;
    border-top: 1px solid var(--border);
  }

  .queue th,
  .queue td {
    padding: 7px 6px;
    line-height: 1.35;
  }

  .queue th:first-child,
  .queue td:first-child {
    padding-left: 12px;
  }

  .queue th:last-child,
  .queue td:last-child {
    padding-right: 12px;
  }

  .nowrap {
    white-space: nowrap;
  }

  .name {
    font-weight: 500;
  }

  .status {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .when {
    font-size: 11px;
  }

  .off {
    opacity: 0.5;
  }
</style>
