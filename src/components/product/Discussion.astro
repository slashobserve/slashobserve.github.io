---
import Mark from "./Mark.astro"

interface Props {
  class?: string
}

const { class: className } = Astro.props

const hide = '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/>'
const mention = '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>'
const send = '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>'
---

<aside class:list={["pane", className]} aria-label="Discussion">
  <header class="pane-head">
    <h2>Discussion</h2>
    <span class="icon-btn" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={hide} /></span>
  </header>
  <ol class="messages" aria-label="Messages">
    <li class="msg" data-msg="1">
      <Mark kind="person" initials="AD" tint={1} size={24} />
      <div class="msg-body">
        <div class="msg-head"><b>admin</b><span class="k">17:02</span></div>
        <p><span class="at">@observe</span> can we confirm the errors come from the payments client timeout?</p>
        <span class="btn btn-sm add">Add to page</span>
      </div>
    </li>
    <li class="msg" data-msg="2">
      <Mark kind="agent" size={24} />
      <div class="msg-body">
        <div class="msg-head"><b>Observe Agent for admin</b><span class="k">17:03</span></div>
        <p>
          Yes. 94% of the 5xx on /api/checkout carry <code>payments: context deadline exceeded</code>, and they start 3
          minutes after the rollout.
        </p>
        <span class="btn btn-sm add">Add to page</span>
      </div>
    </li>
    <li class="msg" data-msg="3">
      <Mark kind="person" initials="JP" tint={4} size={24} />
      <div class="msg-body">
        <div class="msg-head"><b>Jo Park</b><span class="k">17:06</span></div>
        <p>That matches the new 2s client timeout in the payments chart. Adding the snapshot to the page.</p>
        <span class="btn btn-sm add">Add to page</span>
      </div>
    </li>
  </ol>
  <div class="composer-wrap">
    <div class="composer">
      <span class="placeholder">Message, or type @ to ask an agent</span>
      <div class="composer-foot">
        <span class="hint">Messages stay here until someone adds them to the page</span>
        <span class="icon-btn" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={mention} /></span>
        <span class="send" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={send} /></span>
      </div>
    </div>
  </div>
</aside>

<style>
  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    font-size: 13px;
    line-height: 1.45;
  }

  .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px 6px 16px;
    border-bottom: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--mfg);
  }

  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }

  .msg {
    display: flex;
    gap: 10px;
    padding: 10px 16px;
  }

  .msg-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .msg-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 8px;
  }

  .msg-head b {
    font-weight: 600;
  }

  .msg-head .k {
    font-size: 12px;
  }

  p {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .at {
    padding: 0 3px;
    border-radius: 4px;
    background: var(--accent-container);
    color: var(--on-accent-container);
    font-weight: 600;
  }

  code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .add {
    align-self: flex-start;
    min-height: 28px;
    margin-left: -8px;
    padding: 0 8px;
    border-color: transparent;
    background: transparent;
    color: var(--mfg);
    font-size: 12.5px;
  }

  .composer-wrap {
    padding: 8px 16px 16px;
  }

  .composer {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  .placeholder {
    padding: 10px 12px 6px;
    color: var(--mfg);
  }

  .composer-foot {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 6px 6px 12px;
  }

  .hint {
    flex: 1;
    min-width: 0;
    color: var(--mfg);
    font-size: 12px;
  }

  .send {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--primary);
    color: var(--pfg);
    opacity: 0.5;
  }
</style>
