---
import Mention from "./Mention.astro"
import Message from "./Message.astro"

interface Props {
  class?: string
}

const { class: className } = Astro.props

const close = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'
const chevron = '<path d="m6 9 6 6 6-6"/>'
const mention = '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>'
const send = '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>'
---

<aside class:list={["pane", className]} aria-label="Discussion">
  <header class="pane-head">
    <div class="pane-title">
      <h2>Discussion</h2>
      <span class="k">Messages, agent answers and changes to the page.</span>
    </div>
    <span class="icon-btn" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={close} /></span>
  </header>
  <div class="filters">
    <span class="k">Show</span>
    <span class="select">Everything<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span>
    <span class="k">Block</span>
    <span class="select">All blocks<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span>
  </div>
  <ol class="messages" aria-label="Messages">
    <Message as="li" seq={0} author="person" initials="AD" tint={1} name="admin" verb="asked the agent" time="17:02">
      <Mention /> can we confirm the errors come from the payments client timeout?
    </Message>
    <Message as="li" seq={1} author="agent" name="Observe Agent for admin" verb="replied" time="17:03">
      Wrote the answer into this observation: Checkout errors began with the payments rollout.
    </Message>
    <Message as="li" seq={2} author="person" initials="JP" tint={4} name="Jo Park" verb="commented" time="17:06">
      That matches the new 2s client timeout in the payments chart.
    </Message>
  </ol>
  <div class="composer-wrap">
    <div class="composer">
      <span class="select on">On the whole page<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span>
      <span class="placeholder">Message, or type @ to ask an agent</span>
      <div class="composer-foot">
        <span class="hint">Messages stay here until someone adds them to the page</span>
        <span class="icon-btn" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={mention} /></span>
        <span class="send" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={send} /></span>
      </div>
    </div>
  </div>
</aside>

<style>
  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-left: 1px solid var(--border);
    font-size: 13px;
    line-height: 1.45;
  }

  .pane-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 8px 10px 16px;
    border-bottom: 1px solid var(--border);
  }

  .pane-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .pane-title .k {
    font-size: 12px;
  }

  h2 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--mfg);
  }

  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 8px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
  }

  .select {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 12px;
    white-space: nowrap;
  }

  .select svg {
    width: 12px;
    height: 12px;
    color: var(--mfg);
  }

  .messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
    padding: 4px 16px;
    list-style: none;
  }

  .composer-wrap {
    padding: 8px 16px 16px;
  }

  .composer {
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    background: var(--muted);
  }

  .on {
    align-self: flex-start;
    margin: 6px 6px 0;
  }

  .placeholder {
    padding: 8px 12px 4px;
    color: var(--mfg);
  }

  .composer-foot {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 6px 6px 12px;
  }

  .hint {
    flex: 1;
    min-width: 0;
    color: var(--mfg);
    font-size: 11.5px;
    line-height: 1.35;
  }

  .send {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--primary);
    color: var(--pfg);
    opacity: 0.5;
  }
</style>
