---
export type Level = "Error" | "Warning" | "Info"

interface Props {
  level: Level
}

const { level } = Astro.props

const TONE: Record<Level, string> = { Error: "fg-crit", Warning: "fg-warn", Info: "k" }
---

<svg
  class:list={["level-icon", TONE[level]]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {level === "Info" && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 16v-4M12 8h.01" />
    </>
  )}
  {level === "Warning" && (
    <>
      <path d="M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
      <path d="M12 9v4M12 17h.01" />
    </>
  )}
  {level === "Error" && (
    <>
      <path d="M2.59 7.66 7.66 2.59A2 2 0 0 1 9.07 2h5.86a2 2 0 0 1 1.41.59l5.07 5.07a2 2 0 0 1 .59 1.41v5.86a2 2 0 0 1-.59 1.41l-5.07 5.07a2 2 0 0 1-1.41.59H9.07a2 2 0 0 1-1.41-.59l-5.07-5.07A2 2 0 0 1 2 14.93V9.07a2 2 0 0 1 .59-1.41" />
      <path d="M12 8v4M12 16h.01" />
    </>
  )}
</svg>

<style>
  .level-icon {
    width: 12px;
    height: 12px;
    flex: none;
  }
</style>
