---
import SameLink from "./SameLink.astro"
import Window from "./Window.astro"

type Tone = "s1" | "ok" | "crit"

interface QueuedDashboard {
  name: string
  folder: string
  unverified: string
  repair: { label: string; tone: Tone } | null
}

const rows: QueuedDashboard[] = [
  {
    name: "Kubernetes / Pods",
    folder: "Platform / Kubernetes",
    unverified: "3 panels",
    repair: { label: "Repairing", tone: "s1" },
  },
  {
    name: "Node exporter full",
    folder: "Infra",
    unverified: "5 panels, 1 variable",
    repair: { label: "Repair queued", tone: "s1" },
  },
  {
    name: "Payments latency",
    folder: "Platform / Shop",
    unverified: "1 panel",
    repair: { label: "Repaired, still failing", tone: "ok" },
  },
  { name: "Loki / Ingest", folder: "Observability", unverified: "2 panels", repair: { label: "Repair failed", tone: "crit" } },
  { name: "Checkout service", folder: "Platform / Shop", unverified: "1 panel", repair: null },
]
---

<Window url="observe.example.com/import/repair">
  <span slot="bar-end" class="hint queue-title">Repair queue</span>
  <div class="scroll">
    <table class="tbl">
      <thead>
        <tr><th>Dashboard</th><th>Folder</th><th>Unverified</th><th>Repair</th></tr>
      </thead>
      <tbody>
        {
          rows.map(({ name, folder, unverified, repair }) => (
            <tr>
              <td>{name}</td>
              <td class="k">{folder}</td>
              <td>{unverified}</td>
              <td class="state">
                {repair ? (
                  <span class="row">
                    <span class={`dot tone-${repair.tone}`} />
                    {repair.label}
                  </span>
                ) : (
                  <span class="k">Not requested</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <SameLink />
</Window>

<style>
  .queue-title {
    font-size: 12px;
  }

  .state {
    white-space: nowrap;
  }
</style>
