---
import Mark from "./Mark.astro"
import { DASHBOARD_TITLE } from "./screen-ids"

const changes = [
  { label: "Errors by route", change: "added" },
  { label: "p95 latency by route", change: "changed" },
  { label: "Dashboard settings", change: "changed" },
]
---

<article class="proposal" aria-label="A proposal">
  <nav class="row location" aria-label="Proposal location">
    <span class="k">{DASHBOARD_TITLE}</span>
    <span class="k" aria-hidden="true">/</span>
    <span class="current">Proposals</span>
  </nav>
  <h3 class="title">Add errors by route next to p95 latency</h3>
  <div class="byline">
    <div class="row author">
      <Mark kind="connected" initials="CC" size={24} />
      <span class="who">admin (via Claude Code)</span>
      <span class="k">2 h ago</span>
    </div>
    <p class="k state">Open, based on version 4.</p>
  </div>
  <p class="summary">Errors by route sits next to p95 latency, so a slow route and a failing one read together.</p>
  <div class="changes">
    <h4 class="heading">Changes</h4>
    <ul>
      {
        changes.map(({ label, change }) => (
          <li class="row">
            <span class="label">{label}</span>
            <span class="tag">{change}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="row actions">
    <span class="btn btn-primary btn-sm">Merge</span>
    <span class="btn btn-sm">Discard</span>
  </div>
  <span class="open-link">Open the dashboard at version 4</span>
</article>

<style>
  .proposal {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: 10px;
    background: var(--card);
    font-size: 13px;
    line-height: 1.45;
    min-width: 0;
  }

  .location {
    gap: 8px;
  }

  .current {
    font-weight: 500;
  }

  .title {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .byline {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .author {
    flex-wrap: wrap;
    gap: 4px 8px;
  }

  .who {
    font-weight: 500;
  }

  .state {
    margin: 0;
  }

  .summary {
    margin: 0;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .changes {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .heading {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }

  .label {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .tag {
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--muted);
    font-size: 12px;
  }

  .actions .btn {
    min-height: 32px;
    padding: 0 12px;
    font-size: 13px;
  }

  .open-link {
    width: fit-content;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
