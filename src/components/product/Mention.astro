---
interface Props {
  name?: string
}

const { name = "Observe Agent" } = Astro.props
---

<span class="mention" data-mention="agent">@{name}</span>

<style>
  .mention {
    padding: 0 3px;
    border-radius: 4px;
    background: var(--accent-container);
    color: var(--on-accent-container);
    font-weight: 600;
  }
</style>
