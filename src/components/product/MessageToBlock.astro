---
import Message from "./Message.astro"
import TextBlock from "./TextBlock.astro"

const arrow = '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>'
---

<div class="message-to-block" role="group" aria-label="A discussion message added to the page as a text block">
  <Message framed author="person" initials="JP" tint={4} name="Jo Park" time="17:06">
    That matches the new 2s client timeout in the payments chart.
  </Message>
  <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} />
  <div class="block">
    <TextBlock>That matches the new 2s client timeout in the payments chart.</TextBlock>
  </div>
</div>

<style>
  .message-to-block {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.45;
  }

  .arrow {
    align-self: center;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--mfg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .block {
    padding: 4px 2px 0;
  }
</style>
