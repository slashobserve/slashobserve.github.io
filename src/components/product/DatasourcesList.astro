---
import Window from "./Window.astro"
import { HOST } from "./screen-ids"

interface Datasource {
  name: string
  uid: string
  type: string
  tone: "ok" | "crit"
  status: string
  usedBy: string
  explore: string
  source?: string
  onlyAdmins?: boolean
}

const datasources: Datasource[] = [
  {
    name: "Prometheus",
    uid: "prom",
    type: "Prometheus",
    tone: "ok",
    status: "Healthy",
    usedBy: "14 dashboards",
    explore: "Explore metrics",
  },
  {
    name: "Elasticsearch prod",
    uid: "prod-es",
    type: "Elasticsearch",
    tone: "ok",
    status: "Healthy",
    usedBy: "No dashboards",
    explore: "Explore logs",
  },
  {
    name: "OpenSearch prod",
    uid: "prod-os",
    type: "OpenSearch",
    tone: "ok",
    status: "Healthy",
    usedBy: "No dashboards",
    explore: "Explore logs",
  },
  {
    name: "OpenSearch audit",
    uid: "audit-os",
    type: "OpenSearch",
    tone: "crit",
    status: "Unavailable: The index pattern matches no index",
    usedBy: "No dashboards",
    explore: "Explore logs",
  },
  {
    name: "Audit trail",
    uid: "slashobserve-audit",
    type: "OpenSearch",
    tone: "ok",
    status: "Healthy",
    usedBy: "4 dashboards",
    explore: "Explore logs",
    source: "Built in",
    onlyAdmins: true,
  },
]

const check = '<path d="M20 6 9 17l-5-5"/>'
const alert = '<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>'
const plus = '<path d="M5 12h14"/><path d="M12 5v14"/>'
---

<Window url={`${HOST}/datasources`} label="The datasources page with Elasticsearch and OpenSearch datasources">
  <div class="datasources">
    <div class="row head">
      <div class="intro">
        <span class="title">Datasources</span>
        <span class="k">
          Where dashboards and the agent read data from. Entries from the datasources file and the built-in audit trail are read
          only; the ones you add here can be changed.
        </span>
      </div>
      <span class="row head-actions">
        <span class="btn btn-sm">How datasources work</span>
        <span class="btn btn-sm btn-primary"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={plus} />Add datasource</span>
      </span>
    </div>
    <div class="scroll">
      <table class="tbl list">
        <thead>
          <tr>
            <th>Name</th><th>Type</th><th>Status</th><th>Used by</th><th class="checked">Checked</th><th
              ><span class="sr-only">Actions</span></th
            >
          </tr>
        </thead>
        <tbody>
          {
            datasources.map(({ name, uid, type, tone, status, usedBy, explore, source = "From file", onlyAdmins }) => (
              <tr>
                <td>
                  <span class="stack">
                    <span class="row name">
                      <span class="label">{name}</span>
                      {onlyAdmins && <span class="chip badge">Only Admins</span>}
                    </span>
                    <span class="mono k">{uid}</span>
                  </span>
                </td>
                <td>
                  <span class="stack">
                    <span>{type}</span>
                    <span class="k">{source}</span>
                  </span>
                </td>
                <td>
                  <span class:list={["row status", tone === "ok" ? "fg-ok" : "fg-crit"]}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tone === "ok" ? check : alert} />
                    <span class="status-text">{status}</span>
                  </span>
                </td>
                <td class="k">{usedBy}</td>
                <td class="k checked">2 min ago</td>
                <td>
                  <span class="row actions">
                    <span class="btn btn-sm">Recheck</span>
                    <span class="btn btn-sm">{explore}</span>
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="k small">Addresses and users are shown only to Admins, and passwords, tokens and header values never leave the server.</span>
  </div>
</Window>

<style>
  .datasources {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    font-size: 12px;
    line-height: 1.4;
  }

  .head {
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px 12px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
  }

  .small {
    font-size: 11px;
  }

  .btn {
    min-height: 26px;
    padding: 0 9px;
    font-size: 11.5px;
    white-space: nowrap;
  }

  .datasources .scroll {
    border-radius: 8px;
    background: var(--muted);
  }

  .list {
    position: relative;
    min-width: 640px;
  }

  .list th,
  .list td {
    padding: 6px 8px;
    font-size: 11.5px;
    vertical-align: middle;
  }

  .head-actions {
    gap: 6px;
  }

  svg {
    flex: none;
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stack {
    display: flex;
    flex-direction: column;
  }

  .name {
    gap: 8px;
    white-space: nowrap;
  }

  .badge {
    font-size: 11px;
  }

  .status {
    gap: 5px;
  }

  .status-text {
    color: var(--fg);
  }

  .actions {
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .checked {
    text-align: right;
    white-space: nowrap;
  }
</style>
