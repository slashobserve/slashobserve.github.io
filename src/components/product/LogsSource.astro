---
import LevelIcon, { type Level } from "./LevelIcon.astro"
import LogVolume from "./LogVolume.astro"
import Window from "./Window.astro"
import { TRACE_ID } from "./screen-ids"
import { CHARGE_FAILED, CHECKOUT_SPAN_ID } from "./trace"

interface LogLine {
  time: string
  level: Level
  text: string
  selected?: boolean
}

const QUERY = [
  "SELECT Timestamp, SeverityText, Body, ServiceName, TraceId",
  "FROM otel_logs",
  "WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout'",
  "ORDER BY Timestamp DESC",
]

const lines: LogLine[] = [
  { time: "16:46:11.204", level: "Error", text: CHARGE_FAILED },
  { time: "16:46:11.198", level: "Info", text: '[PlaceOrder] user_id="2d4f7a1c-8b3e-4a65-9c0d-e1f5b7a39c42" user_currency="USD"' },
  { time: "16:46:10.911", level: "Warning", text: "failed to send order confirmation: rpc error: code = DeadlineExceeded desc = context deadline exceeded" },
  { time: "16:46:09.545", level: "Error", text: CHARGE_FAILED, selected: true },
  { time: "16:46:09.102", level: "Info", text: '[PlaceOrder] user_id="c8e1f3a5-47d2-4b90-a6e3-5d1c9f07b284" user_currency="EUR"' },
]

const levels = [
  { name: "Error", count: "87", tone: "crit" },
  { name: "Warning", count: "214", tone: "warn" },
  { name: "Info", count: "903", tone: "s1" },
] as const

const bars = [14, 16, 15, 17, 16, 18, 17, 16, 19, 18, 17, 20, 19, 18, 22, 21, 19, 20, 18, 21, 20, 19, 22, 21]
---

<Window onStage label="The logs page on a ClickHouse datasource">
  <div class="logs">
    <div class="head">
      <span class="crumbs">
        <span class="k">Logs</span>
        <span class="k" aria-hidden="true">/</span>
        <span class="title">ClickHouse</span>
        <span class="lang">SQL</span>
      </span>
      <span class="controls">
        <span class="pick">Last 1 hour</span>
        <span class="pick">Live tail</span>
      </span>
    </div>
    <div class="part">
      <span class="seg" aria-hidden="true"><span class="on">SQL</span><span>Ask</span></span>
      <div class="query mono">
        {
          QUERY.map((line, index) => (
            <>
              <span class="k">{index + 1}</span>
              <span>{line}</span>
            </>
          ))
        }
      </div>
      <div class="run">
        <span class="k">+ Add filter</span>
        <span class="primary">Run query</span>
      </div>
    </div>
    <div class="part">
      <LogVolume total="1,204" levels={[...levels]} bars={bars} ticks={["16:00", "16:20", "16:40"]} />
    </div>
    <div class="results">
      <div class="tabs">
        <span class="seg" aria-hidden="true"><span class="on">Documents</span><span>Patterns</span></span>
        <span class="k">1,204 lines in 0.1 s</span>
      </div>
      <div class="lines">
        {
          lines.map(({ time, level, text, selected }) => (
            <div class:list={["line", { selected }]}>
              <span class="k mono">{time}</span>
              <span class="level">
                <LevelIcon level={level} />
                {level}
              </span>
              <span class="mono message">{text}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="detail">
      <span class="detail-head">
        <b>Line</b>
        <span class="k">2026-11-22 16:46:09.545, Error</span>
      </span>
      <span class="mono">{CHARGE_FAILED}</span>
      <span class="ids mono">
        <span class="id">Trace {TRACE_ID.slice(0, 8)}</span>
        <span class="id">Span {CHECKOUT_SPAN_ID}</span>
      </span>
      <span class="actions">
        <span class="small">Open trace</span>
        <span class="ghost">Show context</span>
        <span class="ghost">Copy line</span>
      </span>
    </div>
  </div>
</Window>

<style>
  .logs {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    min-width: 0;
  }

  .head,
  .part,
  .detail {
    padding: 12px 14px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 10px;
  }

  .part,
  .results,
  .detail {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--border);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .title {
    font-size: 13px;
    font-weight: 500;
  }

  .lang {
    border-radius: 6px;
    padding: 1px 6px;
    background: var(--muted);
    color: var(--mfg);
  }

  .controls,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
  }

  .seg {
    display: inline-flex;
    align-self: flex-start;
    padding: 2px;
    border-radius: 6px;
    background: var(--muted);
  }

  .seg span {
    padding: 2px 10px;
    border-radius: 4px;
    color: var(--mfg);
  }

  .seg .on {
    background: var(--card);
    color: var(--fg);
    font-weight: 500;
  }

  .pick,
  .small,
  .primary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    font-weight: 500;
    white-space: nowrap;
  }

  .primary {
    border-color: transparent;
    background: var(--primary);
    color: var(--pfg);
  }

  .small {
    padding: 2px 8px;
  }

  .ghost {
    padding: 3px 6px;
    font-weight: 500;
    white-space: nowrap;
  }

  .query {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 12px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--muted);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .run {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .results {
    gap: 0;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 10px 14px 6px;
  }

  .line {
    display: grid;
    grid-template-columns: auto 72px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 5px 14px;
    white-space: nowrap;
  }

  .level {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .message {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .selected {
    background: var(--accent-container);
  }

  .detail-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }

  .detail-head b {
    font-size: 13px;
    font-weight: 600;
  }

  .ids {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .id {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--muted);
  }

  @media (max-width: 900px) {
    .line {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 10px;
      padding: 6px 10px;
    }

    .message {
      grid-column: 1 / -1;
    }
  }
</style>
