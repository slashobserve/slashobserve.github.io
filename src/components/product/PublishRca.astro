---
const close = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'
const chevron = '<path d="m6 9 6 6 6-6"/>'

const revisions = [
  { revision: 2, by: "admin, 2 h ago", selected: true },
  { revision: 1, by: "admin, 12 h ago", selected: false },
]
---

<section class="dock" aria-label="Publish as RCA">
  <header class="dock-head">
    <div class="dock-title">
      <h3>Publish as RCA</h3>
      <p class="k">Freezes every live panel and saves a numbered revision. Earlier revisions do not change.</p>
    </div>
    <span class="icon-btn" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={close} /></span>
  </header>
  <div class="dock-body">
    <div><span class="btn btn-primary">Publish revision 3</span></div>
    <section class="group" aria-label="Revisions">
      <h4>Revisions</h4>
      <ul class="list">
        {
          revisions.map(({ revision, by, selected }) => (
            <li class:list={["revision", { selected }]}>
              <span class="strong">Revision {revision}</span>
              <span class="k by">{by}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="group" aria-label="Public links of revision 2">
      <h4>Public links, revision 2</h4>
      <p class="k small">
        Anyone with a link can view this frozen revision without signing in. It never shows a query.
      </p>
      <div class="create">
        <span class="select">No expiry<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span>
        <span class="btn btn-primary">Create link</span>
      </div>
      <ul class="list">
        <li class="link">
          <div class="link-text">
            <span class="link-line"><span class="prefix">pub_7Hq2mKx9</span><span class="k">Active, no expiry</span></span>
            <span class="k small">Created by admin 1 h ago, last viewed 20 min ago</span>
          </div>
          <span class="link-actions">
            <span class="btn ghost">Copy link</span>
            <span class="btn">Revoke</span>
          </span>
        </li>
      </ul>
    </section>
  </div>
</section>

<style>
  .dock {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    font-size: 13px;
    line-height: 1.45;
  }

  .dock-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 12px 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .dock-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  p {
    margin: 0;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    color: var(--mfg);
  }

  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dock-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
  }

  .btn {
    min-height: 28px;
    padding: 0 12px;
    font-size: 12.5px;
  }

  .btn.ghost {
    border-color: transparent;
    background: transparent;
    color: var(--mfg);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h4 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .small {
    font-size: 12px;
  }

  .list {
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    list-style: none;
    overflow: hidden;
  }

  .list > li + li {
    border-top: 1px solid var(--border);
  }

  .revision {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
  }

  .revision.selected {
    background: var(--muted);
  }

  .strong {
    font-weight: 500;
  }

  .by {
    min-width: 0;
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .create {
    display: flex;
    gap: 6px;
  }

  .select {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    min-width: 0;
    height: 28px;
    padding: 0 8px 0 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--card);
  }

  .select svg {
    color: var(--mfg);
  }

  .link {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 8px 12px;
  }

  .link-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .link-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  .prefix {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .link-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 4px;
  }
</style>
