---
import Mark from "./Mark.astro"

interface Props {
  as?: "li" | "div"
  author: "person" | "agent"
  initials?: string
  tint?: 1 | 2 | 3 | 4
  name: string
  verb: string
  time: string
  framed?: boolean
  seq?: number
}

const { as: Tag = "div", author, initials, tint, name, verb, time, framed = false, seq } = Astro.props
---

<Tag class:list={["msg", framed && "framed"]} data-seq={seq} style={seq === undefined ? undefined : `--seq:${seq}`}>
  <Mark kind={author} initials={initials} tint={tint} size={24} />
  <div class="msg-body">
    <div class="msg-head">
      <span class="who"><b>{name}</b><span class="k">{verb}</span></span>
      <span class="k time">{time}</span>
    </div>
    <p><slot /></p>
    <slot name="after" />
    <span class="actions"><span>Reply</span><span>Add to page</span></span>
  </div>
</Tag>

<style>
  .msg {
    display: flex;
    gap: 10px;
    padding: 8px 0;
  }

  .framed {
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--card);
  }

  .msg-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 2px;
  }

  .msg-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .who {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
    min-width: 0;
  }

  .who b {
    font-weight: 500;
  }

  .time {
    flex: none;
    margin-left: auto;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  p {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    gap: 14px;
    color: var(--mfg);
    font-size: 12px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion [data-sequence]) .msg[data-seq] {
      animation: message-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(400ms + var(--seq) * 1100ms) backwards;
    }
  }

  @keyframes message-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
