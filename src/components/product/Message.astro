---
import Mark from "./Mark.astro"

interface Props {
  as?: "li" | "div"
  author: "person" | "agent"
  initials?: string
  tint?: 1 | 2 | 3 | 4
  name: string
  time: string
  framed?: boolean
  seq?: number
}

const { as: Tag = "div", author, initials, tint, name, time, framed = false, seq } = Astro.props
---

<Tag class:list={["msg", framed && "framed"]} data-seq={seq} style={seq === undefined ? undefined : `--seq:${seq}`}>
  <Mark kind={author} initials={initials} tint={tint} size={24} />
  <div class="msg-body">
    <div class="msg-head"><b>{name}</b><span class="k">{time}</span></div>
    <p><slot /></p>
    <span class="btn btn-sm add">Add to page</span>
  </div>
</Tag>

<style>
  .msg {
    display: flex;
    gap: 10px;
    padding: 10px 16px;
  }

  .framed {
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--card);
  }

  .msg-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .msg-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 8px;
  }

  .msg-head b {
    font-weight: 600;
  }

  .msg-head .k {
    font-size: 12px;
  }

  p {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .add {
    align-self: flex-start;
    min-height: 28px;
    margin-left: -8px;
    padding: 0 8px;
    border-color: transparent;
    background: transparent;
    color: var(--mfg);
    font-size: 12.5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion [data-sequence]) .msg[data-seq] {
      animation: message-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(400ms + var(--seq) * 1100ms) backwards;
    }
  }

  @keyframes message-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
