---
import LevelIcon, { type Level } from "./LevelIcon.astro"
import LogVolume from "./LogVolume.astro"
import Window from "./Window.astro"
import { HOST, TRACE_ID } from "./screen-ids"
import { CHARGE_FAILED, CHECKOUT_SPAN_ID } from "./trace"

interface LogLine {
  time: string
  service: string
  level: Level
  text: string
  selected?: boolean
}

const QUERY = "service.name:checkout"

const lines: LogLine[] = [
  { time: "16:46:11.204", service: "checkout", level: "Error", text: CHARGE_FAILED },
  {
    time: "16:46:11.198",
    service: "checkout",
    level: "Info",
    text: '[PlaceOrder] user_id="2d4f7a1c-8b3e-4a65-9c0d-e1f5b7a39c42" user_currency="USD"',
  },
  {
    time: "16:46:10.911",
    service: "checkout",
    level: "Warning",
    text: "failed to send order confirmation: rpc error: code = DeadlineExceeded desc = context deadline exceeded",
  },
  {
    time: "16:46:10.877",
    service: "checkout",
    level: "Info",
    text: "payment went through (transaction_id: 8e0b5c3a-91d4-4f27-b6a8-3c7d1e9f2a05)",
  },
  { time: "16:46:09.545", service: "checkout", level: "Error", text: CHARGE_FAILED, selected: true },
  {
    time: "16:46:09.102",
    service: "checkout",
    level: "Info",
    text: '[PlaceOrder] user_id="c8e1f3a5-47d2-4b90-a6e3-5d1c9f07b284" user_currency="EUR"',
  },
  {
    time: "16:46:08.990",
    service: "checkout",
    level: "Info",
    text: '[PlaceOrder] user_id="a3b7d905-1e2c-4f68-8b14-6c0e5d9a7f31" user_currency="GBP"',
  },
  { time: "16:46:08.421", service: "checkout", level: "Error", text: CHARGE_FAILED },
]

const columns = [
  ["@timestamp", "2026-11-22T16:46:09.545Z"],
  ["log.level", "error"],
  ["service.name", "checkout"],
  ["trace.id", TRACE_ID],
  ["span.id", CHECKOUT_SPAN_ID],
]

const levels = [
  { name: "Error", count: "87", tone: "crit" },
  { name: "Warning", count: "214", tone: "warn" },
  { name: "Info", count: "903", tone: "s1" },
] as const

const bars = [
  14, 16, 15, 17, 16, 18, 17, 16, 19, 18, 17, 20, 19, 18, 22, 21, 19, 20, 18, 21, 20, 19, 22, 21, 20, 18, 19, 21, 22, 20,
  19, 21, 20, 22, 21, 19,
]

const chevron = '<path d="m6 9 6 6 6-6"/>'
const close = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'
---

<Window url={`${HOST}/logs/es?q=${QUERY}`} label="The logs page on an Elasticsearch datasource">
  <div class="logs">
    <div class="main">
      <div class="row head">
        <span class="row crumbs">
          <span class="k">Logs</span>
          <span class="k" aria-hidden="true">/</span>
          <span class="title">Elasticsearch</span>
          <span class="lang">KQL</span>
        </span>
        <span class="row head-actions">
          <span class="btn btn-sm">Last 1 hour</span>
          <span class="btn btn-sm">Live tail</span>
          <span class="select hide-sm">Saved searches<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span>
        </span>
      </div>
      <div class="part">
        <span class="seg" aria-hidden="true"><span>Builder</span><span class="on">KQL</span><span>Ask</span></span>
        <div class="mono code"><span class="k">1</span><span>{QUERY}</span></div>
        <div class="row run">
          <span class="k">+ Add filter</span>
          <span class="btn btn-primary btn-sm">Run query</span>
        </div>
      </div>
      <div class="part">
        <LogVolume total="1,204" levels={[...levels]} bars={bars} ticks={["16:00", "16:20", "16:40"]} />
      </div>
      <div class="part results">
        <div class="row bar">
          <span class="row">
            <span class="seg" aria-hidden="true"><span class="on">Documents</span><span>Patterns</span></span>
            <span class="k">1,204 hits in 0.2 s</span>
          </span>
          <span class="row hide-sm">
            <span class="ghost">Add to dashboard</span>
            <span class="btn btn-sm">Add to observation</span>
          </span>
        </div>
        <div class="row options">
          <span class="row">Sort <span class="select">Newest first<svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} /></span></span>
          <span class="btn btn-sm">Wrap</span>
          <span class="btn btn-sm">JSON</span>
          <span class="btn btn-sm hide-sm">Columns 1</span>
        </div>
        <div class="table">
          <div class="line line-head k">
            <span>Time</span>
            <span></span>
            <span class="hide-sm">service</span>
            <span>Message</span>
          </div>
          {
            lines.map(({ time, service, level, text, selected }) => (
              <div class:list={["line", { selected }]}>
                <span class="mono">2026-11-22 {time}</span>
                <span class="row level">
                  <LevelIcon level={level} />
                  {level}
                </span>
                <span class="mono k hide-sm">{service}</span>
                <span class="mono message">{text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <aside class="pane" aria-label="Line details">
      <div class="pane-head">
        <span class="pane-title">
          <b>Line</b>
          <span class="k">2026-11-22 16:46:09.545, Error</span>
        </span>
        <svg class="k close" viewBox="0 0 24 24" aria-hidden="true" set:html={close} />
      </div>
      <span class="mono">{CHARGE_FAILED}</span>
      <span class="row ids mono">
        <span class="id">Trace {TRACE_ID.slice(0, 8)}</span>
        <span class="id">Span {CHECKOUT_SPAN_ID}</span>
      </span>
      <span class="row actions">
        <span class="btn btn-sm">Open trace</span>
        <span class="ghost">Show context</span>
        <span class="ghost">Copy line</span>
        <span class="ghost">Copy link</span>
      </span>
      <span class="seg" aria-hidden="true"><span class="on">Table</span><span>JSON</span><span>Context</span></span>
      <span class="section-title">Columns <span class="k">{columns.length}</span></span>
      <div class="fields">
        {
          columns.map(([key, value]) => (
            <>
              <span class="k mono">{key}</span>
              <span class="mono">{value}</span>
            </>
          ))
        }
      </div>
    </aside>
  </div>
</Window>

<style>
  .logs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    font-size: 12px;
  }

  .main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .head,
  .part {
    padding: 12px 14px;
  }

  .head {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--border);
  }

  .crumbs {
    gap: 8px;
  }

  .title {
    font-size: 13px;
    font-weight: 500;
  }

  .lang {
    border-radius: 6px;
    padding: 1px 6px;
    background: var(--muted);
    color: var(--mfg);
  }

  .head-actions,
  .options,
  .actions {
    flex-wrap: wrap;
    gap: 6px;
  }

  .btn {
    min-height: 26px;
    padding: 0 9px;
    font-size: 12px;
  }

  .ghost {
    padding: 3px 6px;
    font-weight: 500;
    white-space: nowrap;
  }

  .select {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    margin-left: 6px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    white-space: nowrap;
  }

  svg {
    flex: none;
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .seg {
    display: inline-flex;
    align-self: flex-start;
    padding: 2px;
    border-radius: 6px;
    background: var(--muted);
  }

  .seg span {
    padding: 2px 10px;
    border-radius: 4px;
    color: var(--mfg);
  }

  .seg .on {
    background: var(--card);
    color: var(--fg);
    font-weight: 500;
  }

  .code {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--muted);
  }

  .run,
  .bar {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  .bar > .row {
    gap: 10px;
  }

  .results {
    padding-bottom: 6px;
  }

  .table {
    margin: 0 -14px;
  }

  .line {
    display: grid;
    grid-template-columns: 172px 64px 64px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 5px 14px;
    border-top: 1px solid var(--border);
    white-space: nowrap;
  }

  .line-head {
    font-size: 11.5px;
  }

  .level {
    gap: 6px;
  }

  .message {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .selected {
    background: var(--accent-container);
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 12px 14px;
    border-left: 1px solid var(--border);
  }

  .pane-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .pane-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pane-title b {
    font-size: 13px;
    font-weight: 600;
  }

  .close {
    width: 14px;
    height: 14px;
  }

  .ids {
    flex-wrap: wrap;
    gap: 6px;
  }

  .id {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--muted);
  }

  .section-title {
    font-weight: 600;
  }

  .fields {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: 6px 12px;
  }

  .fields span {
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .logs {
      grid-template-columns: minmax(0, 1fr);
    }

    .pane {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .line {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 10px;
    }

    .message {
      grid-column: 1 / -1;
    }

    .line-head {
      display: none;
    }
  }
</style>
