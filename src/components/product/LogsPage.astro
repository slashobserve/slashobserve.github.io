---
import LevelIcon, { type Level } from "./LevelIcon.astro"
import Window from "./Window.astro"
import { HOST, TRACE_ID } from "./screen-ids"

interface LogLine {
  time: string
  pod: string
  level: Level
  text: string
  selected?: boolean
}

const appOf = (pod: string) => pod.slice(0, pod.lastIndexOf("-"))

const QUERY = "service.name:checkout"

const lines: LogLine[] = [
  { time: "14:02:11.204", pod: "checkout-0", level: "Error", text: "payment declined order=8812 reason=card_declined" },
  { time: "14:02:11.198", pod: "checkout-1", level: "Info", text: "GET /cart 200 12ms" },
  { time: "14:02:10.911", pod: "checkout-0", level: "Warning", text: "db pool near max in_use=19 max=20" },
  { time: "14:02:10.877", pod: "checkout-2", level: "Info", text: "charge ok amount=4900" },
  {
    time: "14:02:09.540",
    pod: "checkout-0",
    level: "Error",
    text: "upstream timeout upstream=payments after=2.0s",
    selected: true,
  },
  { time: "14:02:09.102", pod: "checkout-1", level: "Info", text: "GET /product/41 200 8ms" },
  { time: "14:02:08.990", pod: "checkout-2", level: "Info", text: "reserve ok sku=41 qty=1" },
  { time: "14:02:08.421", pod: "checkout-0", level: "Error", text: "payment declined order=8809 reason=timeout" },
]

const details = [
  ["Time", "2026-11-06 14:02:09"],
  ["level", "error"],
  ["service", "checkout"],
  ["trace_id", TRACE_ID],
  ["_index", "logs-shop-2026.11.06"],
  ["pod", "checkout-0"],
]
---

<Window url={`${HOST}/logs?ds=prod-es&q=${QUERY}`} label="The logs page on an Elasticsearch datasource">
  <div class="logs">
    <div class="row head">
      <span class="title">Logs</span>
      <span class="row head-actions">
        <span class="btn btn-sm">Last 15 minutes</span>
        <span class="btn btn-sm">Live tail</span>
        <span class="btn btn-sm hide-xs">Add to dashboard</span>
      </span>
    </div>
    <div class="row source">
      <span class="label">Datasource</span>
      <span class="select">prod-es Elasticsearch logs-* @timestamp<span class="k" aria-hidden="true">▾</span></span>
      <span class="btn btn-sm">Fields</span>
    </div>
    <div class="mono code"><span class="k">1</span><span>{QUERY}</span></div>
    <span class="btn btn-primary btn-sm run">Run query</span>
    <div class="row options">
      <span class="row">Sort <span class="select">Newest first<span class="k" aria-hidden="true">▾</span></span></span>
      <span class="btn btn-sm">Wrap</span>
      <span class="btn btn-sm">JSON</span>
      <span class="btn btn-sm hide-sm">Columns</span>
    </div>
    <div class="results g1-sm">
      <div class="lines">
        {
          lines.map(({ time, pod, level, text, selected }) => (
            <div class:list={["line", { selected }]}>
              <span class="k">2026-11-06 {time}</span>
              <span class="mono k labels">service.name={appOf(pod)} pod={pod}</span>
              <span class="row level">
                <LevelIcon level={level} />
                {level}
              </span>
              <span class="mono message">{text}</span>
            </div>
          ))
        }
      </div>
      <div class="detail">
        <span class="row detail-actions">
          <span class="btn btn-sm">Surrounding documents</span>
          <span class="btn btn-sm">Copy line</span>
          <span class="btn btn-sm">Copy link</span>
        </span>
        <span class="trace-link">Open trace {TRACE_ID.slice(0, 8)}</span>
        <div class="fields">
          {
            details.map(([key, value]) => (
              <>
                <span class="k">{key}</span>
                <span class="mono">{value}</span>
              </>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Window>

<style>
  .logs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    font-size: 12px;
  }

  .head {
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
  }

  .head-actions {
    gap: 6px;
  }

  .btn {
    min-height: 28px;
    font-size: 12px;
  }

  .source {
    flex-wrap: wrap;
  }

  .select {
    display: inline-flex;
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px 9px;
    background: var(--card);
    white-space: nowrap;
  }

  .code {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 7px 10px 18px;
    font-size: 11.5px;
    background: var(--card);
    overflow-wrap: anywhere;
  }

  .run {
    align-self: flex-start;
  }

  .options {
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .results {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    border-top: 1px solid var(--border);
  }

  .lines {
    min-width: 0;
  }

  .line {
    display: grid;
    grid-template-columns: 156px minmax(0, 0.7fr) 64px minmax(0, 1fr);
    gap: 8px;
    padding: 4px 6px;
    border-bottom: 1px solid var(--border);
    font-size: 11.5px;
    white-space: nowrap;
  }

  .line > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .line.selected {
    background: var(--accent-container);
  }

  .level {
    gap: 5px;
  }

  .detail {
    border-left: 1px solid var(--border);
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .detail-actions {
    gap: 6px;
    flex-wrap: wrap;
  }

  .trace-link {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fields {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 3px 12px;
    font-size: 11.5px;
  }

  .fields .mono {
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .line {
      grid-template-columns: 150px 64px minmax(0, 1fr);
    }

    .labels {
      display: none;
    }

    .detail {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 480px) {
    .hide-xs {
      display: none;
    }
  }
</style>
