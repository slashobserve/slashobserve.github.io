---
import type { CoverageCounts } from "../../lib/import-coverage"
import { formatCount, percentDown } from "../../lib/numbers"
import SplitBar from "./SplitBar.astro"

interface Props {
  counts: CoverageCounts
}

const { options, imports, noEffect, excluded, gaps } = Astro.props.counts
const cells = [
  ["Options", options],
  ["Imports", imports],
  ["No visible effect", noEffect],
  ["Excluded", excluded],
  ["Gaps", gaps],
] as const
---

<span class="cv-nums">
  {
    cells.map(([label, value]) => (
      <span class="cv-num">
        <span class="cv-lbl">{label}</span>
        <span class="cv-val">{formatCount(value)}</span>
      </span>
    ))
  }
</span>
<span class="cv-cov">
  <span class="sr-only">Handled</span>
  <SplitBar
    segments={[
      { count: imports, tone: "ink" },
      { count: noEffect, tone: "mid" },
      { count: excluded, tone: "line" },
      { count: gaps, tone: "gap" },
    ]}
  />
  <span class="cv-pct">{percentDown(options - gaps, options)}%</span>
</span>
