---
import GrafanaSettings from "../product/GrafanaSettings.astro"
import RepairQueue from "../product/RepairQueue.astro"
import Section from "../site/Section.astro"

const stages = ["Connect", "Import", "Repair", "Keep the links"]
---

<Section>
  <div class="flow import-flow">
    {
      stages.map((stage, index) => (
        <span class="seg">
          <span class="stage">{stage}</span>
          {index < stages.length - 1 && <span class="line solid" aria-hidden="true" />}
        </span>
      ))
    }
  </div>
  <div class="cols2 steps">
    <div class="step-copy">
      <div>
        <h2 class="h3">Connect</h2>
        <p class="p">
          Settings › Grafana takes the address and a service-account token with Viewer on the folders you want. The
          test lists folders, counts dashboards and shows each Grafana datasource beside the SlashObserve datasource it
          maps to.
        </p>
      </div>
      <div>
        <h2 class="h3">Import, and import again</h2>
        <p class="p">
          "Import all" copies every dashboard with its folder path, tags, variables and links, and runs every query. A
          second run updates what changed in Grafana and leaves your edits alone.
        </p>
      </div>
      <div>
        <h2 class="h3">Repair</h2>
        <p class="p">
          A panel whose query fails or returns nothing is marked unverified, never hidden. The repair queue lists every
          dashboard with one; "Repair with the agent" rewrites those queries against the metrics that exist and saves a
          version you can diff.
        </p>
      </div>
      <div>
        <h2 class="h3">Keep the links</h2>
        <p class="p">
          Every imported dashboard keeps its Grafana uid, so <span class="mono">{"/d/<uid>/<slug>"}</span> resolves here
          as it did there. Point the old hostname at SlashObserve and runbooks, wiki pages and alert links keep working.
        </p>
      </div>
    </div>
    <div class="step-windows">
      <GrafanaSettings />
      <RepairQueue />
    </div>
  </div>
</Section>

<style>
  .import-flow {
    margin-bottom: 28px;
  }

  .stage {
    color: var(--fg);
  }

  .steps {
    align-items: start;
  }

  .step-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .step-copy .p {
    margin-top: 6px;
  }

  .step-windows {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  @media (max-width: 480px) {
    .import-flow {
      gap: 8px 16px;
    }

    .import-flow .line {
      display: none;
    }
  }
</style>
