---
interface Props {
  panelTypeCount: number
}

type Tone = "ok" | "warn" | null

const { panelTypeCount } = Astro.props

const rows: { feature: string; status: string; tone: Tone; note: string }[] = [
  {
    feature:
      "Time series, stat, gauge, bar gauge, table, pie, heatmap, histogram, state timeline, logs and more",
    status: "Imported",
    tone: "ok",
    note: `${panelTypeCount} data panel types, plus text, rows, dashboard list and news`,
  },
  {
    feature: "Prometheus and ClickHouse queries",
    status: "Imported",
    tone: "ok",
    note: "Several queries per panel, legends, intervals, time shift",
  },
  {
    feature: "Variables: query, custom, constant, interval, textbox, datasource, ad hoc",
    status: "Imported",
    tone: "ok",
    note: "Multi-value and All, chained variables",
  },
  {
    feature: "Field config: units, decimals, thresholds, value mappings, overrides, links",
    status: "Imported",
    tone: "ok",
    note: "Overrides by name, regex or query",
  },
  {
    feature: "Rows, repeating panels and rows, transformations",
    status: "Imported",
    tone: "ok",
    note: "Collapsed rows keep their children",
  },
  {
    feature: "Library panels",
    status: "Imported",
    tone: "ok",
    note: "When the export includes them (Export for sharing externally); otherwise a placeholder that names the panel",
  },
  {
    feature: "Loki, Tempo, Elasticsearch and other datasources",
    status: "Placeholder",
    tone: "warn",
    note: "Shown with the original title and the reason",
  },
  {
    feature: "Legacy graph, singlestat, Angular table and old heatmap panels",
    status: "Imported",
    tone: "ok",
    note: "Mapped the way Grafana's own migration maps them",
  },
  {
    feature: "Discrete, Worldmap and Singlestat plugin panels",
    status: "Imported",
    tone: "ok",
    note: "As state timeline, geomap and stat panels",
  },
  {
    feature: "Other plugin panels from grafana.com",
    status: "Placeholder",
    tone: "warn",
    note: "Listed in the import report",
  },
  {
    feature: "Alert rules, annotations, Grafana's HTTP API",
    status: "Not imported",
    tone: null,
    note: "Dashboards only",
  },
  {
    feature: "Export back to Grafana",
    status: "Not planned",
    tone: null,
    note: "Share the dashboard link, or ask an LLM to translate the spec",
  },
]
---

<section id="compat" class="wrap section-y compat">
  <div class="split-head" data-reveal>
    <h2 class="h2">What imports</h2>
    <p>
      "Same meaning" means the same queries, series, layout, variables, units, thresholds, mappings
      and colours. Panels are drawn by SlashObserve, so they look like SlashObserve, not a pixel
      copy.
    </p>
  </div>
  <div class="table-frame" role="region" aria-label="What imports from Grafana" tabindex="0" data-reveal>
    <table class="tbl tbl-stack" role="table">
      <caption class="sr-only">What imports from Grafana</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Grafana feature</th>
          <th scope="col" role="columnheader">In SlashObserve</th>
          <th scope="col" role="columnheader">Notes</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          rows.map((row) => (
            <tr role="row">
              <td role="cell">{row.feature}</td>
              <td role="cell">
                <span class="tag">
                  {row.tone && <span class:list={["dot", row.tone]} aria-hidden="true" />}
                  {row.status}
                </span>
              </td>
              <td role="cell" class="hint">{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .compat {
    display: flex;
    flex-direction: column;
    gap: 40px;
    scroll-margin-top: 24px;
  }

  .ok {
    background: var(--ok);
  }

  .warn {
    background: var(--warn);
  }
</style>
