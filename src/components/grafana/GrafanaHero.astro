---
interface Props {
  importGuide: string | null
}

const { importGuide } = Astro.props
---

<section class="wrap hero">
  <span class="eyebrow">Coming from Grafana</span>
  <h1 class="h1-sm">Keep your dashboards. Change how you build them.</h1>
  <p class="lead">
    Import a Grafana dashboard and it shows the same data, layout and meaning in SlashObserve. From
    then on the agent can revise it, your team can review it, and every change is a version.
  </p>
  <div class="actions">
    {
      importGuide && (
        <a class="btn btn-primary" href={importGuide}>
          Import your first dashboard
        </a>
      )
    }
    <a class="btn" href="#compat">See what imports</a>
  </div>
</section>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }

  h1 {
    margin: 0;
    font-size: 64px;
    line-height: 1.03;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 860px;
    text-wrap: balance;
  }

  .lead {
    font-size: 19px;
    text-align: center;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
</style>
