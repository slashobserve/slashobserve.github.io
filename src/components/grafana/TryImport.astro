---
import Finale from "../site/Finale.astro"
---

<Finale>
  <h2 class="h2">Try it with one dashboard</h2>
  <p>
    Export any dashboard from Grafana (Share, Export, Save to file) and import it into the demo
    stack.
  </p>
  <pre class="code command" tabindex="0"><span class="prompt" aria-hidden="true">$</span> observe import node-exporter-full.json</pre>
</Finale>

<style>
  .command {
    margin-top: 8px;
    font-size: 14px;
    padding: 14px 20px;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .prompt {
    color: var(--mfg);
  }
</style>
